#!/usr/bin/env bash
# The local harness. One command stands the entire backend up on a laptop with
# no credentials. See specs/backend/build/local-harness.md.
#
#   weald-stack up [--relay] [--budget SECONDS]
#   weald-stack status
#   weald-stack clients N
#   weald-stack scenario NAME
#   weald-stack register [--fresh]
#   weald-stack demo [--peers N]
#   weald-stack kill relay --at POINT
#   weald-stack dump envelopes
#   weald-stack fixture [--seed N]
#   weald-stack prove-blind
#   weald-stack dump-db
#   weald-stack agent-crossing [--out DIR]
#   weald-stack agent-fold-crossing [--out DIR]
#   weald-stack agent-card-crossing [--out DIR]
#   weald-stack ci-card-crossing [--out DIR]
#   weald-stack ci-disclosure-crossing [--out DIR]
#   weald-stack down [--volumes]
#
# Components that a later step builds are reported as such and exit 69
# (EX_UNAVAILABLE), which is how the gate tells "not built yet" apart from
# "broken". Nothing here pretends a component exists.
set -euo pipefail

# WEALD-L421: enrol/redeem refuse bootstrap secrets in argv by default. This
# harness drives a loopback relay on a machine that is already the operator's, so
# the leak has nobody to leak to and the escape is taken explicitly.
export WEALD_ALLOW_ARGV_SECRETS=1

# Step 17's rollout flag, opened for the harness as a whole.
#
# The product default is `local-only`: private local bots and nothing on the wire.
# Every crossing in this file is about what happens *on* the wire, so each one
# needs the workspace opted in, and setting it once here rather than in fifteen
# crossings is what keeps a new crossing from silently proving that the flag was
# off. Step 17's negative part unsets it deliberately, which is the only place in
# this harness that wants the default.
export WEALD_NETWORKED_AGENTS="${WEALD_NETWORKED_AGENTS:-ticket-migration}"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

COMPOSE_FILE="backend/compose/weald-stack.yml"
STACK_STATE="$ROOT/.weald-stack"
EX_UNAVAILABLE=69

: "${WEALD_STACK_PG_PORT:=54032}"
: "${WEALD_STACK_MINIO_PORT:=54090}"
: "${WEALD_STACK_MINIO_CONSOLE_PORT:=54091}"
: "${WEALD_STACK_REDIS_PORT:=54079}"
: "${WEALD_STACK_SMTP_PORT:=54025}"
: "${WEALD_STACK_MAILPIT_UI_PORT:=54080}"
: "${WEALD_STACK_RELAY_PORT:=54040}"
# Which interface the harness relay binds. Loopback by default, because the
# default posture is one machine and a plaintext socket that nothing off this
# host can open. Set to 0.0.0.0 to test a second device (an iPhone, a second
# Mac) against this relay over the LAN; the URL those devices use is then
# ws://<this machine's LAN address>:$WEALD_STACK_RELAY_PORT/relay. Health and
# readiness are still probed on 127.0.0.1, which a 0.0.0.0 bind also serves.
: "${WEALD_STACK_RELAY_BIND:=127.0.0.1}"
: "${WEALD_STACK_CLOUD_PORT:=54030}"
export WEALD_STACK_PG_PORT WEALD_STACK_MINIO_PORT WEALD_STACK_MINIO_CONSOLE_PORT \
  WEALD_STACK_REDIS_PORT WEALD_STACK_SMTP_PORT WEALD_STACK_MAILPIT_UI_PORT \
  WEALD_STACK_RELAY_BIND

INFRA_SERVICES=(postgres minio redis mailpit)

dc() { docker compose -f "$COMPOSE_FILE" "$@"; }

now_ms() { python3 -c 'import time; print(int(time.time()*1000))'; }

note() { printf "  %-14s %s\n" "$1" "$2"; }

require_daemon() {
  if ! docker info >/dev/null 2>&1; then
    echo "weald-stack: no docker daemon. Start OrbStack and try again." >&2
    exit 1
  fi
}

# The loopback addresses above 127.0.0.1 that the suite binds as distinct sources.
# Linux answers on every 127/8 address without being asked; macOS binds 127.0.0.1
# and nothing else, so those tests fail there with EADDRNOTAVAIL and the failure
# names a bind rather than the cap it is really about. Adding an alias needs root,
# so this reports rather than sudoing: an unattended `up` must not sit on a
# password prompt.
#
# Three and not one. `tests/calls_capacity.rs` binds 127.0.0.2 as a second source,
# and `tests/deadline_socket.rs` fills a four-slot table from 127.0.0.1 through
# 127.0.0.4 because BR-032 gives one source only a quarter of it. Checking .2
# alone let a machine pass this gate and still fail the suite, one test further
# on, with the same opaque EADDRNOTAVAIL.
LOOPBACK_ALIASES=("127.0.0.2" "127.0.0.3" "127.0.0.4")

require_loopback_alias() {
  case "$(uname -s)" in
    Darwin) ;;
    *) return 0 ;;
  esac
  local present=() missing=() alias_
  for alias_ in "${LOOPBACK_ALIASES[@]}"; do
    if /sbin/ifconfig lo0 2>/dev/null | grep -q "inet $alias_"; then
      present+=("$alias_")
    else
      missing+=("$alias_")
    fi
  done
  if [ ${#missing[@]} -eq 0 ]; then
    note "loopback" "${present[*]} present"
    return 0
  fi
  note "loopback" "${missing[*]} absent"
  echo "weald-stack: the relay suite binds these as distinct sources and will fail" >&2
  echo "weald-stack: with EADDRNOTAVAIL until the aliases exist. Add them with:" >&2
  for alias_ in "${missing[@]}"; do
    echo "weald-stack:   sudo ifconfig lo0 alias $alias_ up" >&2
  done
  echo "weald-stack: They do not survive a reboot; re-run those lines after one." >&2
}

# A step that has not been built yet. Named so every message reads the same and
# so the exit code is uniform.
not_yet() {
  echo "weald-stack: $1 arrives in step $2 (specs/backend/build/phases-relay.md)." >&2
  exit "$EX_UNAVAILABLE"
}

relay_binary() {
  local bin="$ROOT/target/debug/wealdrelay"
  [ -x "$bin" ] && echo "$bin"
}

RELAY_PID_FILE="$STACK_STATE/relay.pid"
RELAY_LOG_FILE="$STACK_STATE/relay.log"
RELAY_OBSERVABILITY_PORT=$(( WEALD_STACK_RELAY_PORT + 1 ))
# Which relay this invocation is driving, and therefore which workspace.
#
# A relay serves exactly one workspace, `ws:<hostname>`, and mints exactly one
# genesis key for it (`backend/wealdrelay/src/serve.rs`, `bootstrap_workspace`).
# A harness that wanted two workspaces at once on one relay was asking for a
# second route to trust root, which is the thing the genesis rule exists to
# refuse, so a second workspace is a second relay: `relay_use NAME` picks its
# hostname, port, log, pid file and workspace id, and everything below reads
# these three variables rather than the defaults. WEALD-L304.
RELAY_HOSTNAME="${WEALD_STACK_RELAY_HOSTNAME:-localhost}"
ENROLLED_WORKSPACE="ws:$RELAY_HOSTNAME"
RELAY_PORT_BASE="$WEALD_STACK_RELAY_PORT"

# Point every relay-facing variable at one named relay. No argument is the
# harness's own relay, on the default port, exactly as it was.
# The bearer the relay's own operator routes are behind, minted once per stack.
#
# `/readyz` answers an orchestrator's verdict to anybody and the full document only
# to a caller holding `WEALD_RELAY_OPERATOR_TOKEN`, because the private listener is a
# network boundary and a network boundary is not an authentication boundary
# (`health.rs`, `readyz`). A harness that wants to assert `write_mode` therefore has
# to hold one. Random per stack, kept inside `.weald-stack`, which is ignored in its
# entirety: nothing here is checked in and nothing here reaches a vendor.
relay_operator_token() {
  local file="$STACK_STATE/operator-token"
  if [ ! -s "$file" ]; then
    mkdir -p "$STACK_STATE"
    python3 -c 'import os; print(os.urandom(32).hex())' > "$file"
    chmod 600 "$file"
  fi
  cat "$file"
}

relay_use() {
  local name="${1:-}" offset="${2:-0}"
  if [ -z "$name" ]; then
    RELAY_HOSTNAME="${WEALD_STACK_RELAY_HOSTNAME:-localhost}"
    RELAY_PID_FILE="$STACK_STATE/relay.pid"
    RELAY_LOG_FILE="$STACK_STATE/relay.log"
    WEALD_STACK_RELAY_PORT="$RELAY_PORT_BASE"
  else
    RELAY_HOSTNAME="$name"
    RELAY_PID_FILE="$STACK_STATE/relay-$name.pid"
    RELAY_LOG_FILE="$STACK_STATE/relay-$name.log"
    WEALD_STACK_RELAY_PORT=$(( RELAY_PORT_BASE + offset ))
  fi
  export WEALD_STACK_RELAY_PORT
  RELAY_OBSERVABILITY_PORT=$(( WEALD_STACK_RELAY_PORT + 1 ))
  ENROLLED_WORKSPACE="ws:$RELAY_HOSTNAME"
}

# The relay the client instances talk to.
#
# Three overrides, and they exist for one case: driving a relay this harness did
# not start, which is what step 13's hosted-deployment proof needs. Without them
# the only relay a supervised client can reach is the one on the loopback port,
# and "a real client connected over the public socket" would have to be a second
# implementation of the instance bootstrap rather than the one everything else
# uses. Unset, every value here is exactly what it was.
#
# Nothing else changes: the same binary, the same `relay-client` entry point, the
# same group registration, the same access set.
relay_ws_url() {
  echo "${WEALD_STACK_RELAY_URL:-ws://127.0.0.1:$WEALD_STACK_RELAY_PORT/relay}"
}

relay_pid() {
  [ -f "$RELAY_PID_FILE" ] || return 1
  local pid
  pid="$(cat "$RELAY_PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  echo "$pid"
}

# Is a relay answering on the harness port right now? Asked of the socket rather
# than of the pidfile, because a pidfile that outlived its process is exactly the
# state that makes a suite hang waiting for a connection nobody is serving.
relay_answers() {
  # A hosted relay on a free plan spins down when idle and takes tens of seconds
  # to come back, so the timeout is the caller's when the health URL is
  # overridden and stays at two seconds for the loopback case, where anything
  # slower is a relay that is not there.
  if [ -n "${WEALD_STACK_RELAY_HEALTH_URL:-}" ]; then
    curl -fsS --max-time "${WEALD_STACK_RELAY_HEALTH_TIMEOUT:-90}" \
      "$WEALD_STACK_RELAY_HEALTH_URL" >/dev/null 2>&1
    return
  fi
  # Thirty seconds, not two. Two was "anything slower is a relay that is not there",
  # which is a wall-clock read dressed as a fact: on a machine running a build, a
  # soak and another session's stack, this relay's own Postgres pool logs twelve
  # second acquires and the health handler answered after seven to eleven. Every gate part
  # downstream then reported "the relay is not serving" about a relay that was
  # serving, which is the flake class `CLAUDE.md` says to fix in the harness rather
  # than re-run. A relay that is genuinely absent still fails here, immediately,
  # because nothing is listening and the connection is refused rather than slow.
  #
  # And a deadline rather than a single attempt. One 30s read is still a wall-clock
  # read: measured on this machine under another session's build the handler answered
  # in 21s, so the budget was being met by margin alone and the next slower pass
  # reported an absent relay again. A refused connection is still immediate -- curl
  # returns at once and the port check below decides -- so a relay that is genuinely
  # not there costs nothing extra, while a relay that is merely slow gets the whole
  # deadline to answer.
  local deadline=$(( $(date +%s) + ${WEALD_STACK_RELAY_HEALTH_TIMEOUT:-90} ))
  while :; do
    if curl -fsS --max-time 30 \
      "http://127.0.0.1:$WEALD_STACK_RELAY_PORT/healthz" >/dev/null 2>&1; then
      return 0
    fi
    # Nothing is listening at all: absent, not slow, and no deadline will change it.
    lsof -nP -iTCP:"$WEALD_STACK_RELAY_PORT" -sTCP:LISTEN >/dev/null 2>&1 || return 1
    [ "$(date +%s)" -lt "$deadline" ] || return 1
    sleep 2
  done
}

# Start `wealdrelay` against the harness Postgres and a file-backed blob store.
#
# A real process on a real port, not an in-process test server: step 5's client
# half has to open a socket to something it did not build, and a relay linked into
# the thing testing it would prove the two halves of one binary agree.
#
# `WEALD_RELAY_MIN_ENC=mls`, which is the hosted posture and is now the harness's
# too. It was `none` here for the whole of the relay track, and that one difference
# hid a client that could not connect to any relay with a floor at all: every green
# step was proved against the one configuration no customer runs
# (`specs/backend/build/deploy-render.md`). `WEALD_STACK_MIN_ENC=none` still exists
# because a self-hoster's Phase 2 is a real deployment shape
# (`specs/backend/relay/migration.md`) and the client's refusal has to be provable
# against a relay that accepts plaintext as well as against one that does not.
# Is the relay answering on our port the one this harness started?
#
# It matters more than it looks. `relay_start` used to see any answer on the port
# and report "already serving", so a *foreign* relay listening there became the
# relay every proof in every programme ran against: a published container image
# from the self-host app, an older build left behind by another checkout, anything.
# That is the shape of failure this whole loop exists to prevent, because the run
# still goes green and the green is about a binary nobody chose. It surfaced as a
# session refused with `version/protocol_unsupported` against a v0.1.5 image while
# this tree speaks protocol 3.
#
# Ownership is the pid file: we started it, so we know its pid, and a live process
# at that pid answering that port is ours. An overridden health URL is somebody
# else's relay on purpose (step 13's hosted proof), so it is ours by declaration.
relay_is_ours() {
  [ -n "${WEALD_STACK_RELAY_HEALTH_URL:-}" ] && return 0
  relay_pid >/dev/null
}

# Move to a free port when a stranger holds ours.
#
# Auto-selecting rather than failing, because a port number is not part of any
# proof: group ids, envelopes and access sets are identical whichever port carried
# them, and an unattended run that stopped here would be stopped by a neighbour's
# container rather than by anything about this programme. What must not happen
# silently is running *against* that neighbour, and that is what `relay_is_ours`
# now refuses. The move is printed, so the log says which socket the proof used.
# The port our own relay is already listening on, adopted before anything else.
#
# Every `weald-stack` invocation is a fresh process that starts from the default
# port, so without this the second command of a session would find the neighbour on
# the default, move off it, and start a *second* relay beside the one it already
# had. The pid file is the harness's memory of its own relay; this reads that
# process's actual socket back out, so one relay serves the whole session however
# many commands drive it.
relay_adopt_own_port() {
  local pid; pid="$(relay_pid)" || return 0
  local port
  port="$(lsof -nP -aPi -p "$pid" -iTCP -sTCP:LISTEN 2>/dev/null \
    | awk 'NR>1 { split($9, a, ":"); print a[length(a)] }' | sort -n | head -1)"
  [ -n "$port" ] || return 0
  [ "$port" = "$WEALD_STACK_RELAY_PORT" ] && return 0
  WEALD_STACK_RELAY_PORT="$port"
  export WEALD_STACK_RELAY_PORT
  RELAY_OBSERVABILITY_PORT=$(( WEALD_STACK_RELAY_PORT + 1 ))
}

relay_reclaim_port() {
  local port="$WEALD_STACK_RELAY_PORT"
  local limit=$((port + 20))
  while [ "$port" -le "$limit" ]; do
    if ! lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
      note "wealdrelay" "port $WEALD_STACK_RELAY_PORT is held by another process; using $port"
      WEALD_STACK_RELAY_PORT="$port"
      export WEALD_STACK_RELAY_PORT
      RELAY_OBSERVABILITY_PORT=$(( WEALD_STACK_RELAY_PORT + 1 ))
      return 0
    fi
    port=$((port + 2))
  done
  note "wealdrelay" "no free port between $WEALD_STACK_RELAY_PORT and $limit"
  return 1
}

relay_start() {
  local bin
  bin="$(relay_binary)" || true
  if [ -z "${bin:-}" ]; then
    cargo build --package wealdrelay --bin wealdrelay >/dev/null 2>&1 || true
    bin="$(relay_binary)" || true
  fi
  if [ -z "${bin:-}" ]; then
    note "wealdrelay" "no binary; cargo build --package wealdrelay failed"
    return 1
  fi
  if relay_answers; then
    if relay_is_ours; then
      note "wealdrelay" "already serving on 127.0.0.1:$WEALD_STACK_RELAY_PORT"
      return 0
    fi
    # Something else is on our port. Never adopt it: see `relay_is_ours`.
    relay_reclaim_port || return 1
  elif lsof -nP -iTCP:"$WEALD_STACK_RELAY_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    # Held, and answering nothing. A relay left wedged by a Postgres that went away
    # under it keeps its listener and fails every health check, and `up` then tried
    # to bind the port anyway and reported "Address already in use" while claiming
    # the stack was up: every crossing afterwards failed with "the relay is not
    # serving" for a reason that had nothing to do with what it was proving. The
    # port is not part of any proof, so this moves rather than killing a process
    # this harness cannot prove is its own.
    note "wealdrelay" "port $WEALD_STACK_RELAY_PORT is held by a process answering no health check"
    relay_reclaim_port || return 1
  fi
  mkdir -p "$STACK_STATE/blobs"
  # `--relay-db` is a database of the harness Postgres, created if absent. One
  # database for the harness relay and a fresh one per Rust integration test, so a
  # long-lived demo workspace is not wiped by a suite run.
  docker exec -i "$(dc ps -q postgres)" \
    psql -U weald -d postgres -tAc \
    "select 1 from pg_database where datname='weald_relay_stack'" 2>/dev/null \
    | grep -q 1 || \
    docker exec -i "$(dc ps -q postgres)" \
      createdb -U weald weald_relay_stack >/dev/null 2>&1 || true

  # No WEALD_RELAY_REDIS_URL. The harness runs exactly one relay process, and
  # server.md makes that variable the way a deployment declares it runs more than
  # one ("omit for single-process installs"), which is why config.rs refuses a
  # Push is off by default and is the one knob here that reaches a vendor when it
  # is not. `WEALD_STACK_PUSH=on WEALD_STACK_PUSH_URL=https://api.weald.team/v1/wake`
  # points a laptop relay at the deployed ringer, which is how a real phone is
  # woken from a local workspace: the handle is the whole of the authority
  # (`specs/backend/relay/ringer.md`), so this needs no local credential and the
  # ringer does not learn the workspace, the group or which relay called. Off by
  # default because a harness run should reach no vendor at all, and every suite
  # that exercises push does it against its own listener.
  #
  # process-local live fanout when it is set. Declaring it here was the harness
  # saying something untrue about itself: it kept the relay from starting at all
  # once the ephemeral path landed, and the alternative fix, WEALD_RELAY_LIVE=off,
  # would have turned presence off in the one place the suites exercise it. Redis
  # is still up in the compose file; the control plane's queue is what wants it.
  # The optional values are passed only when the operator actually set one.
  #
  # These were `"${WEALD_STACK_IMAGE_DIGEST:-}"` and `"${WEALD_STACK_PUSH_URL:-}"`,
  # which is not "leave it unset": it exports the key with an empty value, and
  # the relay refuses that on purpose, with `is set to an empty value; unset it
  # instead of setting it to nothing`. An empty string is a value somebody typed
  # and a configuration surface that silently treats it as absence is one where a
  # deployment cannot tell a missing secret from a blank one. So the relay is
  # right and the harness was wrong, and it only ever showed on a machine with no
  # relay already running: a warm `up` adopts the process it finds and never
  # reaches this line, which is why it failed first on a clean CI runner and
  # never on a laptop.
  # `${optional[@]+...}` rather than a bare expansion, and `if` rather than
  # `[ ... ] &&`: this runs under `set -eu`, where an unset array expands to an
  # error and a trailing `&&` that is false is the script's exit status.
  local optional=()
  if [ -n "${WEALD_STACK_IMAGE_DIGEST:-}" ]; then
    optional+=("WEALD_RELAY_IMAGE_DIGEST=$WEALD_STACK_IMAGE_DIGEST")
  fi
  if [ -n "${WEALD_STACK_PUSH_URL:-}" ]; then
    optional+=("WEALD_RELAY_PUSH_URL=$WEALD_STACK_PUSH_URL")
  fi

  WEALD_RELAY_HOSTNAME="$RELAY_HOSTNAME" \
  WEALD_RELAY_OPERATOR_TOKEN="$(relay_operator_token)" \
  WEALD_RELAY_DATABASE_URL="postgres://weald:weald@127.0.0.1:$WEALD_STACK_PG_PORT/weald_relay_stack" \
  WEALD_RELAY_STORAGE_URL="file://$STACK_STATE/blobs" \
  WEALD_RELAY_LISTEN="$WEALD_STACK_RELAY_BIND:$WEALD_STACK_RELAY_PORT" \
  WEALD_RELAY_OBSERVABILITY_LISTEN="$WEALD_STACK_RELAY_BIND:$RELAY_OBSERVABILITY_PORT" \
  WEALD_RELAY_TLS=off \
  WEALD_RELAY_RELEASE_CHECK=off \
  WEALD_RELAY_MIN_ENC="${WEALD_STACK_MIN_ENC:-mls}" \
  WEALD_RELAY_WRITE_MODE="${WEALD_STACK_WRITE_MODE:-full}" \
  WEALD_RELAY_PUSH="${WEALD_STACK_PUSH:-off}" \
  env ${optional[@]+"${optional[@]}"} \
    nohup "$bin" > "$RELAY_LOG_FILE" 2>&1 &
  echo $! > "$RELAY_PID_FILE"

  local deadline=$((SECONDS + 30))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if relay_answers; then
      note "wealdrelay" "serving on $(relay_ws_url)"
      return 0
    fi
    if ! relay_pid >/dev/null; then
      note "wealdrelay" "exited during startup; see $RELAY_LOG_FILE"
      tail -5 "$RELAY_LOG_FILE" >&2 || true
      return 1
    fi
    sleep 0.25
  done
  note "wealdrelay" "did not answer /healthz in 30s; see $RELAY_LOG_FILE"
  return 1
}

# --- enrolment ---------------------------------------------------------------
#
# The relay mints one single-use genesis key on first run and prints the invite
# link, the one-time code and the key's fingerprint to its own stdout
# (`specs/backend/relay/server.md`). Redeeming that invite is how a workspace gets
# its first member, and accepting the genesis access set is what destroys the key
# and writes entry zero of the transparency log
# (`specs/backend/relay/invites.md`).
#
# The harness drives that with a real client over a real socket, because the whole
# point of the step is that nobody else can: the relay verifies an Argon2id hash of
# a code it never learns, and the access set is signed by a device key that lives in
# an instance.
#
# The code is not stored anywhere. It exists in the banner and in the joiner's head,
# by design, so if this relay minted its key during an earlier run whose log is gone,
# there is no way to redeem it and no way to mint a second one. That is the right
# behaviour for a relay and an inconvenience for a harness, so `--reset` drops the
# genesis row and its bootstrap invite and restarts the relay to mint a fresh one.
# That is a harness action on a harness database and it is spelled out rather than
# hidden inside `up`.

relay_psql() {
  docker exec -i "$(dc ps -q postgres)" psql -U weald -d weald_relay_stack -tAc "$1" 2>/dev/null
}

genesis_state() {
  # `minted`, `redeemed`, or empty when this relay has never minted one.
  relay_psql "select case when secret_key is null then 'redeemed' else 'minted' end \
              from relay_genesis where workspace_id = '$ENROLLED_WORKSPACE'" | tr -d '[:space:]'
}

cmd_enrol() {
  local reset=0 into="" who="enrol" machine=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --reset) reset=1; shift ;;
      # Which checkout becomes the founder. The default is a directory of its own,
      # which is what `up` wants: a relay nobody has enrolled is a relay nobody can
      # join, and that founder is not one of a scenario's instances. `clients` passes
      # its own first instance, because the founder is the device that holds the
      # workspace's groups and its bootstrap secret, and a founder in a directory the
      # scenario never drives would hold both where nothing can use them.
      --into) into="$2"; shift 2 ;;
      --handle) who="$2"; shift 2 ;;
      # The device id this checkout's other verbs present. Passed through rather
      # than left to default, because the private key is filed under it and a
      # genesis set naming a different one is a workspace whose own founder is
      # refused (WEALD-L304).
      --machine) machine="$2"; shift 2 ;;
      *) echo "weald-stack enrol: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || { echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2; exit 1; }

  local state; state="$(genesis_state)"
  if [ "$state" = "redeemed" ] && [ "$reset" -eq 0 ]; then
    note "enrolment" "already done; the genesis key is destroyed, as it should be"
    return 0
  fi

  # A banner in the current log is a code we can type. Without one, the key was
  # minted by a run whose log is gone.
  if ! grep -q "weald:   invite code" "$RELAY_LOG_FILE" 2>/dev/null || [ "$reset" -eq 1 ]; then
    note "enrolment" "no code in this run's log; minting a fresh genesis key"
    # The whole pre-genesis state, not just the key. A workspace that kept its
    # access set from a previous enrolment would refuse the new genesis set as a
    # second version zero, which is correct of it and useless here.
    relay_psql "delete from relay_transparency_log where workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
    relay_psql "delete from relay_provisional_grant where workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
    # The entry, principal and quorum rows cascade from the set itself, which is
    # what `on delete cascade` on `(workspace_id, version)` is there for.
    relay_psql "delete from relay_access_probation where workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
    relay_psql "delete from relay_access_set where workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
    relay_psql "delete from relay_genesis where workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
    relay_psql "delete from relay_invite_reservation where token in \
                (select token from relay_invite where bootstrap and workspace_id = '$ENROLLED_WORKSPACE')" >/dev/null
    relay_psql "delete from relay_invite where bootstrap and workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
    # And everything the *previous* workspace carried, which is the half this
    # reset used to leave behind. `docker compose down` removes the containers
    # but not `weald-stack_postgres-data`, so the relay's database outlives the
    # stack: a fresh genesis then met the dead workspace's published channel
    # GroupInfo and the founder could not join its own channel, reporting "the
    # publication was sealed at a workspace epoch this device does not hold" --
    # a true sentence about a workspace nobody meant to still exist. Deleting
    # the key material and the groups is the whole point of a reset; a reset
    # that clears only the pre-genesis rows is a reset in name.
    #
    # Everything keyed by one of this workspace's groups, before the groups
    # themselves: `relay_envelope_group_id_fkey` and its siblings restrict rather
    # than cascade, so deleting the group first is refused and -- under `set -e`
    # with the output discarded -- takes the whole enrolment down without a word.
    # The order here is the foreign keys' order, not a preference.
    local group_scoped="relay_envelope relay_handshake relay_checkpoint_anchor \
relay_checkpoint relay_drop_run relay_invite_scope_commit relay_invite_scope \
relay_invite_bundle relay_recovery_wrap_prior relay_recovery_wrap \
relay_retention_manifest_rejected relay_retention_manifest \
relay_retention_destruction relay_retention_control_conflict \
relay_retention_control relay_retention_policy relay_blob_reservation"
    local table
    for table in $group_scoped; do
      relay_psql "delete from $table where group_id in \
                  (select group_id from relay_group \
                   where workspace_id = '$ENROLLED_WORKSPACE')" >/dev/null
    done
    relay_psql "delete from relay_group where workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
    relay_psql "delete from relay_key_package where workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
    relay_psql "delete from relay_recovery_rotation where workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
    relay_psql "delete from relay_bootstrap_handoff where workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
    relay_psql "delete from relay_push_handle where workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
    relay_psql "delete from relay_blob_reservation where workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
    relay_psql "delete from relay_invite_tombstone where workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
    relay_psql "delete from relay_log_budget where workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
    relay_psql "delete from relay_quota where workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
    relay_stop
    relay_start || return 1
  fi

  local token code fingerprint
  token="$(sed -n 's|^weald:   invite link  https://[^/]*/join/||p' "$RELAY_LOG_FILE" | tail -1)"
  code="$(sed -n 's/^weald:   invite code  //p' "$RELAY_LOG_FILE" | tail -1)"
  fingerprint="$(sed -n 's/^weald:   genesis key  //p' "$RELAY_LOG_FILE" | tail -1)"
  if [ -z "$token" ] || [ -z "$code" ] || [ -z "$fingerprint" ]; then
    note "enrolment" "the relay printed no invite banner; see $RELAY_LOG_FILE"
    return 1
  fi

  client_build
  local bin; bin="$(client_binary)"
  local dir="${into:-$CLIENTS_DIR/enrol}"
  if [ -z "$into" ]; then
    # A fresh directory per enrolment when this command owns it. The founder holds
    # the workspace's bootstrap secret and its MLS groups, and a directory left over
    # from an earlier genesis holds both for a workspace that no longer exists. A
    # caller that named a directory owns what is in it.
    rm -rf "$dir"
  fi
  mkdir -p "$dir"
  # The device the genesis access set names has to be the device every later verb in
  # this checkout presents: `--machine` when the caller stated one, and otherwise the
  # id pinned in `.weald-instance/machine-id`. Naming a different one is how
  # WEALD-L304 read as a relay refusing its own founder.
  local args=(--workspace "$dir" --workspace-id "$ENROLLED_WORKSPACE"
              --handle "$who" --selection relay --relay "$(relay_ws_url)")
  [ -n "$machine" ] && args+=(--machine "$machine")
  "$bin" relay-client "${args[@]}" init >/dev/null

  # The product's own first-admin enrolment, and not a second route to trust root.
  #
  # WEALD-L304: this used to be `redeem --id` followed by `access-publish`, which
  # takes the seat and publishes the genesis access set and stops there. That
  # founder is in the access set and holds no sealing group, no bootstrap secret and
  # no channels, so on a relay with a floor every envelope it writes is refused and
  # every invite it issues carries no bundles. `enrol` is the verb the setup sheet
  # drives (``WorkspaceSetupModel``): it takes the same seat, publishes the same
  # genesis set, and then founds the workspace's groups and writes the bootstrap
  # secret, which is what makes the founder able to seal and to invite.
  local out
  if ! out="$("$bin" relay-client "${args[@]}" enrol \
      --link "$(genesis_join_link "$token")" --code "$code" --fingerprint "$fingerprint" \
      --name "$who" 2>&1)"; then
    note "enrolment" "$out"
    return 1
  fi
  local groups plaintext
  groups="$(printf '%s\n' "$out" | sed -n 's/^groups=//p')"
  plaintext="$(printf '%s\n' "$out" | sed -n 's/^plaintext=//p')"
  if [ "${groups:-0}" -lt 1 ]; then
    note "enrolment" "the founder joined no group; it can publish but it cannot seal"
    return 1
  fi
  if [ "$plaintext" = "yes" ] && [ "${WEALD_STACK_MIN_ENC:-mls}" != "none" ]; then
    note "enrolment" "the founder founded its groups and still resolves the plaintext seal"
    return 1
  fi

  local entries fingerprint_stored
  entries="$(relay_psql "select count(*) from relay_transparency_log where workspace_id = '$ENROLLED_WORKSPACE'" | tr -d '[:space:]')"
  fingerprint_stored="$(relay_psql "select encode(fingerprint,'hex') from relay_genesis where workspace_id = '$ENROLLED_WORKSPACE'" | tr -d '[:space:]')"
  note "enrolment" "$ENROLLED_WORKSPACE founded, genesis $(echo "$fingerprint_stored" | cut -c1-12), groups $groups, log entries $entries"
  [ "$(genesis_state)" = "redeemed" ] || {
    note "enrolment" "the genesis key survived its own redemption"
    return 1
  }
}

# The banner's link, pointed at the socket this harness actually serves.
#
# The relay prints `https://<hostname>/join/<token>` because that is what a
# self-hoster's browser will fetch. Here the hostname is `localhost` and the socket
# is a plaintext loopback port, so the link the founder is handed carries the port
# and the scheme this harness serves; the token is the banner's own.
genesis_join_link() {
  local token="$1" url host port
  url="$(relay_ws_url)"
  host="$(printf '%s\n' "$url" | sed -E 's|^wss?://([^:/]+).*|\1|')"
  port="$(printf '%s\n' "$url" | sed -nE 's|^wss?://[^:/]+:([0-9]+).*|\1|p')"
  case "$url" in
    wss://*) printf 'https://%s%s/join/%s\n' "$host" "${port:+:$port}" "$token" ;;
    *) printf 'http://%s%s/join/%s\n' "$host" "${port:+:$port}" "$token" ;;
  esac
}

relay_stop() {
  local pid
  if pid="$(relay_pid)"; then
    kill "$pid" 2>/dev/null || true
    local deadline=$((SECONDS + 10))
    while [ "$SECONDS" -lt "$deadline" ] && kill -0 "$pid" 2>/dev/null; do sleep 0.2; done
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$RELAY_PID_FILE"
}

CLIENTS_DIR="${WEALD_CLIENTS_DIR:-$STACK_STATE/clients}"
: "${WEALD_WORKSPACE_ID:=weald-demo}"

# The app binary, which is also the client instance. See Sources/CLI/RelayClientCLI.swift.
# `WEALD_DERIVED_DATA`, when set, is honoured for the same reason
# `scripts/swift-test.sh` honours it: this repository is routinely built by more
# than one session at once, and the app the harness executes lives in the same
# DerivedData a concurrent `xcodebuild` is rewriting. A binary replaced while it
# is running is killed by the kernel with SIGKILL, which surfaces here as
# `Killed: 9` from a client that did nothing wrong. Pointing the harness at the
# gate's own DerivedData removes the race rather than retrying through it.
client_derived_data_args() {
  [ -n "${WEALD_DERIVED_DATA:-}" ] && printf '%s\n%s\n' -derivedDataPath "$WEALD_DERIVED_DATA"
}

client_binary() {
  local built
  built="$(xcodebuild -project "$ROOT/Weald.xcodeproj" -scheme Weald -configuration Debug \
    $(client_derived_data_args) \
    -showBuildSettings 2>/dev/null | awk '/ BUILT_PRODUCTS_DIR = /{print $3; exit}')"
  [ -n "$built" ] || return 1
  local bin="$built/Weald.app/Contents/MacOS/Weald"
  [ -x "$bin" ] || return 1
  echo "$bin"
}

client_build() {
  # Always, rather than only when no binary exists. A crossing is a proof about the
  # code in this tree, and a harness that reused whatever `DerivedData` happened to
  # hold would prove it about a build nobody can name: an edit to the client made
  # between two runs simply would not be in the second one. `xcodebuild` is
  # incremental, so the cost of this on an unchanged tree is a few seconds, and the
  # cost of not doing it is a green recorded against code that was never run.
  echo "building the client instance (xcodebuild)"
  # Retried on the lock, not on failure. This repository is routinely built by more
  # than one session at once and Xcode's build database is a single file per
  # DerivedData: a second build meeting the first is told "database is locked",
  # which is a queue to wait in rather than a broken tree. Any other failure is
  # reported on its first attempt.
  local attempt=0
  while :; do
    if xcodebuild -project "$ROOT/Weald.xcodeproj" -scheme Weald -configuration Debug \
      $(client_derived_data_args) build \
      >"$STACK_STATE/client-build.log" 2>&1; then
      break
    fi
    if grep -q "database is locked" "$STACK_STATE/client-build.log" && [ "$attempt" -lt 20 ]; then
      attempt=$((attempt + 1))
      echo "  another build holds DerivedData; waiting ($attempt)"
      sleep 15
      continue
    fi
    echo "weald-stack: the client did not build; see $STACK_STATE/client-build.log" >&2
    tail -20 "$STACK_STATE/client-build.log" >&2
    return 1
  done
}

# `-i` deliberately absent. A `docker exec -i` inside a `while read` loop consumes
# the loop's own stdin and the loop then runs once, which is how group registration
# silently registered one group out of two.
psql_relay() {
  # `WEALD_STACK_RELAY_PSQL_URL` points this at the relay's own database wherever
  # it is, which for step 13's hosted proof is a managed Postgres at a provider.
  # The registration it performs is the same insert either way, and it is the
  # thing a control plane will do once one exists (step 16).
  if [ -n "${WEALD_STACK_RELAY_PSQL_URL:-}" ]; then
    psql "$WEALD_STACK_RELAY_PSQL_URL" "$@"
    return
  fi
  docker exec "$(dc ps -q postgres)" psql -U weald -d weald_relay_stack "$@"
}

# The relay's own database, dumped to stdout.
#
# `pg_dump` of the database the running relay writes to, after it has carried a
# run's traffic. It exists so a gate can search the relay's storage for something
# it must not be holding, which is the only honest form of a blindness claim: a
# grep over a client's log or over a mocked table proves nothing about the server.
#
# Deliberately the whole database rather than one table. Blindness is a property of
# everything the relay persists, and a dump narrowed to the table somebody expected
# a leak in is a dump that cannot find one anywhere else.
#
# `scripts/prove-blind.py` is the thorough version and searches a binary COPY and
# the on-disk heap as well, because a text dump can miss an encoding. This is the
# cheap one, for gates that need a needle absent rather than a full analysis.
cmd_dump_db() {
  require_daemon
  if [ -n "${WEALD_STACK_RELAY_PSQL_URL:-}" ]; then
    pg_dump "$WEALD_STACK_RELAY_PSQL_URL"
    return
  fi
  local container; container="$(dc ps -q postgres)"
  [ -n "$container" ] || {
    echo "weald-stack: postgres is not up. scripts/weald-stack up" >&2
    return 1
  }
  docker exec "$container" pg_dump -U weald -d weald_relay_stack
}

# Register a workspace's groups with the relay, where the harness can reach its
# database, and otherwise leave it to the relay.
#
# `accept.rs` answers `denied/group_unknown` for a group with no row, and it is
# right to: a relay that created a group on first write would let anyone with a
# socket allocate storage on somebody else's plan. This function pre-dates
# `access::store::ensure_groups` and pre-dates any hosted instance, so it reached
# into Postgres with `psql`, which a fixture can do and a customer cannot.
#
# Now the relay writes the row itself, bounded to a device the workspace's current
# access set carries, so a workspace whose founding publication lands needs nothing
# here at all. This stays for the case that motivated it, which
# `ensure_groups` deliberately does not cover: a fixture that names groups **before**
# any device has been admitted, where there is no access set to bound the write by.
#
# `WEALD_STACK_RELAY_HOSTED=1` says the relay is somewhere this machine has no
# database credential for, which is the ordinary case for a provisioned instance,
# and it is skipped rather than attempted. The ids come from the client itself
# (`relay-client groups`) rather than from a bash reimplementation of
# GroupID.derive, because two implementations of a hash is two to disagree.
clients_register_groups() {
  local bin="$1" workspace_dir="$2"
  local id scope
  if [ "${WEALD_STACK_RELAY_HOSTED:-0}" = 1 ] && [ -z "${WEALD_STACK_RELAY_PSQL_URL:-}" ]; then
    note "group" "not registered here: the relay writes its own rows on the founding publication"
    return 0
  fi
  while read -r id scope; do
    [ -n "$id" ] || continue
    psql_relay -v ON_ERROR_STOP=1 -q -c \
      "insert into relay_group (group_id, workspace_id) values (decode('$id','hex'), '$WEALD_WORKSPACE_ID') on conflict do nothing" \
      >/dev/null
    note "group" "$scope ${id:0:12}"
  done < <("$bin" relay-client --workspace "$workspace_dir" \
             --workspace-id "$WEALD_WORKSPACE_ID" groups)
}

# Supervised client instances: one directory and one process each.
#
# `local-harness.md` calls for separate processes with separate workspace
# containers, and this is that. Each instance is `scripts/relay-client.sh`, which
# compiles the app's own `Sources/Sync` types, so an instance speaks the wire the
# shipping client speaks rather than a second implementation of it.
REMOTE_REPO="${WEALD_REMOTE_REPO:-$STACK_STATE/remote.git}"

# The git substrate, for real. A bare repository the instances push to and pull
# from, because `GitTransport` deliberately does not run git itself: publishing in
# the git substrate is writing the file, and the tree moves by whatever commit and
# pull the team already does. Here the harness is the team.
git_remote_init() {
  [ -d "$REMOTE_REPO" ] && return 0
  git init --bare --quiet --initial-branch=main "$REMOTE_REPO"
}

instance_git() { git -C "$1" -c user.name="$2" -c user.email="$2@weald.local" "${@:3}"; }

instance_push() {
  local dir="$1" who="$2"
  instance_git "$dir" "$who" add -A >/dev/null 2>&1 || true
  # Nothing to commit is the ordinary case for an instance that only received, and
  # it is not a failure.
  instance_git "$dir" "$who" commit -q -m "$who" >/dev/null 2>&1 || true
  instance_git "$dir" "$who" push -q origin main 2>/dev/null || \
    instance_git "$dir" "$who" push -q --set-upstream origin main
}

instance_pull() {
  local dir="$1" who="$2"
  instance_git "$dir" "$who" fetch -q origin main
  # A union merge over the chat shards and the log, which is the merge the product
  # relies on and therefore the merge the proof has to exercise.
  instance_git "$dir" "$who" merge -q --no-edit origin/main >/dev/null 2>&1 || \
    instance_git "$dir" "$who" merge -q --no-edit --allow-unrelated-histories origin/main
}

instance_create() {
  local bin="$1" name="$2" selection="$3"
  local dir="$CLIENTS_DIR/$name"
  if [ ! -d "$dir/.git" ] && git ls-remote --exit-code --heads "$REMOTE_REPO" main >/dev/null 2>&1; then
    # Every instance after the first is a clone, not a second unrelated history.
    # Three trees that each invented their own root commit would merge only with
    # --allow-unrelated-histories, and a proof that needed that flag would be
    # proving something no real checkout does.
    rm -rf "$dir"
    git clone --quiet "$REMOTE_REPO" "$dir"
  fi
  mkdir -p "$dir"
  if [ ! -d "$dir/.git" ]; then
    git init --quiet --initial-branch=main "$dir"
    git -C "$dir" remote add origin "$REMOTE_REPO"
    {
      # The private key never travels. `.weald-instance/` is this process's key
      # store and its workspace id; the relay cursor is one relay's numbering of one
      # group and is meaningless in another checkout.
      echo ".weald-instance/"
      echo ".weald/relay/"
      # Per-instance and never shared: which transport this checkout is on is a
      # property of this machine, and three instances of one workspace on three
      # transports is the whole point of the scenario.
      echo ".weald/project.json"
    } > "$dir/.gitignore"
    {
      # The merge the substrate is built on. Chat shards and the envelope log are
      # append-only, so a union merge of two sides is the union of two sets of
      # records, which is exactly what convergence means here.
      echo "*.jsonl merge=union"
      echo "*.bin  merge=union"
    } > "$dir/.gitattributes"
    instance_git "$dir" "$name" add -A >/dev/null
    instance_git "$dir" "$name" commit -q -m "$name workspace" >/dev/null
    instance_git "$dir" "$name" push -q --set-upstream origin main
  fi
  local args=(--workspace "$dir" --workspace-id "$WEALD_WORKSPACE_ID"
              --handle "$name" --machine "$name" --selection "$selection")
  if [ "$selection" != "git" ]; then args+=(--relay "$(relay_ws_url)"); fi
  "$bin" relay-client "${args[@]}" init >/dev/null
  echo "$selection" > "$dir/.weald-instance/selection"
  # The workspace's bootstrap secret, which is the harness's stand-in for the 32
  # bytes an invitee gets in its invite's URL fragment
  # (`specs/backend/relay/invites.md`). Every standing `GroupInfo` this workspace
  # publishes is sealed under a key derived from it, so a client that does not have
  # it cannot enter a group, and the relay never sees it: it is written to disk here
  # and read by the client, and no code path sends it over a socket.
  #
  # One value for the workspace, generated once and copied. Copied rather than
  # re-derived, because two clients that derived different secrets would each seal
  # publications the other cannot open and both would sit waiting for a group that
  # already exists.
  cp "$CLIENTS_DIR/bootstrap-secret" "$dir/.weald-instance/bootstrap-secret"
  # Exactly one founder, and it is the first instance. Every other client joins the
  # groups it created by external commit. Two founders would create two groups under
  # one id and nothing would ever converge, which is why this is a marker on disk
  # rather than a race the clients resolve between themselves.
  if [ "$name" = "c1" ]; then : > "$dir/.weald-instance/founder"; fi
  note "client $name" "$selection, $dir"
}

# Found the workspace these instances share, and admit every one of them to it.
#
# WEALD-L304. This used to be one `access-publish` from the first instance with a
# socket, which is a genesis publication, and on a relay running the shipped posture
# (`WEALD_RELAY_ACCESS_SET=enforce`) a genesis publication is reserved to the single
# device holding the live reservation on that relay's bootstrap invite
# (`backend/wealdrelay/src/access/store.rs`, `publish_for`, and
# `invite/genesis.rs`, `founding_workspace`). No instance holds one, so every
# instance was refused `denied/writer_not_in_access_set` and no relay scenario could
# stand a workspace up at all.
#
# So the workspace is founded the way the product founds one: the first instance
# with a socket enrols against this relay's own first-run banner (`cmd_enrol`, which
# drives the shipped `enrol` verb), which publishes the genesis set, founds the
# workspace's three groups and writes its bootstrap secret. Every other instance is
# then admitted by that founder, as a member and not as an authorizer, which is the
# same amendment the Mac publishes when it admits a paired phone.
clients_found() {
  local bin="$1" fresh="$2"; shift 2
  local names=("$@")
  local founder="" name selection
  for name in "${names[@]}"; do
    selection="$(cat "$CLIENTS_DIR/$name/.weald-instance/selection" 2>/dev/null || echo git)"
    if [ "$selection" != "git" ] && [ -z "$founder" ]; then founder="$name"; fi
  done
  if [ -z "$founder" ]; then
    # Every instance is on git. Nothing has to be founded at the relay, and the
    # groups are registered the way they always were, because two_workspaces asserts
    # a git workspace's rows exist and hold nothing.
    clients_register_groups "$bin" "$CLIENTS_DIR/${names[0]}"
    note "workspace" "not founded at the relay: every instance is on git"
    return 0
  fi

  local reset=()
  if [ "$fresh" -eq 1 ] || [ "$(genesis_state)" = "redeemed" ]; then
    # A fresh run, or a relay whose genesis this harness already spent. Either way
    # the workspace starts again from a fresh genesis key, which is a harness action
    # on a harness database: the product has no reissue and must not grow one
    # (`invite/genesis.rs`, `reminder`).
    reset=(--reset)
    relay_workspace_wipe
  fi
  cmd_enrol ${reset[@]+"${reset[@]}"} --into "$CLIENTS_DIR/$founder" --handle "$founder" \
    --machine "$founder" || return 1

  # Every other instance, admitted by the founder. Named including the git-only ones:
  # a checkout on the git substrate opens no socket and needs no entry today, but it
  # is a device of this workspace and the transport it is on this week is not a
  # membership fact.
  local args=(--workspace "$CLIENTS_DIR/$founder" --workspace-id "$WEALD_WORKSPACE_ID"
              --handle "$founder" --machine "$founder"
              --selection relay --relay "$(relay_ws_url)")
  local device admitted=0
  for name in "${names[@]}"; do
    [ "$name" = "$founder" ] && continue
    device="$("$bin" relay-client --workspace "$CLIENTS_DIR/$name" --handle "$name" \
      --machine "$name" device | sed -n 's/^device=//p')"
    [ -n "$device" ] && { args+=(--device "$device"); admitted=$((admitted + 1)); }
  done
  if [ "$admitted" -eq 0 ]; then
    note "access set" "founded by $founder, no other instance to admit"
    return 0
  fi
  local out
  if ! out="$("$bin" relay-client "${args[@]}" admit 2>&1)"; then
    note "access set" "not amended: $out"
    return 1
  fi
  note "access set" "founded by $founder, version $(printf '%s\n' "$out" | sed -n 's/^published=//p'), $admitted admitted"
}

# Everything this relay's workspace holds, dropped, so a fresh run counts one run.
#
# Only ever the harness's own database and only ever one workspace's rows. The
# envelopes and groups go with the access set, because a workspace founded again
# under the same id would otherwise count the previous run's envelopes in every
# proof, which is what the timestamped group namespace used to buy and what a
# genesis-founded workspace cannot buy: its id is the relay's own.
relay_workspace_wipe() {
  relay_psql "delete from relay_envelope where group_id in \
              (select group_id from relay_group where workspace_id = '$ENROLLED_WORKSPACE')" >/dev/null
  relay_psql "delete from relay_key_package where workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
  relay_psql "delete from relay_group where workspace_id = '$ENROLLED_WORKSPACE'" >/dev/null
}

# weald-stack clients N [--selections a,b,c] [--fresh]
cmd_clients() {
  local count="${1:-3}"
  shift || true
  local selections="" fresh=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --selections) selections="$2"; shift 2 ;;
      --fresh) fresh=1; shift ;;
      *) echo "weald-stack clients: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  case "$count" in
    ''|*[!0-9]*) echo "weald-stack clients N: N must be a number" >&2; exit 64 ;;
  esac
  require_daemon
  relay_answers || { echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2; exit 1; }
  client_build
  local bin; bin="$(client_binary)"

  # Which workspace these instances are in, decided before the first one exists.
  #
  # A relay serves one workspace and mints one genesis key for it, so an instance
  # with a socket is an instance in `ws:<the relay's hostname>` and nothing else: a
  # group namespace of the harness's own invention has no genesis key, cannot be
  # founded, and is what WEALD-L304 recorded. A workspace entirely on git keeps the
  # harness's id, because no relay has an opinion about it.
  local relay_backed=0 pick
  if [ -n "$selections" ]; then
    case ",$selections," in *,relay,*|*,dual,*) relay_backed=1 ;; esac
  else
    relay_backed=1
  fi
  if [ "$relay_backed" -eq 1 ]; then
    WEALD_WORKSPACE_ID="$ENROLLED_WORKSPACE"
  fi
  if [ "$fresh" -eq 1 ]; then
    clients_stop
    rm -rf "$CLIENTS_DIR" "$REMOTE_REPO"
    if [ "$relay_backed" -eq 0 ]; then
      # A fresh scenario is a fresh group namespace as well as a fresh disk. Reusing
      # the ids would leave the previous run's envelopes in the relay and every count
      # in the proof would be measuring two runs at once. A relay-backed workspace
      # cannot rename itself, so it gets the same freshness by dropping the previous
      # run's rows: see `relay_workspace_wipe`.
      WEALD_WORKSPACE_ID="${WEALD_WORKSPACE_ID}-$(date +%s)"
    fi
  fi
  mkdir -p "$CLIENTS_DIR"
  # One secret per workspace, minted before the first instance exists.
  if [ ! -f "$CLIENTS_DIR/bootstrap-secret" ]; then
    python3 -c 'import os; print(os.urandom(32).hex())' > "$CLIENTS_DIR/bootstrap-secret"
  fi
  git_remote_init

  # Default roles are step 5's gate, verbatim: "three clients, one relay-only, one
  # git-only, one on both". Beyond three the cycle repeats, which is what a soak
  # wants and what nothing else asks for.
  local default_selections=(relay git dual)
  local names=() picks=()
  if [ -n "$selections" ]; then
    IFS=',' read -r -a picks <<< "$selections"
  fi
  local i
  for (( i = 0; i < count; i++ )); do
    local selection="${picks[$i]:-${default_selections[$(( i % 3 ))]}}"
    local name
    name="$(printf 'c%d' "$((i + 1))")"
    names+=("$name")
    instance_create "$bin" "$name" "$selection"
  done

  # No group registration for a relay-backed workspace. The relay writes its own
  # rows: the founding publication registers the groups the founder's connection
  # named, and every group after it is learned from a member's `CONNECT`
  # (`access/store.rs`, `ensure_groups`). Inserting them by hand was the harness
  # provisioning a workspace the relay had no genesis key for.
  clients_found "$bin" "$fresh" "${names[@]}"
  echo "$WEALD_WORKSPACE_ID" > "$CLIENTS_DIR/workspace-id"
  echo
  echo "workspace $WEALD_WORKSPACE_ID, relay $(relay_ws_url)"
  echo "drive one with:"
  echo "  scripts/weald-client c1 send 'hello'"
}

# --- the step 5 scenarios ----------------------------------------------------
#
# Four proofs from `specs/backend/build/phases-relay.md` step 5, each run against
# real client processes, a real relay process, real Postgres and a real git remote.
# Each writes an artifact, because a scenario that printed "ok" and kept nothing
# proves whatever the reader remembers.

SCENARIO_OUT="${WEALD_SCENARIO_OUT:-$ROOT/build-evidence/step-05}"

wc_() { "$ROOT/scripts/weald-client" "$@"; }

# One field out of a `key=value` block.
field() { awk -F= -v k="$2" '$1 == k { print substr($0, length(k) + 2) }' <<< "$1"; }

scenario_state() { wc_ "$1" state; }

scenario_fail() { echo "SCENARIO FAILED: $*" >&2; exit 1; }

# The three-client convergence proof, and the offline catch-up that shares its
# shape. Split into named functions so the gate can run one without the others.
scenario_converge() {
  local out="$SCENARIO_OUT/converge.txt"
  mkdir -p "$SCENARIO_OUT"
  cmd_clients 3 --fresh >/dev/null
  {
    echo "# Three clients converge: relay-only, git-only, and both"
    echo
    echo "workspace $(cat "$CLIENTS_DIR/workspace-id")"
    echo "relay     $(relay_ws_url)"
    echo "remote    $REMOTE_REPO"
    echo
    echo "c1 relay-only, c2 git-only, c3 on both."
    echo
  } > "$out"

  # Each client authors, and the substrate each one has moves it.
  wc_ c1 send "from the relay-only client" >/dev/null
  wc_ c1 --seconds 30 sync >> "$out"
  wc_ c2 send "from the git-only client" >/dev/null
  wc_ c2 push
  wc_ c3 pull
  wc_ c3 send "from the client on both" >/dev/null
  wc_ c3 ticket --id T-1 --title "written by the dual client" --body "step 5" >/dev/null
  # Twice. The first round carries this checkout's own records up and the relay's
  # down; the second offers what the first round pulled out of git, which is the
  # bridge a split team depends on.
  wc_ c3 --seconds 30 sync >> "$out"
  wc_ c3 --seconds 30 sync >> "$out"
  wc_ c3 push
  wc_ c1 --seconds 30 sync >> "$out"
  wc_ c2 pull

  local d1 d2 d3 s1 s2 s3
  s1="$(scenario_state c1)"; s2="$(scenario_state c2)"; s3="$(scenario_state c3)"
  d1="$(field "$s1" digest)"; d2="$(field "$s2" digest)"; d3="$(field "$s3" digest)"
  {
    echo
    echo "## Final state, per client"
    echo
    printf '%s\n\n%s\n\n%s\n' "$s1" "$s2" "$s3"
  } >> "$out"
  [ "$d1" = "$d2" ] && [ "$d2" = "$d3" ] || {
    echo "digests: c1=$d1 c2=$d2 c3=$d3" >> "$out"
    scenario_fail "three clients did not converge; see $out"
  }
  [ "$(field "$s1" chat)" = "3" ] || scenario_fail "expected 3 chat records, got $(field "$s1" chat)"
  [ "$(field "$s1" tickets)" = "1" ] || scenario_fail "the ticket did not reach the relay-only client"
  echo "CONVERGED on $d1" | tee -a "$out"
}

# A client offline for a day catches up, in both directions.
#
# "Offline" is real here and not simulated by a flag: every `send` below is its own
# process that never opens a socket, so the in-memory outbox those writes would have
# used does not merely get dropped, it never exists. What has to carry them is the
# log plus the first reconciliation round after the relaunch.
scenario_catchup() {
  local out="$SCENARIO_OUT/catchup.txt"
  mkdir -p "$SCENARIO_OUT"
  cmd_clients 2 --selections relay,relay --fresh >/dev/null
  {
    echo "# A client offline for a day catches up"
    echo
    echo "workspace $(cat "$CLIENTS_DIR/workspace-id")"
    echo
    echo "c1 writes 3 records a day back and never opens a socket."
    echo "c2 writes 20 records and syncs each time, which is the day c1 missed."
    echo
  } > "$out"

  local i
  for i in 1 2 3; do
    wc_ c1 --days-ago 1 send "offline write $i" >/dev/null
  done
  for i in $(seq 1 20); do
    wc_ c2 send "live write $i" >/dev/null
  done
  wc_ c2 --seconds 30 sync >> "$out"

  # One relaunch, one round.
  local before after
  before="$(date +%s)"
  wc_ c1 --seconds 45 sync >> "$out"
  after="$(date +%s)"
  wc_ c2 --seconds 30 sync >> "$out"

  local s1 s2
  s1="$(scenario_state c1)"; s2="$(scenario_state c2)"
  {
    echo
    echo "## Final state"
    echo
    printf '%s\n\n%s\n' "$s1" "$s2"
    echo
    echo "catch_up_seconds=$(( after - before ))"
  } >> "$out"
  [ "$(field "$s1" digest)" = "$(field "$s2" digest)" ] || \
    scenario_fail "the offline client did not catch up; see $out"
  [ "$(field "$s1" chat)" = "23" ] || \
    scenario_fail "expected 23 records after catch-up, got $(field "$s1" chat)"
  echo "CAUGHT UP in $(( after - before ))s on $(field "$s1" digest)" | tee -a "$out"
}

# The relay serves a forked history and the client detects it.
scenario_fork() {
  local out="$SCENARIO_OUT/fork.txt"
  mkdir -p "$SCENARIO_OUT"
  cmd_clients 2 --selections relay,relay --fresh >/dev/null
  {
    echo "# The relay serves a forked history and the receiving client detects it"
    echo
    echo "c1 authors two records, then a third at a counter it has already used,"
    echo "correctly signed and correctly addressed. The relay stores both, because"
    echo "it holds no key and cannot see a chain. c2 receives both and audits."
    echo
  } > "$out"

  wc_ c1 send "first" >/dev/null
  wc_ c1 send "second" >/dev/null
  wc_ c1 --seconds 30 sync >> "$out"
  echo >> "$out"
  wc_ c1 fork "a second record at a counter already used" >> "$out"
  wc_ c1 --seconds 30 sync >> "$out"
  wc_ c2 --seconds 30 sync >> "$out"

  local audit alarms
  audit="$(wc_ c2 audit)"
  alarms="$(field "$audit" alarms)"
  {
    echo
    echo "## The receiving client's audit"
    echo
    echo "$audit"
  } >> "$out"
  [ "${alarms:-0}" -ge 1 ] || scenario_fail "the fork was not detected; see $out"
  # And the same fact reaches the indicator rather than staying in a test.
  local synced
  synced="$(wc_ c2 --seconds 20 sync)"
  echo "$synced" >> "$out"
  [ "$(field "$synced" alarms)" -ge 1 ] || \
    scenario_fail "the fork was audited but the connection status did not report it"
  echo "DETECTED $alarms alarm(s)" | tee -a "$out"
}

# A rollback to git-only strands nothing.
scenario_rollback() {
  local out="$SCENARIO_OUT/rollback.txt"
  mkdir -p "$SCENARIO_OUT"
  cmd_clients 2 --selections dual,relay --fresh >/dev/null
  {
    echo "# A rollback to git-only strands nothing"
    echo
    echo "c1 is on both transports and receives content that only ever arrived over"
    echo "the relay. Its transport is then set back to git, which is the Phase 0 to 2"
    echo "rollback in specs/backend/relay/migration.md: a flag, not a migration."
    echo
  } > "$out"

  wc_ c1 send "written on both" >/dev/null
  wc_ c1 ticket --id T-9 --title "written before the rollback" >/dev/null
  wc_ c2 send "arrives only over the relay" >/dev/null
  wc_ c2 --seconds 30 sync >> "$out"
  wc_ c1 --seconds 30 sync >> "$out"

  local before after
  before="$(scenario_state c1)"
  {
    echo
    echo "## Before the rollback, on both transports"
    echo
    echo "$before"
  } >> "$out"
  [ "$(field "$before" chat)" = "2" ] || \
    scenario_fail "the dual client did not receive over the relay; see $out"

  # The rollback itself: one key in one file.
  python3 - "$CLIENTS_DIR/c1/.weald/project.json" <<'PY'
import json, sys
path = sys.argv[1]
with open(path) as handle:
    config = json.load(handle)
config.setdefault("relay", {})["transport"] = "git"
with open(path, "w") as handle:
    json.dump(config, handle, indent=2, sort_keys=True)
PY
  echo git > "$CLIENTS_DIR/c1/.weald-instance/selection"

  after="$(scenario_state c1)"
  {
    echo
    echo "## After the rollback, on git alone"
    echo
    echo "$after"
    echo
    echo "The transport it now resolves to:"
    wc_ c1 sync
  } >> "$out"
  [ "$(field "$before" digest)" = "$(field "$after" digest)" ] || \
    scenario_fail "the rollback changed what the workspace holds; see $out"
  [ "$(field "$before" envelopes)" = "$(field "$after" envelopes)" ] || \
    scenario_fail "the rollback stranded records; see $out"
  echo "NOTHING STRANDED, still $(field "$after" digest)" | tee -a "$out"
}

# --- step 22: two workspaces bound on one machine ----------------------------
#
# `phases-app.md` step 22 asks for "a second workspace bound on one machine, on a
# different transport from the first, both live at once, no key crossing between
# them". Every word of that is load bearing and none of it is a filesystem test:
#
# - **Bound** means bound by the shipping binder and the shipping transport switch.
#   Each workspace here is created by `relay-client bind`, which calls
#   `WorkspaceBinder.create` and `RelayConfigurationWriter.select` and nothing else,
#   so what is proven is the code the sidebar runs.
# - **Different transports** means one workspace reaches its peer over a socket to
#   the relay and the other over a git remote, at the same time, on this laptop.
# - **Both live at once** is measured rather than asserted: each workspace's round
#   runs as its own process, the two runs are launched together, and their start and
#   end times have to overlap. A sequential proof would say nothing about two live
#   workspaces, which is the state a person is actually in.
# - **No key crossing** is the one that matters. Two workspaces are two group
#   namespaces, two bootstrap secrets, two device key stores and two sets of
#   records, and the failure this catches is any of them being shared: a group id in
#   common, a record count that includes the other workspace's message, or the
#   git-only workspace appearing in the relay's database at all.
STEP22_OUT="${WEALD_STEP22_OUT:-$ROOT/build-evidence/step-22}"
STEP10_OUT="${WEALD_STEP10_OUT:-$ROOT/build-evidence/step-10}"
STEP24_OUT="${WEALD_STEP24_OUT:-$ROOT/build-evidence/step-24}"

# --- step 10: checkpoint-anchored compaction, end to end -------------------
#
# `phases-relay.md` step 10 asks that "compaction on the fixture workspace
# reclaims the expected bytes, with checkpoint manifest verification before
# `drop_before`, and every remaining client still converges afterward", and that a
# `drop_before` whose manifest fails verification refuses to run.
#
# Every part of that is real here. Two client processes on a real socket write
# real history; one of them writes a snapshot and a signed checkpoint above it and
# publishes both as ordinary envelopes; the second authorizer signs the retention
# policy with its own key in its own process, because neither device can sign for
# the other and that is the whole content of two-person approval; and the drop is
# the relay's own statement against its own table. What survives is then read back
# out of Postgres rather than asserted from the client's answer.
# Proof 1's negative: a relay running a digest nothing published, and the client
# saying so.
#
# `specs/backend/relay/verification.md`: a mismatch "is not a log line: it is a
# banner naming the expected and reported digests, shown to every connected user
# until acknowledged". So this deploys a digest no release feed will ever carry,
# connects a real client over a real socket, and reads what the client was told
# rather than what a test constructed.
#
# The two halves are deliberately separate. The relay reporting a digest is a
# wire fact and is asserted from the client's own status line; the verdict that
# follows from it is `ReleaseComparison`'s and is asserted in the Swift suite.
# A scenario that asserted the verdict here would be asserting a pure function
# over a socket.
scenario_digest_mismatch() {
  local out="$SCENARIO_OUT/digest-mismatch.txt"
  mkdir -p "$SCENARIO_OUT"
  local forged="sha256:$(printf 'd%.0s' $(seq 1 64))"

  cmd_clients 1 --fresh >/dev/null
  relay_stop
  WEALD_STACK_IMAGE_DIGEST="$forged" relay_start || \
    scenario_fail "the relay did not restart with a baked digest"

  # `sync` and not `state`: the handshake facts are reported by the verb that
  # performs a handshake, and `state` prints a content digest of the working
  # tree under its own `digest` key.
  local state
  state="$(wc_ c1 sync --selection relay --seconds 6)"
  local reported
  reported="$(field "$state" builddigest)"

  {
    echo "# A relay running a digest nobody published"
    echo
    echo "Generated $(date -u +%Y-%m-%dT%H:%M:%SZ) by scripts/weald-stack scenario digest-mismatch"
    echo
    echo "The relay was restarted with WEALD_RELAY_IMAGE_DIGEST set to a value no"
    echo "release feed carries, which is what ordinary deployment drift looks like"
    echo "from the client's side."
    echo
    echo "baked into the relay   $forged"
    echo "reported to the client $reported"
    echo "access set             $(field "$state" accessset)"
    echo "encryption floor       $(field "$state" minenc)"
    echo
    echo "The client is shown the relay's own claim, verbatim, over the"
    echo "authenticated socket. What follows from it is ReleaseComparison's:"
    echo "a digest in sha256 form that matches no published release is the one"
    echo "verdict that raises a banner for every connected user."
  } > "$out"

  [ "$reported" = "$forged" ] || \
    scenario_fail "the client was told '$reported', not the deployed '$forged'"

  # And the same relay, restarted without a baked digest, reports the honest
  # self-hash rather than remembering the last thing it was told.
  relay_stop
  relay_start || scenario_fail "the relay did not restart without a baked digest"
  local honest
  honest="$(field "$(wc_ c1 sync --selection relay --seconds 6)" builddigest)"
  case "$honest" in
    exe-blake3:*) ;;
    *) scenario_fail "a relay with no baked digest reported '$honest'" ;;
  esac
  echo "" >> "$out"
  echo "restarted with nothing baked in, the same relay reports $honest" >> "$out"
  echo "which is a true statement about the running binary and is labelled so it" >> "$out"
  echo "can never be compared against a release and read as a mismatch." >> "$out"

  echo "digest-mismatch: the client was told $forged, then $honest"
}

scenario_compaction() {
  local out="$STEP10_OUT/compaction.txt"
  mkdir -p "$STEP10_OUT"
  cmd_clients 2 --selections relay,relay --fresh >/dev/null
  local ws; ws="$(cat "$CLIENTS_DIR/workspace-id")"
  local group_sql="select encode(g.group_id,'hex') from relay_group g where g.workspace_id = '$ws'"

  {
    echo "# Checkpoint-anchored compaction, end to end"
    echo
    echo "workspace $ws"
    echo "relay     $(relay_ws_url)"
    echo
  } > "$out"

  local index
  for index in 1 2 3 4 5; do
    wc_ c1 send "compaction record $index" >/dev/null
  done
  wc_ c1 --seconds 30 sync >/dev/null
  wc_ c2 --seconds 30 sync >/dev/null
  # A third round, because the retention control chain is published in the pass
  # that commits and the joiner's external commit is what moves the group to
  # epoch one. Without it the chain is a genesis record and nothing else.
  wc_ c1 --seconds 30 sync >/dev/null

  local c1 c2
  c1="$(wc_ c1 device | sed -n 's/^device=//p')"
  c2="$(wc_ c2 device | sed -n 's/^device=//p')"
  # A second authorizer, because a sole-authorizer workspace's destructive
  # actions carry a seven-day floor nothing can shorten (`media.md`) and a
  # same-day proof of it would be a proof of the wrong thing.
  wc_ c1 authorizers --device "$c2" >> "$out"

  {
    echo
    echo "## The checkpoint"
    echo
  } >> "$out"
  wc_ c1 checkpoint >> "$out"
  wc_ c1 --seconds 30 sync >/dev/null

  # Measured after the checkpoint reaches the relay, because the checkpoint and
  # its snapshot are two more envelopes and a baseline taken before them would
  # make the drop look like it reclaimed two fewer than it did.
  # What the other client's audit says before any of this. Captured because the
  # invariant that matters is that compaction adds nothing to it: this harness's
  # second client joins a `closed` group by external commit at epoch one and
  # holds no content key for epoch zero, so it already reports one alarm per
  # envelope it cannot open. That is the history-key gap `channels.md` closes for
  # `open` groups and it has nothing to do with dropping anything. Reading the
  # number without this baseline would make a pre-existing condition look like
  # damage this scenario caused.
  local alarms_before
  alarms_before="$(field "$(wc_ c2 audit)" alarms)"

  local before before_bytes
  before="$(relay_psql "select count(*) from relay_envelope e join relay_group g on g.group_id = e.group_id where g.workspace_id = '$ws'" | tr -d '[:space:]')"
  before_bytes="$(relay_psql "select coalesce(sum(octet_length(ct)),0) from relay_envelope e join relay_group g on g.group_id = e.group_id where g.workspace_id = '$ws'" | tr -d '[:space:]')"
  {
    echo
    echo "## Before the drop"
    echo
    echo "envelopes $before"
    echo "bytes     $before_bytes"
  } >> "$out"

  local not_before; not_before=$(( $(date +%s) - 60 ))
  local approval
  approval="$(wc_ c2 policy-approve --device "$c1" --device "$c2" --id 1 --seconds "$not_before"     | sed -n 's/^sig=//p')"
  [ -n "$approval" ] || scenario_fail "the second authorizer did not sign the policy"

  # The negative first, and on the same live workspace: a `drop_before` whose
  # manifest names a snapshot the relay is not holding must refuse, and must
  # leave every envelope where it was. Proven before the accepting run so a
  # refusal cannot be mistaken for "there was nothing left to drop".
  local refused
  refused="$(wc_ c1 compact --id 1 --seconds "$not_before" --title "$c2:$approval"     --body missing-snapshot 2>&1 || true)"
  {
    echo
    echo "## The negative: a manifest that fails verification"
    echo
    echo "$refused" | sed 's/^/  /'
  } >> "$out"
  case "$refused" in
    *incomplete_manifest*) : ;;
    *) scenario_fail "a drop naming a snapshot the relay does not hold was not refused: $refused" ;;
  esac
  local after_refusal
  after_refusal="$(relay_psql "select count(*) from relay_envelope e join relay_group g on g.group_id = e.group_id where g.workspace_id = '$ws'" | tr -d '[:space:]')"
  [ "$after_refusal" = "$before" ] ||     scenario_fail "a refused drop changed the log: $before then $after_refusal"

  {
    echo
    echo "## The drop"
    echo
  } >> "$out"
  wc_ c1 compact --id 1 --seconds "$not_before" --title "$c2:$approval" >> "$out"

  local after after_bytes anchors runs
  after="$(relay_psql "select count(*) from relay_envelope e join relay_group g on g.group_id = e.group_id where g.workspace_id = '$ws'" | tr -d '[:space:]')"
  after_bytes="$(relay_psql "select coalesce(sum(octet_length(ct)),0) from relay_envelope e join relay_group g on g.group_id = e.group_id where g.workspace_id = '$ws'" | tr -d '[:space:]')"
  anchors="$(relay_psql "select count(*) from relay_checkpoint_anchor a join relay_group g on g.group_id = a.group_id where g.workspace_id = '$ws'" | tr -d '[:space:]')"
  runs="$(relay_psql "select barrier_seq || ' ' || deleted_count || ' ' || deleted_bytes || ' ' || kept_count from relay_drop_run r join relay_group g on g.group_id = r.group_id where g.workspace_id = '$ws'")"

  {
    echo
    echo "## After, read from the relay's own tables"
    echo
    echo "envelopes $after (was $before)"
    echo "bytes     $after_bytes (was $before_bytes)"
    echo "anchors   $anchors"
    echo
    echo "## The run log: barrier, deleted, bytes, kept"
    echo
    echo "$runs" | sed 's/^/  /'
  } >> "$out"

  [ "${after:-0}" -lt "${before:-0}" ] ||     scenario_fail "the compaction reclaimed nothing: $before then $after"
  [ "${after_bytes:-0}" -lt "${before_bytes:-0}" ] ||     scenario_fail "the compaction reclaimed no bytes"
  # What is left is exactly what a checkpoint anchors: the manifest and its
  # snapshot. Anything else surviving would mean the barrier was too low, and
  # anything fewer would mean an anchor was collected.
  [ "${anchors:-0}" = "2" ] || scenario_fail "expected 2 anchors, got $anchors"
  [ "${after:-0}" = "2" ] ||     scenario_fail "expected the checkpoint and its snapshot to survive, $after envelopes did"
  [ -n "$runs" ] || scenario_fail "the compaction left no run-log row"

  # And every remaining client still converges. The one that did not issue the
  # drop reconciles against a relay whose log is now mostly gone, which is the
  # case the whole checkpoint mechanism exists to make safe.
  wc_ c2 --seconds 30 sync >> "$out"
  local state; state="$(scenario_state c2)"
  {
    echo
    echo "## The other client, after the drop"
    echo
    echo "$state"
  } >> "$out"
  [ "$(field "$state" chat)" = "5" ] ||     scenario_fail "the remaining client lost history it had already read; see $out"

  # And compaction raised no alarm of its own. The count is the wrong thing to
  # assert and asserting it was a mistake worth recording: this harness's joiner
  # already reports one alarm per envelope it cannot open, because a `closed`
  # group publishes no history key and a device that joined at epoch one holds no
  # content key for epoch zero. Its count therefore rises whenever it receives
  # anything, including the checkpoint and snapshot this scenario just published,
  # and a count comparison would fail for a reason that has nothing to do with
  # dropping history.
  #
  # What is worth asserting is the class. Every alarm has to be that same
  # content-key gap, and none may be a fork or a gap in an author chain: an alarm
  # that appeared because history was compacted would be the exact failure the
  # checkpoint exists to prevent, which is compaction and tamper detection being
  # mutually exclusive.
  local audit_after alarms_after records_after
  audit_after="$(wc_ c2 audit)"
  alarms_after="$(field "$audit_after" alarms)"
  records_after="$(field "$audit_after" records)"
  {
    echo
    echo "## Alarms on the other client"
    echo
    echo "$audit_after"
    echo
    echo "before the drop: $alarms_before"
    echo
    echo "Every one is the epoch-zero content-key gap this harness's joiner"
    echo "already has, one per envelope it holds and cannot open. None is a fork"
    echo "or a chain gap, which is what compaction could have caused and did not."
  } >> "$out"
  [ "${alarms_after:-0}" = "${records_after:-0}" ] || \
    scenario_fail "an alarm that is not the content-key gap: $alarms_after over $records_after records; see $out"
  case "$audit_after" in
    *"no content key"*) : ;;
    *) scenario_fail "the remaining client raised an alarm compaction has to answer for; see $out" ;;
  esac


  echo "COMPACTED $before to $after envelopes, $before_bytes to $after_bytes bytes" | tee -a "$out"
}

# One bound workspace, with its own instances, remote, id and transport.
#
# Sets the three globals `cmd_clients` works from, so a second call is a second
# workspace and not a second view of the first.
TWO_WORKSPACES_BOUND=0

two_workspaces_bind() {
  local name="$1" selections="$2"
  local home="$STACK_STATE/ws-$name"
  CLIENTS_DIR="$home/clients"
  REMOTE_REPO="$home/remote.git"
  WEALD_WORKSPACE_ID="weald-$name"
  mkdir -p "$home"
  # A workspace with a socket gets its own relay, on its own port, with its own
  # genesis key. One relay serves one workspace (`serve.rs`, `bootstrap_workspace`)
  # and mints one single-use genesis key for it, so two workspaces sharing one relay
  # means the second one cannot be founded at all: WEALD-L304. A workspace entirely
  # on git needs no relay and stays on the harness's own.
  case ",$selections," in
    *,relay,*|*,dual,*)
      TWO_WORKSPACES_BOUND=$((TWO_WORKSPACES_BOUND + 1))
      relay_use "$name" $(( 10 + 2 * TWO_WORKSPACES_BOUND ))
      # Stopped first, always. A relay left over from a run that failed inside the
      # suspended half is a relay still in `read_only`, and `relay_start` adopts a
      # process that answers, so every write below would be refused for last run's
      # reason.
      relay_stop
      relay_start || scenario_fail "the $name workspace's relay did not start"
      ;;
    *) relay_use "" ;;
  esac
  cmd_clients 2 --selections "$selections" --fresh >/dev/null
}

# Stop every relay a bound workspace started, and go back to the harness's own.
two_workspaces_release() {
  local name
  for name in "$@"; do
    relay_use "$name" 0
    relay_stop
  done
  relay_use ""
}

# Drive one instance of one bound workspace. The clients directory is passed in the
# environment rather than guessed, which is what keeps two workspaces on one machine
# from reading each other's instances.
two_workspaces_client() {
  local home="$1"; shift
  WEALD_CLIENTS_DIR="$STACK_STATE/ws-$home/clients" "$ROOT/scripts/weald-client" "$@"
}

# The group ids a bound workspace uses, one per line.
two_workspaces_groups() {
  local home="$1"
  two_workspaces_client "$home" c1 groups | awk '{print $1}' | sort
}

scenario_two_workspaces() {
  local out="$STEP22_OUT/two-workspaces.txt"
  mkdir -p "$STEP22_OUT"
  local alpha_dir="$STACK_STATE/ws-alpha/clients"
  local bravo_dir="$STACK_STATE/ws-bravo/clients"

  two_workspaces_bind alpha relay,relay
  two_workspaces_bind bravo git,git
  local alpha_id bravo_id
  alpha_id="$(cat "$alpha_dir/workspace-id")"
  bravo_id="$(cat "$bravo_dir/workspace-id")"
  [ "$alpha_id" != "$bravo_id" ] || scenario_fail "two workspaces were bound under one id"

  {
    echo "# Two workspaces bound on one machine, on two transports, at once"
    echo
    echo "alpha  $alpha_id  relay  $(relay_ws_url)"
    echo "bravo  $bravo_id  git    $STACK_STATE/ws-bravo/remote.git"
    echo
  } > "$out"

  # Each workspace authors into itself, and then each one is driven over its own
  # transport, at the same time, as its own process.
  two_workspaces_client alpha c1 send "alpha, over the relay" >/dev/null
  two_workspaces_client bravo c1 send "bravo, over git" >/dev/null

  local alpha_started bravo_started alpha_ended bravo_ended
  alpha_started="$(now_ms)"; bravo_started="$(now_ms)"
  (
    two_workspaces_client alpha c1 --seconds 30 sync >/dev/null
    two_workspaces_client alpha c2 --seconds 30 sync >/dev/null
    now_ms > "$STACK_STATE/ws-alpha/ended"
  ) &
  local alpha_job=$!
  (
    two_workspaces_client bravo c1 push
    two_workspaces_client bravo c2 pull
    now_ms > "$STACK_STATE/ws-bravo/ended"
  ) &
  local bravo_job=$!
  wait "$alpha_job" || scenario_fail "the relay workspace did not complete its round"
  wait "$bravo_job" || scenario_fail "the git workspace did not complete its round"
  alpha_ended="$(cat "$STACK_STATE/ws-alpha/ended")"
  bravo_ended="$(cat "$STACK_STATE/ws-bravo/ended")"
  # Overlap, in both directions: each round began before the other had finished.
  [ "$alpha_started" -lt "$bravo_ended" ] && [ "$bravo_started" -lt "$alpha_ended" ] || \
    scenario_fail "the two workspaces were not live at the same time"

  local alpha_state bravo_state
  alpha_state="$(WEALD_CLIENTS_DIR="$alpha_dir" "$ROOT/scripts/weald-client" c2 state)"
  bravo_state="$(WEALD_CLIENTS_DIR="$bravo_dir" "$ROOT/scripts/weald-client" c2 state)"
  {
    echo "## Both live, measured"
    echo
    echo "alpha  ${alpha_started}ms to ${alpha_ended}ms, over the socket"
    echo "bravo  ${bravo_started}ms to ${bravo_ended}ms, over the remote"
    echo
    echo "## What each workspace's second instance holds"
    echo
    printf '%s\n\n%s\n\n' "$alpha_state" "$bravo_state"
  } >> "$out"

  # Each peer received its own workspace's message and only its own. One record
  # apiece is the whole no-crossing claim stated as a number: a second record in
  # either workspace is the other workspace's message, whatever route it took.
  [ "$(field "$alpha_state" chat)" = "1" ] || \
    scenario_fail "the relay workspace holds $(field "$alpha_state" chat) records, not its own one"
  [ "$(field "$bravo_state" chat)" = "1" ] || \
    scenario_fail "the git workspace holds $(field "$bravo_state" chat) records, not its own one"
  [ "$(field "$alpha_state" digest)" != "$(field "$bravo_state" digest)" ] || \
    scenario_fail "two workspaces converged on one state, which is one workspace"

  # No key crossing, item by item.
  local shared_groups
  shared_groups="$(comm -12 <(two_workspaces_groups alpha) <(two_workspaces_groups bravo) | wc -l | tr -d ' ')"
  [ "$shared_groups" = "0" ] || scenario_fail "$shared_groups group ids are shared between workspaces"
  ! cmp -s "$alpha_dir/bootstrap-secret" "$bravo_dir/bootstrap-secret" || \
    scenario_fail "both workspaces were sealed under one bootstrap secret"
  local instance
  for instance in c1 c2; do
    ! cmp -s "$alpha_dir/$instance/.weald-instance/device.key" \
             "$bravo_dir/$instance/.weald-instance/device.key" 2>/dev/null || \
      scenario_fail "$instance holds one device key in both workspaces"
  done

  # And the transport each one is bound to, read back from the file the switch owns.
  local alpha_transport bravo_transport
  alpha_transport="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("relay",{}).get("transport",""))' "$alpha_dir/c1/.weald/project.json")"
  bravo_transport="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("relay",{}).get("transport",""))' "$bravo_dir/c1/.weald/project.json")"
  [ "$alpha_transport" = "relay" ] || scenario_fail "the relay workspace is bound to $alpha_transport"
  [ "$bravo_transport" = "git" ] || scenario_fail "the git workspace is bound to $bravo_transport"

  # The relay's own answer. The git workspace never opened a socket, so the relay
  # holds no envelope and no key package under its id: a workspace on git leaves
  # nothing of itself on a relay, and nothing of the other workspace is filed under
  # it either.
  #
  # Its groups do have rows, and that is provisioning rather than traffic: the
  # harness registers a workspace's groups the way the control plane will
  # (`clients_register_groups`), for every workspace regardless of transport. What
  # the rows have to be is disjoint, which is asserted above by group id, and empty,
  # which is asserted below by envelope count.
  local alpha_envelopes bravo_envelopes bravo_groups bravo_packages
  alpha_envelopes="$(relay_psql "select count(*) from relay_envelope e join relay_group g on g.group_id = e.group_id where g.workspace_id = '$alpha_id'" | tr -d '[:space:]')"
  bravo_envelopes="$(relay_psql "select count(*) from relay_envelope e join relay_group g on g.group_id = e.group_id where g.workspace_id = '$bravo_id'" | tr -d '[:space:]')"
  bravo_groups="$(relay_psql "select count(*) from relay_group where workspace_id = '$bravo_id'" | tr -d '[:space:]')"
  bravo_packages="$(relay_psql "select count(*) from relay_key_package where workspace_id = '$bravo_id'" | tr -d '[:space:]')"
  {
    echo "## The relay's database, per workspace"
    echo
    echo "alpha envelopes  $alpha_envelopes"
    echo "bravo envelopes  $bravo_envelopes"
    echo "bravo groups     $bravo_groups (provisioned, never written to)"
    echo "bravo key packages $bravo_packages"
    echo
    echo "alpha groups"
    two_workspaces_groups alpha | sed 's/^/  /'
    echo "bravo groups"
    two_workspaces_groups bravo | sed 's/^/  /'
    echo
    echo "alpha project.json"
    sed 's/^/  /' "$alpha_dir/c1/.weald/project.json"
    echo
    echo "bravo project.json"
    sed 's/^/  /' "$bravo_dir/c1/.weald/project.json"
  } >> "$out"
  [ "${alpha_envelopes:-0}" -ge 1 ] || scenario_fail "the relay workspace published nothing over the socket"
  [ "${bravo_envelopes:-0}" = "0" ] || scenario_fail "the git workspace reached the relay: $bravo_envelopes envelopes"
  [ "${bravo_packages:-0}" = "0" ] || scenario_fail "the git workspace left $bravo_packages key packages with the relay"

  two_workspaces_release alpha

  echo "TWO WORKSPACES LIVE, no crossing: alpha $alpha_id on the relay, bravo $bravo_id on git" \
    | tee -a "$out"
}

# --- step 24: two workspaces, two devices, four combinations -----------------
#
# Step 22 proved two workspaces can be live at once. This proves the case a person
# actually has: one person, two Macs, and more than one customer. Two workspaces
# times two devices is four `<device, workspace>` pairs, and the gate in
# phases-app.md asks for all four converging. Convergence has to be *inside* each
# workspace and nowhere across, which is why the digests are compared in both
# directions: equal within a workspace, different between them.
#
# The second half is the lapsed subscription. `WEALD_RELAY_WRITE_MODE=read_only` is
# the relay's own vendor-neutral maintenance mode, which is exactly what a suspended
# instance runs in (`specs/backend/cloud/billing.md`, day 14: reads and export
# continue, writes are refused). The relay is restarted into it here rather than
# faked, because the claim being proved is what a real refusal does to a real client:
# the record settles in the working tree, the other device still receives it, and
# nothing about the app becomes unlicensed.
two_devices_state() {
  local home="$1" instance="$2"
  WEALD_CLIENTS_DIR="$STACK_STATE/ws-$home/clients" "$ROOT/scripts/weald-client" "$instance" state
}

two_devices_relay_envelopes() {
  relay_psql "select count(*) from relay_envelope e join relay_group g on g.group_id = e.group_id \
              where g.workspace_id = '$1'" | tr -d '[:space:]'
}

scenario_two_devices() {
  local out="$STEP24_OUT/two-workspaces-two-devices.txt"
  mkdir -p "$STEP24_OUT"

  # Each bound workspace's relay is stopped and started by `two_workspaces_bind`,
  # so a run that failed inside the suspended half below cannot leave a relay in
  # `read_only` for the next run to be refused by.
  two_workspaces_bind alpha relay,relay
  two_workspaces_bind delta dual,dual
  local alpha_id delta_id
  alpha_id="$(cat "$STACK_STATE/ws-alpha/clients/workspace-id")"
  delta_id="$(cat "$STACK_STATE/ws-delta/clients/workspace-id")"
  [ "$alpha_id" != "$delta_id" ] || scenario_fail "two workspaces were bound under one id"

  # The four combinations, each device writing into its own workspace and each round
  # alternating, the way `scenario_catchup` alternates: one instance founds the
  # groups on its first round and the other joins on its next, so a device is never
  # asked to found a group a sibling process is founding at the same moment. The
  # third round is what carries the second device's own records back to the first.
  local home instance alpha_round delta_round
  for home in alpha delta; do
    two_workspaces_client "$home" c1 send "c1 in $home" >/dev/null
    two_workspaces_client "$home" c1 --seconds 30 sync >/dev/null
    two_workspaces_client "$home" c2 send "c2 in $home" >/dev/null
    two_workspaces_client "$home" c2 --seconds 30 sync >/dev/null
    two_workspaces_client "$home" c1 --seconds 30 sync >/dev/null
    # The last round is kept, not discarded. Its `alarms` field is the answer to
    # "did this workspace's own log verify before anything was suspended", and a
    # later alarm count means nothing without it.
    if [ "$home" = alpha ]; then
      alpha_round="$(two_workspaces_client "$home" c2 --seconds 30 sync 2>/dev/null)"
    else
      delta_round="$(two_workspaces_client "$home" c2 --seconds 30 sync 2>/dev/null)"
    fi
  done

  # The dual workspace moves on both tiers, which is the point of binding it dual:
  # its git half is what solo mode falls back to below.
  for instance in c1 c2; do
    two_workspaces_client delta "$instance" push
  done
  for instance in c1 c2; do
    two_workspaces_client delta "$instance" pull
  done

  local a1 a2 d1 d2
  a1="$(two_devices_state alpha c1)"; a2="$(two_devices_state alpha c2)"
  d1="$(two_devices_state delta c1)"; d2="$(two_devices_state delta c2)"
  {
    echo "# Two workspaces, two devices for one person, four combinations"
    echo
    echo "alpha  $alpha_id  relay"
    echo "delta  $delta_id  dual"
    echo
    printf 'alpha c1  %s\nalpha c2  %s\ndelta c1  %s\ndelta c2  %s\n\n' "$a1" "$a2" "$d1" "$d2"
    echo "## The last round of each, before anything was suspended"
    echo
    printf 'alpha  %s\n\ndelta  %s\n\n' "$alpha_round" "$delta_round"
    echo "Both rounds carry alarms, and they predate everything below, which is why"
    echo "they are printed here rather than left to be discovered under the suspended"
    echo "relay. \`audit\` names them: \"no content key for group ... at epoch 0\". A"
    echo "second device joins at epoch 1 and holds no key for the epoch its sibling"
    echo "wrote in, so it receives the record and cannot read it. That is the history"
    echo "key path (\`specs/backend/relay/groups.md\`), which belongs to step 8 and the"
    echo "verification surfaces in step 12, not to this step: what step 24 asserts is"
    echo "that the four combinations converge on one state per workspace and on no"
    echo "state across them, and the digests above are that assertion. Recorded as an"
    echo "open item rather than absorbed."
    echo
  } > "$out"

  # Convergence inside each workspace: both devices hold both messages and agree.
  local combination
  for combination in "alpha c1 $a1" "alpha c2 $a2" "delta c1 $d1" "delta c2 $d2"; do
    set -- $combination
    local state; state="$(two_devices_state "$1" "$2")"
    [ "$(field "$state" chat)" = "2" ] || \
      scenario_fail "$1 $2 holds $(field "$state" chat) records, not the two its workspace wrote"
  done
  [ "$(field "$a1" digest)" = "$(field "$a2" digest)" ] || \
    scenario_fail "the two devices in alpha did not converge"
  [ "$(field "$d1" digest)" = "$(field "$d2" digest)" ] || \
    scenario_fail "the two devices in delta did not converge"
  # And no convergence across them, which is the same assertion read the other way.
  [ "$(field "$a1" digest)" != "$(field "$d1" digest)" ] || \
    scenario_fail "two workspaces converged on one state, which is one workspace"

  # A device is <device, workspace>: the same instance name in two workspaces is two
  # unrelated keys, so two customers cannot tell they share a contractor.
  for instance in c1 c2; do
    ! cmp -s "$STACK_STATE/ws-alpha/clients/$instance/.weald-instance/device.key" \
             "$STACK_STATE/ws-delta/clients/$instance/.weald-instance/device.key" 2>/dev/null || \
      scenario_fail "$instance holds one device key in both workspaces"
  done
  local shared_groups
  shared_groups="$(comm -12 <(two_workspaces_groups alpha) <(two_workspaces_groups delta) | wc -l | tr -d ' ')"
  [ "$shared_groups" = "0" ] || scenario_fail "$shared_groups group ids are shared between workspaces"

  # --- the lapsed subscription ---------------------------------------------
  local before after
  before="$(two_devices_relay_envelopes "$delta_id")"
  relay_stop
  WEALD_STACK_WRITE_MODE=read_only relay_start || scenario_fail "the relay did not restart read-only"
  # The relay's own statement about itself, machine readable, from the endpoint an
  # operator reads. Asserted rather than assumed, because everything below is only
  # interesting if the relay really is in the mode a suspended instance runs in.
  local readyz
  readyz="$(curl -s -H "Authorization: Bearer $(relay_operator_token)" \
    "http://127.0.0.1:$RELAY_OBSERVABILITY_PORT/readyz")"
  case "$readyz" in
    *'"write_mode":"read_only"'*'"write_mode_reason":"service_read_only"'*) ;;
    *) scenario_fail "the relay did not report read_only/service_read_only: $readyz" ;;
  esac

  two_workspaces_client delta c1 send "written while the relay was suspended" >/dev/null
  local suspended_round
  suspended_round="$(two_workspaces_client delta c1 --seconds 15 sync 2>/dev/null || true)"
  [ "$(field "$suspended_round" readonly)" = "yes" ] || \
    scenario_fail "the client did not notice the relay was read-only: $suspended_round"
  [ "$(field "$suspended_round" connected)" = "yes" ] || \
    scenario_fail "a suspended relay dropped the client instead of serving reads"
  after="$(two_devices_relay_envelopes "$delta_id")"
  [ "$after" = "$before" ] || \
    scenario_fail "a read-only relay accepted $((after - before)) envelopes"

  # Solo mode, stated as the two facts that matter: the record is not lost, and the
  # other device still gets it. Over the working tree, with the relay refusing.
  local suspended; suspended="$(two_devices_state delta c1)"
  [ "$(field "$suspended" chat)" = "3" ] || \
    scenario_fail "the suspended workspace lost the line it wrote: $(field "$suspended" chat)"
  two_workspaces_client delta c1 push
  two_workspaces_client delta c2 pull
  local peer; peer="$(two_devices_state delta c2)"
  [ "$(field "$peer" chat)" = "3" ] || \
    scenario_fail "the second device did not receive over the working tree: $(field "$peer" chat)"

  relay_stop
  relay_start || scenario_fail "the relay did not come back in full write mode"
  two_workspaces_client delta c1 --seconds 30 sync >/dev/null
  local restored; restored="$(two_devices_relay_envelopes "$delta_id")"
  [ "$restored" -gt "$before" ] || \
    scenario_fail "the workspace did not resume writing once the relay was writable"

  {
    echo "## The lapsed subscription, against a relay in read_only"
    echo
    echo "relay envelopes before   $before"
    echo "relay envelopes while suspended  $after (refused, service_read_only)"
    echo "the client's own round while suspended  $suspended_round"
    echo "relay envelopes after restore    $restored"
    echo
    echo "delta c1 while suspended  $suspended"
    echo "delta c2 after a working-tree round  $peer"
    echo
    echo "The client kept the record, the second device received it over the working"
    echo "tree, and nothing about the app became unlicensed."
  } >> "$out"

  # Both workspaces' relays stopped, and the harness's own relay is the one this
  # process leaves behind, so the next command in the session drives what it expects.
  two_workspaces_release alpha delta

  echo "FOUR COMBINATIONS CONVERGED, and a suspended relay degraded to solo mode" \
    | tee -a "$out"
}

# A workspace id the Swift suite can use, with its groups already registered.
#
# The suite cannot provision a group itself: provisioning is a database write the
# control plane owns and a test that reached into Postgres would be a test that had
# to know the relay's schema. So the harness mints an id, registers its groups, and
# writes the pair where the suite can find it. A run with no harness finds no file
# and skips, which the gate then catches, because `xcresult-require.py` demands the
# named test *passed* and a skip is not a pass.
cmd_register() {
  local fresh=0 id="${WEALD_WORKSPACE_ID}-suite"
  while [ $# -gt 0 ]; do
    case "$1" in
      --fresh) fresh=1; shift ;;
      --id) id="$2"; shift 2 ;;
      *) echo "weald-stack register: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || { echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2; exit 1; }
  client_build
  local bin; bin="$(client_binary)"
  [ "$fresh" -eq 1 ] && id="${id}-$(date +%s)"

  mkdir -p "$STACK_STATE"
  local scratch
  scratch="$(mktemp -d -t weald-register.XXXXXX)"
  "$bin" relay-client --workspace "$scratch" --workspace-id "$id" init >/dev/null
  WEALD_WORKSPACE_ID="$id" clients_register_groups "$bin" "$scratch"
  rm -rf "$scratch"

  {
    echo "WEALD_RELAY_URL=$(relay_ws_url)"
    echo "WEALD_SUITE_WORKSPACE=$id"
  } > "$STACK_STATE/suite.env"
  echo
  echo "wrote $STACK_STATE/suite.env"
  cat "$STACK_STATE/suite.env"
}

# The demo: a workspace the real Mac app opens, with teammates already in it.
#
# Everything above proves the transport against processes. This proves it against
# the product, which is a different claim and the one a person can see: the app's
# own chat panel, showing messages that arrived over a socket from somebody else,
# beside an indicator that says which transport carried them and that they are not
# encrypted yet.
#
# The workspace is a real directory under the scan root and is registered with the
# app the way the Import button registers one, so nothing here is a special path the
# shipped build would not take.
DEMO_DIR="${WEALD_DEMO_DIR:-$HOME/dev/weald-relay-demo}"
DEMO_BUNDLE_ID="com.dicyanin.weald.app"

cmd_demo() {
  local peers=2 seed=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --peers) peers="$2"; shift 2 ;;
      --no-seed) seed=0; shift ;;
      --dir) DEMO_DIR="$2"; shift 2 ;;
      *) echo "weald-stack demo: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || cmd_up --budget 180
  client_build
  local bin; bin="$(client_binary)"

  local workspace_id="weald-demo"
  mkdir -p "$DEMO_DIR"
  [ -d "$DEMO_DIR/.git" ] || git init --quiet --initial-branch=main "$DEMO_DIR"
  if [ ! -f "$DEMO_DIR/.gitignore" ]; then
    printf '.weald-instance/\n.weald/relay/\n' > "$DEMO_DIR/.gitignore"
  fi
  # The app's own workspace, on both transports. Dual rather than relay-only so the
  # demo shows the migration's actual shape and so the tree stays readable.
  "$bin" relay-client --workspace "$DEMO_DIR" --workspace-id "$workspace_id" \
    --handle "$(whoami)" --selection dual --relay "$(relay_ws_url)" init >/dev/null
  WEALD_WORKSPACE_ID="$workspace_id" clients_register_groups "$bin" "$DEMO_DIR"

  # Registered with the app exactly as the Import button registers one.
  python3 - "$DEMO_DIR" "$DEMO_BUNDLE_ID" <<'PY'
import subprocess, sys
path, bundle = sys.argv[1], sys.argv[2]
key = "weald.importedProjectPaths"
try:
    current = subprocess.run(
        ["defaults", "read", bundle, key],
        capture_output=True, text=True, check=True,
    ).stdout
except subprocess.CalledProcessError:
    current = ""
if path in current:
    print("already imported %s" % path)
else:
    subprocess.run(["defaults", "write", bundle, key, "-array-add", path], check=True)
    print("imported %s" % path)
PY

  # The teammates. Separate processes with separate device keys, which is what makes
  # what the app receives genuinely somebody else's.
  local i
  for (( i = 1; i <= peers; i++ )); do
    local name="peer$i"
    local dir="$CLIENTS_DIR/$name"
    mkdir -p "$dir"
    "$bin" relay-client --workspace "$dir" --workspace-id "$workspace_id" \
      --handle "$name" --machine "$name" --selection relay \
      --relay "$(relay_ws_url)" init >/dev/null
    mkdir -p "$dir/.weald-instance"
    echo relay > "$dir/.weald-instance/selection"
    note "peer" "$name, $dir"
  done
  echo "$workspace_id" > "$CLIENTS_DIR/workspace-id"

  if [ "$seed" -eq 1 ]; then
    for (( i = 1; i <= peers; i++ )); do
      local name="peer$i"
      "$ROOT/scripts/weald-client" "$name" send "hello from $name, over the relay" >/dev/null
      "$ROOT/scripts/weald-client" "$name" ticket --id "DEMO-$i" \
        --title "written by $name on another machine" \
        --body "This ticket reached your board over the relay, not over git." >/dev/null
      "$ROOT/scripts/weald-client" "$name" --seconds 30 sync >/dev/null
    done
  fi

  echo
  echo "demo workspace  $DEMO_DIR"
  echo "relay           $(relay_ws_url)"
  echo "peers           $peers, in $CLIENTS_DIR"
  echo
  echo "Open Weald. The workspace appears in the sidebar, its chat holds the peers'"
  echo "messages and its board holds their tickets. Settings shows the transport and"
  echo "says content is not encrypted yet."
  echo
  echo "Send more from a teammate with:"
  echo "  scripts/weald-client peer1 send 'and another' && scripts/weald-client peer1 sync"
}

# --- the self-hosted genesis proof -------------------------------------------
#
# WEALD-L304's acceptance, whole: from a fresh relay's first-run banner alone, enrol
# a founder, send a message the relay accepts, issue an invite, redeem it on a second
# device, and read the founder's message there. At the shipped posture, which is what
# makes it a proof: `min_enc=mls`, so an envelope from a workspace with no sealing
# group is refused, and `access_set=enforce`, so a device the set does not name is
# refused before it can write.
#
# Its own relay on its own port, because it consumes a genesis key and a relay has
# exactly one.
GENESIS_OUT="${WEALD_GENESIS_OUT:-$ROOT/build-evidence/genesis}"

scenario_genesis_founder() {
  local out="$GENESIS_OUT/self-hosted-genesis.txt"
  mkdir -p "$GENESIS_OUT"
  client_build
  local bin; bin="$(client_binary)"

  relay_use founder 30
  relay_stop
  relay_start || scenario_fail "the founder relay did not start"
  local home="$STACK_STATE/ws-founder"
  rm -rf "$home"
  mkdir -p "$home"
  CLIENTS_DIR="$home/clients"
  mkdir -p "$CLIENTS_DIR"

  # A fresh banner: the previous run's genesis key and access set go, and so do the
  # workspace's groups and envelopes, because this workspace is founded again under
  # the same id and a stale envelope would be counted as this run's.
  relay_workspace_wipe
  cmd_enrol --reset --into "$CLIENTS_DIR/f1" --handle f1 --machine f1 || \
    scenario_fail "the founder could not enrol from the banner"

  local floor
  floor="$(grep -o '"min_enc":"[a-z]*"' "$RELAY_LOG_FILE" | tail -1)"
  [ "$floor" = '"min_enc":"mls"' ] || \
    scenario_fail "this proof needs a relay at the shipped floor, not $floor"

  local f1=(--workspace "$CLIENTS_DIR/f1" --workspace-id "$ENROLLED_WORKSPACE"
            --handle f1 --machine f1 --selection relay --relay "$(relay_ws_url)")

  # One message, and the relay's own answer to it. `sync` reports the session, so a
  # refusal at the floor is a field and not an inference.
  "$bin" relay-client "${f1[@]}" send "the founder can seal" >/dev/null
  local round
  round="$("$bin" relay-client "${f1[@]}" --seconds 20 sync 2>&1)"
  [ "$(field "$round" connected)" = "yes" ] || \
    scenario_fail "the founder's session was refused: $round"
  local envelopes
  envelopes="$(relay_psql "select count(*) from relay_envelope e \
      join relay_group g on g.group_id = e.group_id \
      where g.workspace_id = '$ENROLLED_WORKSPACE'" | tr -d '[:space:]')"
  [ "${envelopes:-0}" -ge 1 ] || \
    scenario_fail "the relay holds no envelope from the founder: $round"

  # The invite, from a founder that holds the groups an invite admits somebody to.
  local issued link code unsealed
  issued="$("$bin" relay-client "${f1[@]}" invite --title "second device" 2>&1)" || \
    scenario_fail "the founder could not issue an invite: $issued"
  link="$(field "$issued" link)"
  code="$(field "$issued" code)"
  unsealed="$(field "$issued" unsealed)"
  [ -n "$link" ] && [ -n "$code" ] || scenario_fail "the invite printed no halves: $issued"
  [ -z "$unsealed" ] || \
    scenario_fail "the invite carries no bundle for $unsealed, so its bearer could not seal there"

  # The second device, which knows nothing but the two halves it was handed.
  local f2=(--workspace "$CLIENTS_DIR/f2" --workspace-id "$ENROLLED_WORKSPACE"
            --handle f2 --machine f2 --selection relay --relay "$(relay_ws_url)")
  mkdir -p "$CLIENTS_DIR/f2"
  "$bin" relay-client "${f2[@]}" init >/dev/null
  local redeemed
  redeemed="$("$bin" relay-client "${f2[@]}" redeem --link "$link" --code "$code" 2>&1)" || \
    scenario_fail "the second device could not redeem the invite: $redeemed"
  local joined
  joined="$(field "$redeemed" joined)"
  [ "${joined:-0}" -ge 1 ] || scenario_fail "the redemption joined no group: $redeemed"

  # And the founder's message, read on the second device.
  local second
  second="$("$bin" relay-client "${f2[@]}" --seconds 30 sync 2>&1)"
  local state; state="$("$bin" relay-client "${f2[@]}" state)"
  [ "$(field "$state" chat)" -ge 1 ] || \
    scenario_fail "the second device read none of the founder's records: $second"

  {
    echo "# A self-hosted relay's genesis invite founds a workspace with two members"
    echo
    echo "relay        $(relay_ws_url)  ($ENROLLED_WORKSPACE)"
    echo "posture      min_enc mls, access set enforce"
    echo "banner       $RELAY_LOG_FILE"
    echo
    echo "## The founder, from the banner alone"
    echo
    printf '%s\n\n' "$round"
    echo "relay envelopes  $envelopes"
    echo
    echo "## The invite it issued"
    echo
    printf '%s\n\n' "$issued"
    echo "## The second device"
    echo
    printf '%s\n\n%s\n\n%s\n' "$redeemed" "$second" "$state"
  } > "$out"

  relay_stop
  relay_use ""
  echo "GENESIS FOUNDER SEALED, INVITED, AND THE SECOND DEVICE READ IT" | tee -a "$out"
}

cmd_scenario() {
  local name="${1:-}"
  shift || true
  require_daemon
  relay_answers || { echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2; exit 1; }
  case "$name" in
    converge) scenario_converge ;;
    catchup) scenario_catchup ;;
    fork) scenario_fork ;;
    rollback) scenario_rollback ;;
    two-workspaces) scenario_two_workspaces ;;
    two-devices) scenario_two_devices ;;
    genesis-founder) scenario_genesis_founder ;;
    compaction) scenario_compaction ;;
    digest-mismatch) scenario_digest_mismatch ;;
    all)
      scenario_converge
      scenario_catchup
      scenario_fork
      scenario_rollback
      scenario_two_workspaces
      scenario_two_devices
      scenario_compaction
      scenario_genesis_founder
      ;;
    *)
      echo "weald-stack scenario NAME, one of: converge, catchup, fork, rollback, two-workspaces, two-devices, compaction, genesis-founder, all" >&2
      exit 64
      ;;
  esac
}

clients_stop() {
  [ -d "$CLIENTS_DIR" ] || return 0
  local pidfile pid
  for pidfile in "$CLIENTS_DIR"/*/instance.pid; do
    [ -f "$pidfile" ] || continue
    pid="$(cat "$pidfile" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
    rm -f "$pidfile"
  done
}

clients_status() {
  [ -d "$CLIENTS_DIR" ] || return 0
  local dir name pid state
  for dir in "$CLIENTS_DIR"/*/; do
    [ -d "$dir" ] || continue
    name="$(basename "$dir")"
    pid="$(cat "$dir/instance.pid" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      state="running, pid $pid"
    else
      state="stopped"
    fi
    note "client $name" "$(cat "$dir/.weald-instance/selection" 2>/dev/null || echo git), $state"
  done
}

# The cluster runs with fsync, synchronous_commit and full_page_writes all off,
# because the volume is disposable and fsync on a laptop is most of the 90 second
# cold-start budget. The price of that trade is real: kill the suite mid-write
# (a Ctrl-C, a harness timeout, an OrbStack restart) and redo can panic on a torn
# page, after which the container exits 1 on every start and every test in
# backend/weald-cloud fails with ECONNREFUSED 127.0.0.1:54032. Nothing in the
# volume outlives a run, so the answer is to notice and reinitialise rather than
# to make somebody read Postgres WAL logs to learn that their scratch databases
# are gone.
heal_postgres() {
  local cid state
  cid="$(dc ps -aq postgres 2>/dev/null || true)"
  [ -n "$cid" ] || return 0
  state="$(docker inspect -f '{{.State.Status}}' "$cid" 2>/dev/null || true)"
  [ "$state" = "exited" ] || return 0
  docker logs --tail 50 "$cid" 2>&1 |
    grep -qE 'PANIC|shutting down due to startup process failure' || return 0
  note "postgres" "unrecoverable cluster, reinitialising the disposable volume"
  dc rm -sf postgres >/dev/null 2>&1 || true
  docker volume rm weald-stack_postgres-data >/dev/null 2>&1 || true
}

wait_healthy() {
  local deadline=$((SECONDS + 120)) unhealthy
  while [ "$SECONDS" -lt "$deadline" ]; do
    unhealthy=""
    for svc in "${INFRA_SERVICES[@]}"; do
      local cid state
      cid="$(dc ps -q "$svc" 2>/dev/null || true)"
      if [ -z "$cid" ]; then unhealthy="$unhealthy $svc(absent)"; continue; fi
      state="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$cid" 2>/dev/null || echo unknown)"
      case "$state" in
        healthy|running) ;;
        *) unhealthy="$unhealthy $svc($state)" ;;
      esac
    done
    [ -z "$unhealthy" ] && return 0
    sleep 0.25
  done
  echo "weald-stack: not healthy after 120s:$unhealthy" >&2
  return 1
}

cmd_up() {
  local relay_only=0 budget=90
  while [ $# -gt 0 ]; do
    case "$1" in
      --relay) relay_only=1; shift ;;
      --budget) budget="$2"; shift 2 ;;
      *) echo "weald-stack up: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  mkdir -p "$STACK_STATE"

  local start elapsed
  start="$(now_ms)"
  echo "weald-stack up"

  # Real infrastructure. No credentials: every value in the compose file is a
  # local-only literal, which is what lets an auditor run this on arrival.
  heal_postgres
  dc up -d --wait --wait-timeout 120 "${INFRA_SERVICES[@]}" >/dev/null
  wait_healthy
  for svc in "${INFRA_SERVICES[@]}"; do note "$svc" "healthy"; done

  require_loopback_alias

  # The relay. Built from source, TLS off, loopback only.
  relay_start || true

  # Enrol the relay's own workspace if it has never been enrolled. A relay with a
  # genesis key nobody has redeemed is a relay nobody can join, and every artifact
  # that reads the transparency log would read an empty table. Skipped in one line
  # once it is done, because the key is destroyed at redemption and there is no
  # second one.
  if [ "$(genesis_state)" != "redeemed" ]; then
    cmd_enrol >/dev/null 2>&1 || note "enrolment" "not done; scripts/weald-stack enrol --reset"
  fi

  if [ "$relay_only" -eq 0 ]; then
    if [ -f "$ROOT/backend/weald-cloud/next.config.ts" ]; then
      note "weald-cloud" "next dev on 127.0.0.1:$WEALD_STACK_CLOUD_PORT"
    elif [ -f "$ROOT/backend/weald-cloud/src/boot/control-plane.ts" ]; then
      # Steps 14, 15 and 17 are green and there is a boot path, so the control
      # plane can be stood up and driven. What it does not have is an HTTP
      # surface, which is step 18: saying "no server yet" would understate it
      # and saying "serving" would overstate it.
      note "weald-cloud" "boots and drives via scripts/weald-dev. No HTTP surface (step 18)."
    else
      note "weald-cloud" "no boot path yet (step 14). Package builds and its coverage runs."
    fi
    if [ -f "$ROOT/Sources/Tools/RelayClient/main.swift" ]; then
      note "clients" "weald-stack clients N stands up N supervised instances"
    elif [ -d "$ROOT/Sources/Sync" ]; then
      note "clients" "seam present (step 1). Relay-backed instances arrive in step 5."
    else
      note "clients" "no transport seam yet (step 1)."
    fi
  fi

  elapsed=$(( ($(now_ms) - start) ))
  local seconds
  seconds="$(python3 -c "print(f'{$elapsed/1000:.1f}')")"
  echo
  echo "up in ${seconds}s (budget ${budget}s)"
  {
    echo "stack_up_seconds=$seconds"
    echo "budget_seconds=$budget"
    echo "measured=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "services=${INFRA_SERVICES[*]}"
  } > "$STACK_STATE/last-up.txt"

  if python3 -c "import sys; sys.exit(0 if $elapsed/1000 <= $budget else 1)"; then
    echo "WITHIN BUDGET"
  else
    echo "OVER BUDGET: cold start is a gate in step 0 and it degrades the moment nobody measures it." >&2
    exit 1
  fi
}

# The fixture workspace, generated deterministically from a seed. Tiered: the
# full shape in local-harness.md needs envelopes, epochs and encrypted media,
# which arrive in steps 2, 7 and 9, so the generator produces the tier the tree
# can produce and the tier is recorded beside the hash. A number measured on one
# tier is not comparable to a number measured on another, and the loop refuses to
# compare them.
cmd_fixture() {
  local tier=human seed=20260729 scale=1.0 out="$ROOT/.weald-fixture"
  while [ $# -gt 0 ]; do
    case "$1" in
      --tier) tier="$2"; shift 2 ;;
      --seed) seed="$2"; shift 2 ;;
      --scale) scale="$2"; shift 2 ;;
      --out) out="$2"; shift 2 ;;
      *) echo "weald-stack fixture: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  python3 "$ROOT/scripts/weald-fixture.py" --out "$out/$tier" --tier "$tier" \
    --seed "$seed" --scale "$scale" --force
  echo
  echo "Record it with:"
  echo "  scripts/backend-build.sh --fixture <hash> $seed"
}

cmd_status() {
  require_daemon
  echo "weald-stack status"
  dc ps --format 'table {{.Service}}\t{{.Status}}\t{{.Publishers}}' 2>/dev/null || true
  echo
  note "postgres" "postgres://weald:weald@127.0.0.1:$WEALD_STACK_PG_PORT/weald_relay_stack"
  note "minio" "http://127.0.0.1:$WEALD_STACK_MINIO_PORT (console $WEALD_STACK_MINIO_CONSOLE_PORT)"
  note "redis" "redis://127.0.0.1:$WEALD_STACK_REDIS_PORT"
  note "mailpit" "smtp 127.0.0.1:$WEALD_STACK_SMTP_PORT, ui http://127.0.0.1:$WEALD_STACK_MAILPIT_UI_PORT"
  if relay_answers; then
    note "wealdrelay" "$(relay_ws_url) (pid $(relay_pid 2>/dev/null || echo unknown))"
  else
    note "wealdrelay" "not serving. scripts/weald-stack up"
  fi
  clients_status
  if [ -f "$STACK_STATE/last-up.txt" ]; then
    echo
    cat "$STACK_STATE/last-up.txt"
  fi
}

cmd_down() {
  require_daemon
  local volumes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --volumes) volumes=1; shift ;;
      *) echo "weald-stack down: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  # The relay first. It holds connections to Postgres, and tearing the database
  # out from under a live process turns an orderly shutdown into a log full of
  # connection errors that mean nothing.
  relay_stop
  clients_stop
  if [ "$volumes" -eq 1 ]; then
    dc down --volumes --remove-orphans
    rm -rf "$STACK_STATE/blobs" "$STACK_STATE/clients"
  else
    dc down --remove-orphans
  fi
}

# weald-stack kill client --at POINT
#
# A real process death at a named point in the write transaction, and a second
# process that comes back to look at what the first one left. The suite's crash
# matrix injects a throw and asserts in one process, which is the only way one
# process can do both; this is the other half of the same proof, where the writer
# actually dies by SIGKILL and never runs another line.
#
# `relay` is accepted as a target name and refused until step 3: there is no relay
# process to kill yet, and reporting that is more useful than killing something
# else and calling it the relay.
cmd_kill() {
  local target="${1:-client}"
  shift || true
  local point=""
  local workspace=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --at) point="$2"; shift 2 ;;
      --workspace) workspace="$2"; shift 2 ;;
      *) echo "weald-stack kill: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  case "$target" in
    client) ;;
    relay) not_yet "killing the relay process" "3, with the relay binary" ;;
    *) echo "weald-stack kill: unknown target: $target (client, relay)" >&2; exit 64 ;;
  esac
  local points="beforeReserve afterReserve duringAppend afterAppend"
  if [ -z "$point" ]; then
    echo "weald-stack kill client --at POINT, one of: $points" >&2
    exit 64
  fi
  local cleanup=0
  if [ -z "$workspace" ]; then
    workspace="$(mktemp -d -t weald-kill.XXXXXX)"
    cleanup=1
  fi

  echo "kill client --at $point"
  echo "workspace $workspace"
  echo
  # The writer. Expected to die by signal, so its exit status is checked for
  # exactly that: an orderly exit here would mean the kill did not happen and the
  # proof would be of nothing.
  set +e
  scripts/fixture-log.sh --workspace "$workspace" --crash-write --at "$point" --hard
  local status=$?
  set -e
  if [ "$status" -lt 128 ]; then
    echo "the writer exited $status rather than dying by signal" >&2
    [ "$cleanup" -eq 1 ] && rm -rf "$workspace"
    exit 1
  fi
  echo "writer died by signal $((status - 128)), as intended"
  echo

  # A different process, over the same disk.
  echo "recovery, in a new process:"
  if ! scripts/fixture-log.sh --workspace "$workspace" --recover; then
    echo "recovery failed after a kill at $point" >&2
    [ "$cleanup" -eq 1 ] && rm -rf "$workspace"
    exit 1
  fi
  [ "$cleanup" -eq 1 ] && rm -rf "$workspace"
}

# Register group ids into a workspace, and nothing else.
#
#   scripts/weald-stack provision --id WS --group HEX [--group HEX ...]
#
# `register` exists for the one suite workspace and builds the client to derive its
# group ids. This is the same insert without either: a caller that already knows its
# ids, which is any live test holding `GroupID.derive`, needs a workspace it can
# bootstrap on its own rather than a shared one.
#
# It deliberately does not publish an access set. A workspace with no set admits its
# first device into `Bootstrapping`, and publishing the genesis set from there is the
# client behaviour `specs/backend/relay/wire.md` describes and step 6's suite has to
# exercise. A harness that published it would have taken that path away from the test
# and proved it about bash instead.
cmd_provision() {
  local id="" groups=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --id) id="$2"; shift 2 ;;
      --group) groups+=("$2"); shift 2 ;;
      *) echo "weald-stack provision: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  [ -n "$id" ] || { echo "weald-stack provision: --id is required" >&2; exit 64; }
  [ "${#groups[@]}" -gt 0 ] || { echo "weald-stack provision: at least one --group" >&2; exit 64; }
  require_daemon
  local g
  for g in "${groups[@]}"; do
    case "$g" in
      *[!0-9a-f]* | "") echo "weald-stack provision: --group takes hex: $g" >&2; exit 64 ;;
    esac
    [ "${#g}" -eq 64 ] || { echo "weald-stack provision: a group id is 32 bytes: $g" >&2; exit 64; }
    psql_relay -v ON_ERROR_STOP=1 -q -c \
      "insert into relay_group (group_id, workspace_id) values (decode('$g','hex'), '$id') on conflict do nothing" \
      >/dev/null
  done
  echo "provisioned $id with ${#groups[@]} group(s)"
}

# --- prove-blind -------------------------------------------------------------
#
# The automated blindness demo from `specs/backend/build/local-harness.md`, and
# the Blindness part of step 8's gate.
#
# Two real client processes exchange messages and tickets carrying tokens this
# script planted. Then the relay's own Postgres is dumped out of its own
# container and searched for those tokens in every encoding the database could
# be holding them in, the recovery wraps are read and checked for a value
# recurring across two groups, and the evidence lands under build-evidence/step-08.
#
# Nothing here is mocked across the trust boundary. The dump is of the database
# the running relay writes to, after that relay carried this run's traffic. The
# analysis is `scripts/prove-blind.py`, which begins every run by proving its own
# detectors can go red, because a blindness proof that cannot fail is worth
# nothing.
PROVE_BLIND_EVIDENCE="${WEALD_PROVE_BLIND_EVIDENCE:-$ROOT/build-evidence/step-08/prove-blind}"
PROVE_BLIND_WORK="$STACK_STATE/prove-blind"

cmd_prove_blind() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --evidence) PROVE_BLIND_EVIDENCE="$2"; shift 2 ;;
      *) echo "weald-stack prove-blind: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || { echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2; exit 1; }

  local run_id; run_id="$(date +%Y%m%d-%H%M%S)"
  # The sentinels. Distinct, uppercase and alphanumeric so that a hex or base64
  # form of one cannot be confused with a hex or base64 form of another, and so
  # the same token can be handed to grep as a fixed string.
  local nonce; nonce="$(python3 -c 'import os; print(os.urandom(5).hex().upper())')"
  local s_c1_msg="PBSENT${nonce}CHATONE"
  local s_c2_msg="PBSENT${nonce}CHATTWO"
  local s_ticket_title="PBSENT${nonce}TITLE"
  local s_ticket_body="PBSENT${nonce}BODY"

  echo "prove-blind $run_id"
  echo
  echo "driving real traffic through two client processes"
  # --fresh, so the envelope count below is this run's traffic and not also the
  # previous run's. A count that measured two runs at once could not distinguish
  # "the messages arrived" from "the messages arrived last time".
  cmd_clients 2 --selections relay,relay --fresh >/dev/null

  wc_ c1 send "$s_c1_msg" >/dev/null
  wc_ c1 ticket --id "PB-$nonce" --title "$s_ticket_title" --body "$s_ticket_body" >/dev/null
  wc_ c1 --seconds 30 sync >/dev/null
  wc_ c2 send "$s_c2_msg" >/dev/null
  wc_ c2 --seconds 30 sync >/dev/null
  # A second round each way, because a sentinel that only ever sat in its
  # author's own checkout would prove nothing about what the relay carried.
  wc_ c1 --seconds 30 sync >/dev/null
  wc_ c2 --seconds 30 sync >/dev/null

  local workspace_id; workspace_id="$(cat "$CLIENTS_DIR/workspace-id")"
  note "workspace" "$workspace_id"

  local bin; bin="$(client_binary)"
  mkdir -p "$PROVE_BLIND_WORK"
  local manifest="$PROVE_BLIND_WORK/manifest.json"
  {
    printf '{\n'
    printf '  "run_id": "%s",\n' "$run_id"
    printf '  "workspace_id": "%s",\n' "$workspace_id"
    printf '  "expected_envelopes": 3,\n'
    printf '  "client_dirs": {"c1": "%s", "c2": "%s"},\n' "$CLIENTS_DIR/c1" "$CLIENTS_DIR/c2"
    printf '  "sentinels": [\n'
    printf '    {"name": "c1-chat", "value": "%s"},\n' "$s_c1_msg"
    printf '    {"name": "c2-chat", "value": "%s"},\n' "$s_c2_msg"
    printf '    {"name": "ticket-title", "value": "%s"},\n' "$s_ticket_title"
    printf '    {"name": "ticket-body", "value": "%s"}\n' "$s_ticket_body"
    printf '  ],\n'
    printf '  "groups": [\n'
    local first=1 id scope
    while read -r id scope; do
      [ -n "$id" ] || continue
      [ "$first" -eq 1 ] || printf ',\n'
      first=0
      printf '    {"id": "%s", "scope": "%s"}' "$id" "$scope"
    done < <("$bin" relay-client --workspace "$CLIENTS_DIR/c1" \
               --workspace-id "$workspace_id" groups)
    printf '\n  ]\n}\n'
  } > "$manifest"

  echo
  python3 "$ROOT/scripts/prove-blind.py" \
    --container "$(dc ps -q postgres)" \
    --db weald_relay_stack \
    --manifest "$manifest" \
    --evidence "$PROVE_BLIND_EVIDENCE" \
    --work "$PROVE_BLIND_WORK"
}

# --- agent-crossing ----------------------------------------------------------
#
# Step 2's integration proof, from `specs/agents/networked/phases-protocol.md`:
# "an invoke crosses a real relay between two real instances and verifies at the
# far side".
#
# Two client processes, two directories, two device keys, one real relay backed by
# real Postgres. Client 1 writes a chat message carrying a mention and the signed
# `agent.invoke` beside it, exactly as the composer will; the relay carries both as
# opaque ciphertext; client 2 opens the invoke, verifies its signature and runs the
# admission checks step 2 owns.
#
# What makes it a crossing rather than a round trip: the verifying process never
# held the signing key and never saw the plaintext until it decrypted what the relay
# handed it. A single process doing both halves would be proving the codec, which the
# unit tier already does over bytes it built itself.
#
# The sentinels are printed as `needle=` lines for the caller to grep the relay's
# database for. Three of them, and each is a different kind of thing the relay must
# not learn: who asked (the requester principal), who was asked (the mention alias),
# and what was said (the message text).
AGENT_CROSSING_OUT="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-02}"

cmd_agent_crossing() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) AGENT_CROSSING_OUT="$2"; shift 2 ;;
      *) echo "weald-stack agent-crossing: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$AGENT_CROSSING_OUT"
  local out="$AGENT_CROSSING_OUT/invoke-crossing.txt"

  local nonce; nonce="$(python3 -c 'import os; print(os.urandom(5).hex().upper())')"
  local alias="researcher.p1.AI${nonce}"
  local text="@${alias} summarise AISENT${nonce}BODY please"
  local ticket="AI-$nonce"

  # --fresh, so what crosses is this run's traffic. A verify that found the previous
  # run's invoke would report a crossing that did not happen.
  cmd_clients 2 --selections relay,relay --fresh >/dev/null

  {
    echo "# An agent.invoke crosses a real relay between two real instances"
    echo
    echo "workspace $(cat "$CLIENTS_DIR/workspace-id")"
    echo "relay     $(relay_ws_url)"
    echo "alias     $alias"
    echo "ticket    $ticket"
    echo
    echo "## client 1 authors the message and the invoke beside it"
    wc_ c1 agent-invoke --alias "$alias" --id "$ticket" --body "$text"
    echo
    echo "## client 1 publishes, client 2 receives"
    wc_ c1 --seconds 30 sync
    wc_ c2 --seconds 30 sync
    echo
    echo "## client 2 opens, decodes, verifies and admits"
    wc_ c2 agent-verify
  } | tee "$out"

  # `tee` in a pipeline hides the failure of everything left of it, and a verify that
  # exited non-zero must not be recorded as a crossing. Re-run the one command whose
  # exit status is the proof, quietly, and let its status be this command's.
  wc_ c2 agent-verify >/dev/null || {
    echo "weald-stack: client 2 did not verify the invoke that crossed" >&2
    exit 1
  }

  # The two instances are two devices, and the crossing means nothing otherwise.
  local d1 d2
  d1="$(wc_ c1 device | field "$(wc_ c1 device)" device)"
  d2="$(wc_ c2 device | field "$(wc_ c2 device)" device)"
  [ -n "$d1" ] && [ "$d1" != "$d2" ] || {
    echo "weald-stack: the two clients share a device key, so this is one player twice" >&2
    exit 1
  }
  {
    echo
    echo "## two devices, not one"
    echo "c1 device $d1"
    echo "c2 device $d2"
  } | tee -a "$out"

  # The needles, read out of what actually crossed.
  #
  # Four, and the choice of them is the whole meaning of the blindness claim:
  #
  #   sig          the authorship of this request, sealed inside the payload
  #   alias        who was asked for, which is a mention a person typed
  #   body         what was said
  #   invocation   the identity every lifecycle record will fold on
  #
  # The requester's *principal* is deliberately NOT a needle, and that is not a
  # weakening. `specs/backend/relay/identity.md` has the relay hold the access set:
  # it authenticates a connection by device key, so every device key allowed to
  # write is in its database by design, and a grep for one would find it and would
  # be finding the design rather than a leak. What the relay must not be able to do
  # is attribute an envelope to one of those keys, and the signature is exactly that
  # attribution. Its absence is the claim worth making.
  # The control, which is the opposite claim and the reason the four above mean
  # anything. A blindness grep that cannot go red is worth nothing, so the run also
  # names one value the relay legitimately *does* hold, in the same dump, through the
  # same search: client 1's device key, which the access set names because the relay
  # authenticates connections by it. A gate that finds the four needles absent and
  # the control absent as well has proven that its grep is broken, not that the relay
  # is blind.
  echo "control=$d1"
  local verified; verified="$(wc_ c2 agent-verify)"
  echo "needle=$(field "$verified" sig)"
  echo "needle=$alias"
  echo "needle=AISENT${nonce}BODY"
  echo "needle=$(field "$verified" invocation)"
}

# --- agent-fold-crossing -----------------------------------------------------
#
# Step 3's integration proof: "two instances fold the same shuffled record set to
# byte-identical state".
#
# Both clients write lifecycle records for one invocation, including a deliberate
# split (two `accepted` from two hosts) and a terminal after a terminal, so the set
# folded is one with anomalies in it rather than a happy path. Each client then folds
# what it holds, in its own arrival order, and prints a digest. The digests must be
# equal.
#
# The anomalies are the interesting half. A fold that dropped the second `accepted`
# would agree with itself while the invocation had run twice, so the digest covers the
# anomaly list and this run makes sure there is one to cover.
cmd_agent_fold_crossing() {
  local out_dir="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-03}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out_dir="$2"; shift 2 ;;
      *) echo "weald-stack agent-fold-crossing: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$out_dir"
  local out="$out_dir/fold-crossing.txt"

  cmd_clients 2 --selections relay,relay --fresh >/dev/null

  {
    echo "# Two instances fold one record set to one digest"
    echo
    echo "workspace $(cat "$CLIENTS_DIR/workspace-id")"
    echo "relay     $(relay_ws_url)"
    echo
    echo "## client 1 accepts, runs and completes"
    wc_ c1 agent-lifecycle --alias accepted
    wc_ c1 agent-lifecycle --alias running
    echo
    echo "## client 2 accepts the same invocation, which is the split"
    wc_ c2 agent-lifecycle --alias accepted
    echo
    echo "## client 1 completes, then writes a late failure that must be dropped"
    wc_ c1 agent-lifecycle --alias completed
    wc_ c1 agent-lifecycle --alias failed --body host.offline
    echo
    echo "## both sync, twice each way, so both hold every record"
    wc_ c1 --seconds 30 sync >/dev/null
    wc_ c2 --seconds 30 sync >/dev/null
    wc_ c1 --seconds 30 sync >/dev/null
    wc_ c2 --seconds 30 sync >/dev/null
    echo "synced"
    echo
    echo "## client 1 folds"
    wc_ c1 agent-fold
    echo
    echo "## client 2 folds"
    wc_ c2 agent-fold
  } | tee "$out"

  local f1 f2
  f1="$(wc_ c1 agent-fold)"
  f2="$(wc_ c2 agent-fold)"
  local d1 d2 n1 n2 r1 r2
  d1="$(field "$f1" digest)"; d2="$(field "$f2" digest)"
  n1="$(field "$f1" anomalies)"; n2="$(field "$f2" anomalies)"
  r1="$(field "$f1" records)"; r2="$(field "$f2" records)"

  {
    echo
    echo "## the comparison"
    echo "c1 records $r1  anomalies $n1  digest $d1"
    echo "c2 records $r2  anomalies $n2  digest $d2"
  } | tee -a "$out"

  [ -n "$d1" ] && [ "$d1" = "$d2" ] || {
    echo "weald-stack: the two instances folded to different digests" >&2
    exit 1
  }
  # A set with no anomalies would make the agreement cheap: two clients agreeing that
  # nothing went wrong is not the claim. The split and the dropped terminal must both
  # be in the folded state.
  [ "$n1" -ge 2 ] || {
    echo "weald-stack: the folded set carried $n1 anomalies and the proof needs the" >&2
    echo "split and the dropped terminal, so at least 2." >&2
    exit 1
  }
  [ "$r1" -ge 5 ] && [ "$r1" = "$r2" ] || {
    echo "weald-stack: the two instances hold different record counts ($r1, $r2)" >&2
    exit 1
  }
  echo "digest=$d1"
  echo "anomalies=$n1"
  echo "records=$r1"
}

# --- agent-card-crossing -----------------------------------------------------
#
# Step 5's integration proof, from `specs/agents/networked/phases-host.md`: "a
# published card read back from a second instance contains only schema fields".
#
# Client 1 holds a bot with a planted secret in every private field, projects it
# through `BotCardProjection`, signs the card and publishes it. The relay carries the
# envelope as ciphertext. Client 2, a different process with a different device key in
# a different directory, opens it, verifies the signature, and walks the encoded map
# key by key without the decoder's schema filter, because a decoder that refuses
# unknown keys can only ever report keys it accepts.
#
# Two things are asserted here and neither is provable inside one process. The far
# side sees only schema keys, and the far side's whole output contains no planted
# secret. The second is the one that matters: a projection that leaked would leak into
# a field the schema allows, so "only schema fields" on its own would stay green.
cmd_agent_card_crossing() {
  local out_dir="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-05}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out_dir="$2"; shift 2 ;;
      *) echo "weald-stack agent-card-crossing: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$out_dir"
  local out="$out_dir/card-crossing.txt"

  local nonce; nonce="$(python3 -c 'import os; print(os.urandom(5).hex().upper())')"
  # The slug is deliberately not already an alias: capitals, a space and a sigil, so
  # what crosses proves the normalisation and not just the transport.
  local slug="@Researcher P1 AC${nonce}"
  local secret="ZQXCARD${nonce}"

  cmd_clients 2 --selections relay,relay --fresh >/dev/null

  {
    echo "# A published agent.card crosses a real relay and is walked at the far side"
    echo
    echo "workspace $(cat "$CLIENTS_DIR/workspace-id")"
    echo "relay     $(relay_ws_url)"
    echo "slug      $slug"
    echo
    echo "## client 1 projects a bot with a planted secret and publishes the card"
    wc_ c1 agent-publish-card --alias "$slug" --title "Researcher AC${nonce}" --body "$secret"
    echo
    echo "## client 1 publishes, client 2 receives"
    wc_ c1 --seconds 30 sync
    wc_ c2 --seconds 30 sync
    echo
    echo "## client 2 verifies the card and walks its keys"
    wc_ c2 agent-read-card
  } | tee "$out"

  # `tee` hides the exit status of everything left of it, and the read is the proof.
  local read_out
  read_out="$(wc_ c2 agent-read-card)" || {
    echo "weald-stack: client 2 did not read the card that crossed" >&2
    exit 1
  }

  local keys outside
  keys="$(field "$read_out" keys)"
  outside="$(field "$read_out" outside)"
  [ "$outside" = "0" ] || {
    echo "weald-stack: the card that crossed carried $outside key(s) outside the schema" >&2
    exit 1
  }
  # A card with one key in it would satisfy "no key outside the schema" and prove
  # nothing. A user card carries every slot but `org`, which is fourteen.
  local key_count; key_count="$(awk -F, '{print NF}' <<<"$keys")"
  [ "$key_count" -ge 14 ] || {
    echo "weald-stack: the card that crossed carried $key_count keys; a user card has 14" >&2
    exit 1
  }

  # The far side's entire output, grepped for the planted secret. Over the whole
  # printed record rather than one field, because a leak that landed in the display
  # name and a leak that landed in an alias are the same failure.
  if grep -qi "$secret" <<<"$read_out"; then
    echo "weald-stack: the planted secret reached the far side" >&2
    exit 1
  fi

  # The two instances are two devices, or this is one player twice.
  local d1 d2
  d1="$(field "$(wc_ c1 device)" device)"
  d2="$(field "$(wc_ c2 device)" device)"
  [ -n "$d1" ] && [ "$d1" != "$d2" ] || {
    echo "weald-stack: the two clients share a device key, so this is one player twice" >&2
    exit 1
  }
  {
    echo
    echo "## the comparison"
    echo "keys      $keys"
    echo "outside   $outside"
    echo "c1 device $d1"
    echo "c2 device $d2"
  } | tee -a "$out"

  # The needles for the relay's own database. Each is a private field of the bot the
  # card was projected from, and the control is client 1's device key, which the
  # access set names by design and which the same grep must therefore find.
  echo "control=$d1"
  echo "needle=${secret}-systemprompt"
  echo "needle=${secret}-goal"
  echo "needle=${secret}-model"
  echo "needle=${secret}-path"
  echo "keys=$keys"
}

# --- ci-disclosure-crossing --------------------------------------------------
#
# CI5's integration proof: `CiDisclosure` fires on a `ci.report` card that
# actually crossed a real relay, not on a card this process assembled itself.
# Client 1 publishes the card; client 2 reads the real bytes back, and its own
# `CiDisclosureGate` is asked about the resulting directory entry, first
# unanswered (must ask) and then after accepting (must show).
cmd_ci_disclosure_crossing() {
  local out_dir="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-CI5}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out_dir="$2"; shift 2 ;;
      *) echo "weald-stack ci-disclosure-crossing: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$out_dir"
  local out="$out_dir/ci-disclosure-crossing.txt"

  local nonce; nonce="$(python3 -c 'import os; print(os.urandom(5).hex().upper())')"
  local slug="@Pipeline CID${nonce}"

  cmd_clients 2 --selections relay,relay --fresh >/dev/null

  {
    echo "# CiDisclosure asked about a real ci.report card, over a real relay"
    echo
    echo "## client 1 publishes a card carrying ci.report"
    wc_ c1 agent-publish-card --alias "$slug" --title "Pipeline CID${nonce}" \
      --capability ci.report
    echo
    echo "## client 1 publishes, client 2 receives"
    wc_ c1 --seconds 30 sync
    wc_ c2 --seconds 30 sync
    echo
    echo "## client 2, unanswered: must ask"
    wc_ c2 agent-ci-disclosure --alias "$slug"
    echo
    echo "## client 2, after accepting: must show"
    wc_ c2 agent-ci-disclosure --alias "$slug" --state accept
  } | tee "$out"

  local unanswered accepted
  unanswered="$(wc_ c2 agent-ci-disclosure --alias "$slug")"
  if ! grep -q "^step=ask" <<<"$unanswered"; then
    echo "weald-stack: an unanswered ci.report card did not ask for a disclosure" >&2
    echo "$unanswered" >&2
    exit 1
  fi
  accepted="$(wc_ c2 agent-ci-disclosure --alias "$slug" --state accept)"
  if ! grep -q "^step=show" <<<"$accepted"; then
    echo "weald-stack: accepting the CI disclosure did not lead to showing it" >&2
    echo "$accepted" >&2
    exit 1
  fi
  echo "ci-disclosure-crossing: pass" | tee -a "$out"
}

# --- ci-card-crossing --------------------------------------------------------
#
# CI1's integration proof, from `specs/agents/networked/ci-module.md`: the Weald
# CI card is the built card with one capability the workspace has to be able to
# read, and nothing that writes to a repository.
#
# Client 1 publishes a card carrying `ci.report` and no code block. Client 2, a
# separate process with its own device key and its own directory, reads it back
# off a real relay, walks the encoded map, and says which capability crossed and
# whether the block that names repositories is there. Two instances rather than
# one, because "the far side sees ci.report" is the whole claim and a single
# process comparing its own encoder to its own decoder cannot make it.
#
# The refusal is driven in the same run: the same verb asked for `ci.report` and
# `code.pullrequest` together must fail before anything is written, which is what
# makes "a CI client is never a second Git writer" a property of the bytes.
cmd_ci_card_crossing() {
  local out_dir="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-CI1}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out_dir="$2"; shift 2 ;;
      *) echo "weald-stack ci-card-crossing: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$out_dir"
  local out="$out_dir/ci-card-crossing.txt"

  local nonce; nonce="$(python3 -c 'import os; print(os.urandom(5).hex().upper())')"
  local slug="@Pipeline CI${nonce}"
  local secret="ZQXCI${nonce}"

  cmd_clients 2 --selections relay,relay --fresh >/dev/null

  {
    echo "# A Weald CI agent.card crosses a real relay and is walked at the far side"
    echo
    echo "workspace $(cat "$CLIENTS_DIR/workspace-id")"
    echo "relay     $(relay_ws_url)"
    echo "slug      $slug"
    echo
    echo "## client 1 publishes a card carrying ci.report and no code block"
    wc_ c1 agent-publish-card --alias "$slug" --title "Pipeline CI${nonce}" \
      --body "$secret" --capability ci.report
    echo
    echo "## client 1 publishes, client 2 receives"
    wc_ c1 --seconds 30 sync
    wc_ c2 --seconds 30 sync
    echo
    echo "## client 2 verifies the card and walks its keys"
    wc_ c2 agent-read-card
  } | tee "$out"

  local read_out
  read_out="$(wc_ c2 agent-read-card)" || {
    echo "weald-stack: client 2 did not read the CI card that crossed" >&2
    exit 1
  }

  local capabilities code outside
  capabilities="$(field "$read_out" capabilities)"
  code="$(field "$read_out" code)"
  outside="$(field "$read_out" outside)"
  [ "$capabilities" = "ci.report" ] || {
    echo "weald-stack: the card that crossed carries '$capabilities', not ci.report" >&2
    exit 1
  }
  [ "$code" = "absent" ] || {
    echo "weald-stack: a ci.report card crossed carrying a code block" >&2
    exit 1
  }
  [ "$outside" = "0" ] || {
    echo "weald-stack: the CI card carried $outside key(s) outside the schema" >&2
    exit 1
  }
  if grep -qi "$secret" <<<"$read_out"; then
    echo "weald-stack: the planted secret reached the far side" >&2
    exit 1
  fi

  local d1 d2
  d1="$(field "$(wc_ c1 device)" device)"
  d2="$(field "$(wc_ c2 device)" device)"
  [ -n "$d1" ] && [ "$d1" != "$d2" ] || {
    echo "weald-stack: the two clients share a device key, so this is one player twice" >&2
    exit 1
  }

  # The refusal, in the same run and through the same verb: a CI card that also
  # claims the capability that writes a branch is not publishable at all.
  local both
  if both="$(wc_ c1 agent-publish-card --alias "$slug" --title "Both CI${nonce}" \
        --capability ci.report --capability code.pullrequest 2>&1)"; then
    echo "weald-stack: a card carrying ci.report and code.pullrequest published" >&2
    echo "$both" >&2
    exit 1
  fi

  {
    echo
    echo "## the comparison"
    echo "capabilities $capabilities"
    echo "code         $code"
    echo "outside      $outside"
    echo "c1 device    $d1"
    echo "c2 device    $d2"
    echo
    echo "## the refusal, same verb, same run"
    echo "$both" | sed 's/^/  /'
  } | tee -a "$out"

  echo "control=$d1"
  echo "needle=${secret}-systemprompt"
  echo "needle=${secret}-goal"
  echo "needle=${secret}-model"
  echo "needle=${secret}-path"
  echo "capabilities=$capabilities"
}

# Step 6's integration proof: two instances converge on one directory, and a
# withdrawal removes the agent from both of them.
#
# The digest is what converged means here. Two processes cannot compare values, and
# comparing printed rows line by line in shell would be a second implementation of
# equality, so each side prints a digest over its own projected entries, statuses and
# versions and the two are compared. Both sides are asserted at both moments, before
# and after the withdrawal, because a run where only one side dropped the agent is
# exactly the failure this step is about and inferring the second side from the first
# would hide it.
cmd_agent_card_directory_crossing() {
  local out_dir="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-06}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out_dir="$2"; shift 2 ;;
      *) echo "weald-stack agent-card-directory-crossing: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$out_dir"
  local out="$out_dir/directory-crossing.txt"

  local nonce; nonce="$(python3 -c 'import os; print(os.urandom(5).hex().upper())')"
  local slug="@Researcher P1 AD${nonce}"
  local alias_norm; alias_norm="researcher-p1-ad$(tr 'A-Z' 'a-z' <<<"$nonce")"

  cmd_clients 2 --selections relay,relay --fresh >/dev/null

  local d1 d2
  d1="$(field "$(wc_ c1 device)" device)"
  d2="$(field "$(wc_ c2 device)" device)"
  [ -n "$d1" ] && [ "$d1" != "$d2" ] || {
    echo "weald-stack: the two clients share a device key, so this is one player twice" >&2
    exit 1
  }

  {
    echo "# One published agent converges into two directories, and a withdrawal removes it from both"
    echo
    echo "workspace $(cat "$CLIENTS_DIR/workspace-id")"
    echo "relay     $(relay_ws_url)"
    echo "slug      $slug"
    echo "c1 device $d1"
    echo "c2 device $d2"
    echo
    echo "## client 1 publishes"
  } | tee "$out"
  # Outside the pipeline: a failure inside `{ ... } | tee` only kills the subshell,
  # and a publish that failed must stop the proof rather than be projected as absent.
  local share_out
  share_out="$(wc_ c1 agent-share --alias "$slug")" || {
    echo "weald-stack: client 1 could not publish the agent" >&2
    exit 1
  }
  echo "$share_out" | tee -a "$out"

  local published_dirs
  published_dirs="$(directory_crossing_converged "$out" "published")" || exit 1
  local pub_digest="${published_dirs%% *}"
  local pub_offer="${published_dirs#* }"
  case "$pub_offer" in
    *"$alias_norm"*) : ;;
    *) echo "weald-stack: the published agent is not offerable: '$pub_offer'" >&2; exit 1 ;;
  esac

  {
    echo
    echo "## client 1 withdraws the publication"
  } | tee -a "$out"
  local withdraw_out
  withdraw_out="$(wc_ c1 agent-share --alias "$slug" --state unpublished)" || {
    echo "weald-stack: client 1 could not withdraw the agent" >&2
    exit 1
  }
  echo "$withdraw_out" | tee -a "$out"

  local withdrawn_dirs
  withdrawn_dirs="$(directory_crossing_converged "$out" "unpublished")" || exit 1
  local wd_digest="${withdrawn_dirs%% *}"
  local wd_offer="${withdrawn_dirs#* }"
  [ -z "$wd_offer" ] || {
    echo "weald-stack: the withdrawn agent is still offerable: '$wd_offer'" >&2
    exit 1
  }
  [ "$pub_digest" != "$wd_digest" ] || {
    echo "weald-stack: the directory did not change across the withdrawal" >&2
    exit 1
  }

  {
    echo
    echo "## the comparison"
    echo "published  digest $pub_digest offerable $pub_offer"
    echo "withdrawn  digest $wd_digest offerable ${wd_offer:-<none>}"
  } | tee -a "$out"

  echo "digest_published=$pub_digest"
  echo "digest_withdrawn=$wd_digest"
}

# Sync both instances, project both directories, assert the two digests are equal,
# and echo "<digest> <offerable>". Every append goes to the record so a failure can
# be read after the fact.
directory_crossing_converged() {
  local out="$1" label="$2"
  {
    echo
    echo "## both sync, both project ($label)"
    wc_ c1 --seconds 30 sync
    wc_ c2 --seconds 30 sync
  } >>"$out" 2>&1

  local o1 o2
  o1="$(wc_ c1 agent-directory)" || { echo "weald-stack: c1 could not project" >&2; return 1; }
  o2="$(wc_ c2 agent-directory)" || { echo "weald-stack: c2 could not project" >&2; return 1; }
  { echo "### c1"; echo "$o1"; echo "### c2"; echo "$o2"; } >>"$out"

  local g1 g2
  g1="$(field "$o1" digest)"
  g2="$(field "$o2" digest)"
  [ -n "$g1" ] || { echo "weald-stack: c1 printed no digest" >&2; return 1; }
  [ "$g1" = "$g2" ] || {
    echo "weald-stack: the two directories disagree at '$label': $g1 vs $g2" >&2
    return 1
  }
  local f1 f2
  f1="$(field "$o1" offerable)"
  f2="$(field "$o2" offerable)"
  [ "$f1" = "$f2" ] || {
    echo "weald-stack: the two offerable sets disagree at '$label': '$f1' vs '$f2'" >&2
    return 1
  }
  echo "$g1 $f1"
}

# Step 7's integration proof: an agent's leaf joins one real MLS group over a real
# relay, the other instance sees it, and a steward pass at expiry takes it out of both.
#
# The whole claim is about what the *other* member believes. An `Add` is a commit and a
# commit is only true when everybody applies it, so a single process that added a leaf
# and then counted its own members would be reading its own optimism. c1 commits and
# publishes; c2 follows the handshake log and reports what its own MLS state says; the
# two counts are compared at both moments.
cmd_agent_leaf_crossing() {
  local out_dir="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-07}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out_dir="$2"; shift 2 ;;
      *) echo "weald-stack agent-leaf-crossing: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$out_dir"
  local out="$out_dir/leaf-crossing.txt"

  local nonce; nonce="$(python3 -c 'import os; print(os.urandom(4).hex())')"
  local alias="researcher-al$nonce"

  cmd_clients 2 --selections relay,relay --fresh >/dev/null

  local d1 d2
  d1="$(field "$(wc_ c1 device)" device)"
  d2="$(field "$(wc_ c2 device)" device)"
  [ -n "$d1" ] && [ "$d1" != "$d2" ] || {
    echo "weald-stack: the two clients share a device key, so this is one player twice" >&2
    exit 1
  }

  {
    echo "# An agent leaf joins a real MLS group over a real relay, and is evicted at expiry"
    echo
    echo "workspace $(cat "$CLIENTS_DIR/workspace-id")"
    echo "relay     $(relay_ws_url)"
    echo "alias     $alias"
    echo "c1 device $d1"
    echo "c2 device $d2"
    echo
    echo "## both instances join the channel first"
    wc_ c1 --seconds 30 sync
    wc_ c2 --seconds 30 sync
  } | tee "$out"

  # The baseline, from c2's own state. Taken before anything is added, so the number the
  # join is compared against is a number c2 computed rather than one this script assumed.
  local before_out before_members
  before_out="$(wc_ c2 agent-members)" || {
    echo "weald-stack: c2 is not a member of the channel, so it can see nothing" >&2
    exit 1
  }
  before_members="$(field "$before_out" members)"
  { echo; echo "## c2 before"; echo "$before_out"; } >>"$out"

  local join_out
  join_out="$(wc_ c1 agent-leaf --alias "$alias" --seconds 120)" || {
    echo "weald-stack: c1 could not admit the agent's leaf" >&2
    exit 1
  }
  { echo; echo "## c1 admits the agent's leaf"; echo "$join_out"; } | tee -a "$out"

  local leaf approval published joined_members
  leaf="$(field "$join_out" leaf)"
  approval="$(field "$join_out" approval)"
  published="$(field "$join_out" published)"
  joined_members="$(field "$join_out" members)"
  [ "$approval" = "firstApproval" ] || {
    echo "weald-stack: the first certificate was recorded as '$approval'" >&2
    exit 1
  }
  [ "$leaf" != "-" ] || { echo "weald-stack: no leaf was added" >&2; exit 1; }
  [ "${published:-0}" -ge 1 ] || {
    echo "weald-stack: the commit was never published, so no other member can apply it" >&2
    exit 1
  }

  wc_ c2 --seconds 30 sync >>"$out" 2>&1
  local after_join after_join_members
  after_join="$(wc_ c2 agent-members)" || exit 1
  after_join_members="$(field "$after_join" members)"
  { echo; echo "## c2 after the join"; echo "$after_join"; } | tee -a "$out"
  [ "$after_join_members" = "$joined_members" ] || {
    echo "weald-stack: c1 sees $joined_members members and c2 sees $after_join_members" >&2
    exit 1
  }
  [ "$after_join_members" -gt "$before_members" ] || {
    echo "weald-stack: c2's membership did not grow, so the leaf never crossed" >&2
    exit 1
  }

  local evict_out
  evict_out="$(wc_ c1 agent-leaf --alias "$alias" --state expired)" || {
    echo "weald-stack: the steward pass failed" >&2
    exit 1
  }
  { echo; echo "## c1 runs the steward pass at expiry"; echo "$evict_out"; } | tee -a "$out"
  [ "$(field "$evict_out" evicted)" = "1" ] || {
    echo "weald-stack: the pass evicted $(field "$evict_out" evicted) leaves, expected 1" >&2
    exit 1
  }
  [ "$(field "$evict_out" withinOneEpoch)" = "true" ] || {
    echo "weald-stack: the eviction did not land within one epoch" >&2
    exit 1
  }

  wc_ c2 --seconds 30 sync >>"$out" 2>&1
  local after_evict after_evict_members
  after_evict="$(wc_ c2 agent-members)" || exit 1
  after_evict_members="$(field "$after_evict" members)"
  { echo; echo "## c2 after the eviction"; echo "$after_evict"; } | tee -a "$out"
  [ "$after_evict_members" = "$before_members" ] || {
    echo "weald-stack: c2 still sees $after_evict_members members after the eviction" >&2
    exit 1
  }

  {
    echo
    echo "## the comparison"
    echo "before     c2 members $before_members"
    echo "joined     c1 members $joined_members  c2 members $after_join_members  leaf $leaf"
    echo "evicted    c1 members $(field "$evict_out" members)  c2 members $after_evict_members"
    echo "lifecycle  $(field "$join_out" lifecycle) ;; $(field "$evict_out" lifecycle)"
    echo "audit      $(field "$join_out" audit)"
  } | tee -a "$out"

  echo "leaf=$leaf"
  echo "members_joined=$after_join_members"
  echo "members_evicted=$after_evict_members"
}

# Step 8's integration proof: two instances race for one invocation over a real relay,
# and exactly one of them executes.
#
# The claim is not "a lock works". It is that two machines holding the same agent and
# seeing the same signed invoke produce one execution, and the thing that decides which
# one is the lease, which has to cross the relay to decide anything. So c1 publishes a
# lease at epoch 2 and the invoke beside it, both instances sync, and both are asked to
# claim. Each answers from its own on-disk ledger with its own device key, and the two
# answers are counted here: exactly one `run`, and the other a refusal with a reason.
#
# Then the replay half, which is the same claim over time rather than over machines: the
# winner is asked again and must answer `replay` rather than running a second time.
cmd_agent_claim_race() {
  local out_dir="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-08}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out_dir="$2"; shift 2 ;;
      *) echo "weald-stack agent-claim-race: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$out_dir"
  local out="$out_dir/claim-race.txt"

  local nonce; nonce="$(python3 -c 'import os; print(os.urandom(4).hex())')"
  local alias="researcher-cl$nonce"

  cmd_clients 2 --selections relay,relay --fresh >/dev/null

  local d1 d2
  d1="$(field "$(wc_ c1 device)" device)"
  d2="$(field "$(wc_ c2 device)" device)"
  [ -n "$d1" ] && [ "$d1" != "$d2" ] || {
    echo "weald-stack: the two clients share a device key, so this is one player twice" >&2
    exit 1
  }

  {
    echo "# Two instances race for one invocation over a real relay"
    echo
    echo "workspace $(cat "$CLIENTS_DIR/workspace-id")"
    echo "relay     $(relay_ws_url)"
    echo "alias     $alias"
    echo "c1 device $d1"
    echo "c2 device $d2"
  } | tee "$out"

  # The lease, from c1, and the invoke beside it. Published in that order because a
  # claim decided before the lease crossed would be a claim decided by absence.
  local lease_out invoke_out
  lease_out="$(wc_ c1 agent-lease --alias "$alias" --seconds 2)" || {
    echo "weald-stack: c1 could not publish its lease" >&2; exit 1
  }
  invoke_out="$(wc_ c1 agent-invoke --alias "$alias")" || {
    echo "weald-stack: c1 could not publish the invoke" >&2; exit 1
  }
  { echo; echo "## c1 publishes the lease and the invoke";
    echo "$lease_out"; echo "$invoke_out"; } | tee -a "$out"

  {
    echo
    echo "## both sync"
    wc_ c1 --seconds 30 sync
    wc_ c2 --seconds 30 sync
  } >>"$out" 2>&1

  # Both are asked. Neither is told what the other answered, and the loser exits zero
  # with a reason, because refusing is the correct behaviour and a non-zero exit would
  # make "the loser refused" indistinguishable from "the loser crashed".
  local claim1 claim2
  claim1="$(wc_ c1 agent-claim --alias "$alias")" || {
    echo "weald-stack: c1 could not decide" >&2; exit 1
  }
  claim2="$(wc_ c2 agent-claim --alias "$alias")" || {
    echo "weald-stack: c2 could not decide" >&2; exit 1
  }
  { echo; echo "## c1 claims"; echo "$claim1";
    echo; echo "## c2 claims"; echo "$claim2"; } | tee -a "$out"

  local o1 o2
  o1="$(field "$claim1" outcome)"
  o2="$(field "$claim2" outcome)"
  local runs=0
  [ "$o1" = "run" ] && runs=$((runs + 1))
  [ "$o2" = "run" ] && runs=$((runs + 1))
  [ "$runs" -eq 1 ] || {
    echo "weald-stack: $runs instances executed one invocation, expected exactly 1" >&2
    exit 1
  }
  # The loser refused rather than silently doing nothing, and it said why.
  local loser_reason
  if [ "$o1" = "run" ]; then loser_reason="$(field "$claim2" reason)"
  else loser_reason="$(field "$claim1" reason)"; fi
  [ "$loser_reason" = "leaseNotHeld" ] || {
    echo "weald-stack: the loser refused as '$loser_reason', expected leaseNotHeld" >&2
    exit 1
  }
  # Both folded the same lease from the same crossed records, which is what makes the
  # refusal a decision about the lease rather than a difference of opinion about it.
  [ "$(field "$claim1" holder)" = "$(field "$claim2" holder)" ] || {
    echo "weald-stack: the two instances disagree about who holds the lease" >&2
    exit 1
  }
  [ "$(field "$claim1" epoch)" = "$(field "$claim2" epoch)" ] || {
    echo "weald-stack: the two instances disagree about the lease epoch" >&2
    exit 1
  }

  # The replay half: the winner, asked again, answers from its ledger.
  local winner; winner=c1
  [ "$o1" = "run" ] || winner=c2
  local again
  again="$(wc_ "$winner" agent-claim --alias "$alias")" || {
    echo "weald-stack: the winner could not answer a second time" >&2; exit 1
  }
  { echo; echo "## the winner is asked again"; echo "$again"; } | tee -a "$out"
  [ "$(field "$again" outcome)" = "replay" ] || {
    echo "weald-stack: the second ask produced '$(field "$again" outcome)', not a replay" >&2
    exit 1
  }
  [ "$(field "$again" executions)" = "1" ] || {
    echo "weald-stack: the winner's ledger holds $(field "$again" executions) executions" >&2
    exit 1
  }

  {
    echo
    echo "## the comparison"
    echo "raced      c1 $o1  c2 $o2"
    echo "executions 1"
    echo "refused    $loser_reason"
    echo "holder     $(field "$claim1" holder)"
    echo "epoch      $(field "$claim1" epoch)"
    echo "replayed   $(field "$again" outcome) of $(field "$again" reason)"
    echo "digest     $winner $(field "$again" digest)"
  } | tee -a "$out"

  echo "executions=1"
  echo "winner=$winner"
}

# Step 9's integration proof: Player 2 invokes, Player 1 executes, Player 2 receives a
# signed terminal answer over a real relay.
#
# The direction is the point. c2 writes the invoke, and c2 is not the owner: it holds no
# certificate, hosts no agent and has no agent key, so if c2 could ever produce the
# answer the whole programme would be a local assistant with synced chat. So both
# instances are asked to execute, and c2 must refuse silently, writing no record at all,
# which is `protocol.md`'s check 1 and a privacy property rather than a nicety.
#
# The answer is then read back on c2 and verified there: the terminal record's signature,
# the accepting host, the result id, and the author of the chat line, which must be the
# agent's key and not c1's device.
cmd_agent_execution_crossing() {
  local out_dir="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-09}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out_dir="$2"; shift 2 ;;
      *) echo "weald-stack agent-execution-crossing: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$out_dir"
  local out="$out_dir/execution-crossing.txt"

  local nonce; nonce="$(python3 -c 'import os; print(os.urandom(4).hex())')"
  local alias="researcher-ex$nonce"

  cmd_clients 2 --selections relay,relay --fresh >/dev/null

  local d1 d2
  d1="$(field "$(wc_ c1 device)" device)"
  d2="$(field "$(wc_ c2 device)" device)"
  [ -n "$d1" ] && [ "$d1" != "$d2" ] || {
    echo "weald-stack: the two clients share a device key, so this is one player twice" >&2
    exit 1
  }

  {
    echo "# Player 2 invokes, Player 1 executes, Player 2 verifies the answer"
    echo
    echo "workspace $(cat "$CLIENTS_DIR/workspace-id")"
    echo "relay     $(relay_ws_url)"
    echo "alias     $alias"
    echo "c1 device $d1"
    echo "c2 device $d2"
  } | tee "$out"

  # c1 owns the agent: a certificate, a leaf in the real group, and the lease.
  local leaf_out lease_out
  leaf_out="$(wc_ c1 agent-leaf --alias "$alias" --seconds 3600)" || {
    echo "weald-stack: c1 could not issue the agent's certificate" >&2; exit 1
  }
  lease_out="$(wc_ c1 agent-lease --alias "$alias" --seconds 2)" || {
    echo "weald-stack: c1 could not publish its lease" >&2; exit 1
  }
  { echo; echo "## c1 owns the agent"; echo "$leaf_out"; echo "$lease_out"; } | tee -a "$out"

  # c2 invokes. The requester is c2's device key, and c1 has to find it in the roster
  # of the group rather than take the invoke's word for it.
  local invoke_out
  invoke_out="$(wc_ c2 agent-invoke --alias "$alias" --id WEALD-909)" || {
    echo "weald-stack: c2 could not publish the invoke" >&2; exit 1
  }
  { echo; echo "## c2 invokes"; echo "$invoke_out"; } | tee -a "$out"
  [ "$(field "$invoke_out" requester)" = "$d2" ] || {
    echo "weald-stack: the invoke was not authored by c2" >&2; exit 1
  }

  { echo; echo "## both sync"; wc_ c1 --seconds 30 sync; wc_ c2 --seconds 30 sync; } \
    >>"$out" 2>&1

  # The instance that is not the owner is asked first, so a c1 that answered could not
  # be mistaken for a c2 that had been prevented from trying.
  local c2_exec
  c2_exec="$(wc_ c2 agent-execute --alias "$alias")" || {
    echo "weald-stack: c2's execute failed; it should refuse, not error" >&2; exit 1
  }
  { echo; echo "## c2 is asked to execute, and must say nothing"; echo "$c2_exec"; } \
    | tee -a "$out"
  [ "$(field "$c2_exec" outcome)" = "silent" ] || {
    echo "weald-stack: c2 answered '$(field "$c2_exec" outcome)', expected silent" >&2
    exit 1
  }
  [ "$(field "$c2_exec" records)" = "0" ] || {
    echo "weald-stack: c2 wrote $(field "$c2_exec" records) records; check 1 writes none" >&2
    exit 1
  }
  [ "$(field "$c2_exec" check)" = "1" ] || {
    echo "weald-stack: c2 refused at check $(field "$c2_exec" check), expected 1" >&2
    exit 1
  }

  local c1_exec
  c1_exec="$(wc_ c1 agent-execute --alias "$alias" --body "the answer is 42")" || {
    echo "weald-stack: c1 could not execute" >&2; exit 1
  }
  { echo; echo "## c1 executes"; echo "$c1_exec"; } | tee -a "$out"
  [ "$(field "$c1_exec" outcome)" = "completed" ] || {
    echo "weald-stack: c1 finished as '$(field "$c1_exec" outcome)'" >&2; exit 1
  }
  [ "$(field "$c1_exec" states)" = "accepted,running,completed" ] || {
    echo "weald-stack: c1 wrote states '$(field "$c1_exec" states)'" >&2; exit 1
  }

  # c1 publishes what it just wrote, then c2 pulls it. Two syncs and not one: a write
  # reaches the log locally and the relay on the next sync, so a proof that only synced
  # the reader would be a proof that the records never left the owner's Mac.
  { echo; echo "## c1 publishes, c2 syncs";
    wc_ c1 --seconds 30 sync; wc_ c2 --seconds 30 sync; } >>"$out" 2>&1

  local answer
  answer="$(wc_ c2 agent-answer --alias "$alias")" || {
    echo "weald-stack: c2 could not verify the answer" >&2; exit 1
  }
  { echo; echo "## c2 verifies"; echo "$answer"; } | tee -a "$out"
  [ "$(field "$answer" verified)" = "yes" ] || {
    echo "weald-stack: c2 did not verify the answer" >&2; exit 1
  }
  [ "$(field "$answer" state)" = "completed" ] || {
    echo "weald-stack: c2 folded state '$(field "$answer" state)'" >&2; exit 1
  }
  [ "$(field "$answer" acceptedBy)" = "$d1" ] || {
    echo "weald-stack: c2 says the accepting host is not c1" >&2; exit 1
  }
  [ "$(field "$answer" anomalies)" = "0" ] || {
    echo "weald-stack: c2 folded $(field "$answer" anomalies) anomalies" >&2; exit 1
  }
  # The answer is the agent's, not the owner's device and not c2's.
  local author; author="$(field "$answer" answerAuthor)"
  [ "$author" = "$(field "$c1_exec" agentKey)" ] || {
    echo "weald-stack: the answer was authored by $author, not by the agent" >&2; exit 1
  }
  [ "$author" != "$d1" ] && [ "$author" != "$d2" ] || {
    echo "weald-stack: the answer was authored by a person's device key" >&2; exit 1
  }

  {
    echo
    echo "## the comparison"
    echo "invoked    by c2 $d2"
    echo "refused    c2 silent at check 1, records 0"
    echo "executed   c1 $(field "$c1_exec" states)"
    echo "verified   c2 state=$(field "$answer" state) anomalies=$(field "$answer" anomalies)"
    echo "acceptedBy $(field "$answer" acceptedBy)"
    echo "terminalSig $(field "$answer" terminalSig)"
    echo "answerAuthor $author  (agent key, not $d1 and not $d2)"
    echo "answerText $(field "$answer" answerText)"
    echo "digest     $(field "$answer" digest)"
  } | tee -a "$out"

  echo "executed=c1"
  echo "verified=c2"
}

# Step 19's crossing: an organization agent answers, and both players fold the same
# signed answer out of it.
#
# The sentence the org track exists for: Player 2 mentions an agent that lives on a
# server, Player 1's Mac never runs it, a gateway process does, and both clients
# converge on one signed answer whose author is neither person's device key.
#
# Everything here is real. A real relay over the harness Postgres, two real client
# processes with their own directories and device keys, a real control-plane database
# with a real sealed OpenRouter credential, the shipping `weald-agent-worker` process
# behind real mutual TLS, and the shipping `weald-agent-gateway` process joined to the
# channel's real MLS group by a real Welcome. There is no stub anywhere on the path:
# the answer in the channel came from the vendor.
#
# The order below is the only one that works, and each step says why.
cmd_agent_org_crossing() {
  local out_dir="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-19}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out_dir="$2"; shift 2 ;;
      *) echo "weald-stack agent-org-crossing: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$out_dir"
  local out="$out_dir/org-crossing.txt"

  # The provider credential, from this Mac's login Keychain, exported to the seeder
  # and to nothing else. Never written to the tree, never printed, and absent is a
  # failure rather than a skip (`production-only.md`).
  local provider_key
  provider_key="$(/usr/bin/security find-generic-password -s com.dicyanin.weald \
    -a openrouter-api-key -w 2>/dev/null || true)"
  [ -n "$provider_key" ] || {
    echo "weald-stack: no OpenRouter key in the Keychain. This crossing reaches the" >&2
    echo "real vendor and there is no test mode." >&2
    exit 1
  }

  local nonce; nonce="$(python3 -c 'import os; print(os.urandom(4).hex())')"
  local alias="reviewer-og$nonce"
  local work; work="$STACK_STATE/org-crossing-$nonce"
  mkdir -p "$work/pki"

  cmd_clients 2 --selections relay,relay --fresh >/dev/null

  local d1 d2
  d1="$(field "$(wc_ c1 device)" device)"
  d2="$(field "$(wc_ c2 device)" device)"
  [ -n "$d1" ] && [ "$d1" != "$d2" ] || {
    echo "weald-stack: the two clients share a device key, so this is one player twice" >&2
    exit 1
  }

  # The channel's real group id, from the client that is a member of it rather than
  # from a bash reimplementation of `GroupID.derive`.
  local group; group="$(field "$(wc_ c1 agent-members)" group)"
  [ -n "$group" ] || { echo "weald-stack: c1 named no group" >&2; exit 1; }

  {
    echo "# Player 2 mentions an organization agent; a gateway answers; both players fold it"
    echo
    echo "workspace $(cat "$CLIENTS_DIR/workspace-id")"
    echo "relay     $(relay_ws_url)"
    echo "alias     $alias"
    echo "group     $group"
    echo "c1 device $d1"
    echo "c2 device $d2"
  } | tee "$out"

  # The gateway's key, and its principal before the process exists. The admin has to
  # admit it to the workspace access set first: a principal the access set does not
  # name cannot open a relay session at all, so a gateway started before this would
  # exit on its first connect.
  local seed principal
  seed="$(python3 -c 'import os; print(os.urandom(32).hex())')"
  principal="$(field "$(cargo run -q -p weald-agent-gateway --example principal_of -- "$seed")" principal)"
  [ -n "$principal" ] || { echo "weald-stack: could not derive the gateway principal" >&2; exit 1; }
  wc_ c1 admit --device "$principal" >>"$out" 2>&1 || {
    echo "weald-stack: the admin could not admit the gateway to the access set" >&2
    tail -20 "$out" >&2
    exit 1
  }

  # The control plane, as step 13's console will leave it: the agent, the channel it
  # is assigned to, the roster of members who may invoke it, one sealed credential
  # and the run's mutual TLS material.
  local control_db="weald_agents_org_$nonce"
  docker exec -i "$(dc ps -q postgres)" createdb -U weald "$control_db" >/dev/null 2>&1 || true
  local control_url="postgres://weald:weald@127.0.0.1:$WEALD_STACK_PG_PORT/$control_db"
  local seeded
  seeded="$(WEALD_LLM_OPENROUTER_KEY="$provider_key" cargo run -q -p weald-agent-worker \
    --example org_crossing_seed -- \
    --database "$control_url" --alias "$alias" --scope "$group" \
    --member "$d1" --member "$d2" --pki "$work/pki" \
    --model "${WEALD_AGENT_CROSSING_MODEL:-anthropic/claude-haiku-4.5}")" || {
    echo "weald-stack: seeding the control plane failed" >&2
    exit 1
  }
  local agent kek
  agent="$(field "$seeded" agent)"
  kek="$(field "$seeded" kek)"
  { echo; echo "## the control plane"; echo "agent $agent"; echo "database $control_db"; } \
    | tee -a "$out"

  # The worker. A separate process, mutually authenticated, holding the credential
  # this gateway cannot open: the architecture's whole point is that the process with
  # the plaintext conversation is not the process that can call a vendor.
  local worker_port; worker_port="$(python3 -c '
import socket
s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')"
  cargo build -q -p weald-agent-worker --bin weald-agent-worker || {
    echo "weald-stack: the worker did not build" >&2; exit 1; }
  WEALD_AGENT_WORKER_LISTEN="127.0.0.1:$worker_port" \
  WEALD_AGENT_WORKER_SERVER_CERT="$(cat "$work/pki/server.pem")" \
  WEALD_AGENT_WORKER_CLIENT_CA="$(cat "$work/pki/ca.pem")" \
  WEALD_AGENT_WORKER_KEK="$kek" \
  WEALD_AGENT_WORKER_DATABASE_URL="$control_url" \
    nohup "$ROOT/target/debug/weald-agent-worker" >"$work/worker.log" 2>&1 &
  local worker_pid=$!

  # The gateway. Its assignment is already in the database, so it subscribes on its
  # first pass rather than on a reload.
  cargo build -q -p weald-agent-gateway --bin weald-agent-gateway || {
    echo "weald-stack: the gateway did not build" >&2; kill "$worker_pid" 2>/dev/null; exit 1; }
  local gateway_port; gateway_port="$(python3 -c '
import socket
s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')"
  # A file path and not a directory: `config.rs` calls this the MLS state database.
  WEALD_AGENT_GATEWAY_LISTEN="127.0.0.1:$gateway_port" \
  WEALD_AGENT_GATEWAY_RELAY_URL="127.0.0.1:$WEALD_STACK_RELAY_PORT" \
  WEALD_AGENT_GATEWAY_DEVICE_KEY="$seed" \
  WEALD_AGENT_GATEWAY_DATABASE_URL="$control_url" \
  WEALD_AGENT_GATEWAY_STATE="$work/mls.sqlite" \
  WEALD_AGENT_WORKER_URL="127.0.0.1:$worker_port" \
  WEALD_AGENT_WORKER_CLIENT_CERT="$(cat "$work/pki/client.pem")" \
    nohup "$ROOT/target/debug/weald-agent-gateway" >"$work/gateway.log" 2>&1 &
  local gateway_pid=$!

  org_crossing_stop() {
    kill "$gateway_pid" "$worker_pid" 2>/dev/null || true
    wait "$gateway_pid" 2>/dev/null || true
    wait "$worker_pid" 2>/dev/null || true
  }

  # The key package, which the gateway publishes on the way up. Waiting for it is how
  # this knows the process is alive without asking it.
  local waited=0 package=""
  while [ "$waited" -lt 120 ]; do
    # `|| true` because this file runs under `set -eo pipefail`: the table does not
    # exist until the gateway has migrated it, and a psql that failed for that
    # ordinary reason would end the run with no message at all.
    package="$(docker exec -i "$(dc ps -q postgres)" psql -U weald -d "$control_db" -tAc \
      "select encode(key_package,'hex') from agent_gateway_key_package" 2>/dev/null \
      | tr -d '[:space:]' || true)"
    # `if` rather than `[ ... ] && break`: this file runs under `set -e`, where a
    # test that is false as the last command of a loop body exits the script, and
    # the failure would be silent.
    if [ -n "$package" ]; then break; fi
    sleep 1
    waited=$((waited + 1))
  done
  [ -n "$package" ] || {
    echo "weald-stack: the gateway never published a key package" >&2
    tail -20 "$work/gateway.log" >&2
    org_crossing_stop
    exit 1
  }
  python3 -c 'import sys, binascii
open(sys.argv[1], "wb").write(binascii.unhexlify(sys.argv[2]))' \
    "$work/key-package.bin" "$package"
  grep -q "scopes=1" "$work/gateway.log" || {
    # The subscription is what makes the Welcome below reach it: the gateway reads
    # from the moment it connects, so a Welcome published before it subscribed is a
    # Welcome it never sees.
    waited=0
    while [ "$waited" -lt 90 ] && ! grep -q "scopes=1" "$work/gateway.log"; do
      sleep 1; waited=$((waited + 1))
    done
  }
  grep -q "scopes=1" "$work/gateway.log" || {
    echo "weald-stack: the gateway never subscribed to the channel" >&2
    tail -30 "$work/gateway.log" >&2
    org_crossing_stop
    exit 1
  }

  # The admission. A person is welcomed by an admin and a user agent's leaf is added
  # by the device that issued its certificate; a gateway is neither, and this verb is
  # the path a member's Mac has to admit one.
  local admit_out
  admit_out="$(wc_ c1 agent-org-admit --alias "$alias" --fingerprint "$principal" \
    --secrets-file "$work/key-package.bin")" || {
    echo "weald-stack: c1 could not admit the gateway" >&2
    org_crossing_stop
    exit 1
  }
  { echo; echo "## c1 admits the gateway"; echo "$admit_out"; } | tee -a "$out"
  [ "$(field "$admit_out" welcome)" = "1" ] || {
    echo "weald-stack: the welcome was not published" >&2
    org_crossing_stop
    exit 1
  }

  # The card, delivered. The gateway signs its hosted cards into the control plane
  # (`hosting::reconcile`) and is deliberately not a member of the workspace root
  # group, which is where every client reads cards from, so the admin's own device
  # publishes the signed bytes. Without this a mention of an organization agent
  # resolves to nothing on a real client and there is nothing to disclose.
  local card_hex=""
  waited=0
  while [ "$waited" -lt 90 ]; do
    card_hex="$(docker exec -i "$(dc ps -q postgres)" psql -U weald -d "$control_db" -tAc \
      "select encode(card,'hex') from agent_hosted_card" 2>/dev/null | tr -d '[:space:]' || true)"
    if [ -n "$card_hex" ]; then break; fi
    sleep 1
    waited=$((waited + 1))
  done
  [ -n "$card_hex" ] || {
    echo "weald-stack: the gateway published no hosted card" >&2
    org_crossing_stop
    exit 1
  }
  python3 -c 'import sys, binascii
open(sys.argv[1], "wb").write(binascii.unhexlify(sys.argv[2]))' \
    "$work/agent-card.bin" "$card_hex"
  local card_out
  card_out="$(wc_ c1 agent-org-card --secrets-file "$work/agent-card.bin")" || {
    echo "weald-stack: c1 could not publish the organization card" >&2
    org_crossing_stop
    exit 1
  }
  { echo; echo "## c1 publishes the gateway's card"; echo "$card_out"; } | tee -a "$out"
  wc_ c1 --seconds 10 sync >/dev/null 2>&1 || true
  wc_ c2 --seconds 10 sync >/dev/null 2>&1 || true

  # What c2 is shown before it may invoke at all. Step 13: the client discloses the
  # organization, region, provider, model, retention and cost policy and the
  # capabilities before a first invocation, and declining leaves the mention as
  # text. Both answers are driven here, in that order, so the run proves the
  # refusal as well as the acceptance rather than only the path that continues.
  local declined_out
  declined_out="$(wc_ c2 agent-disclosure --alias "$alias" --scope-group "$group" --state decline)" || {
    echo "weald-stack: c2 was never shown a disclosure for $alias" >&2
    org_crossing_stop
    exit 1
  }
  { echo; echo "## c2 is shown the disclosure and declines"; echo "$declined_out"; } | tee -a "$out"
  [ -z "$(field "$declined_out" invocable)" ] || {
    echo "weald-stack: a declined disclosure still left the mention invocable" >&2
    org_crossing_stop
    exit 1
  }
  local accepted_out
  accepted_out="$(wc_ c2 agent-disclosure --alias "$alias" --scope-group "$group" --state accept)" || {
    echo "weald-stack: c2 could not accept the disclosure" >&2
    org_crossing_stop
    exit 1
  }
  { echo; echo "## c2 accepts"; echo "$accepted_out"; } | tee -a "$out"
  [ "$(field "$accepted_out" invocable)" = "$alias" ] || {
    echo "weald-stack: an accepted disclosure did not make the mention invocable" >&2
    org_crossing_stop
    exit 1
  }
  [ -n "$(field "$accepted_out" provider)" ] && [ -n "$(field "$accepted_out" model)" ] || {
    echo "weald-stack: the disclosure named no provider or model" >&2
    org_crossing_stop
    exit 1
  }

  # Player 2 mentions the agent. The word in the question is what makes the answer
  # checkable from the transcript rather than judged.
  local token="BOROUGH$nonce"
  local invoke_out
  # Phrased as a question with the code in it, because the two shorter forms both
  # failed for reasons that were not the product's. "include the word BOROUGH74e8"
  # got BOROUGH with the hex dropped; "reply with exactly this token and nothing
  # else" got a refusal, because an agent whose system prompt tells it to answer
  # questions in a channel is right to decline being used as an echo. The token is
  # still unique per run, so the check still proves this answer came back from this
  # run's real provider call.
  invoke_out="$(wc_ c2 agent-invoke --alias "$alias" \
    --body "@$alias In one short sentence, tell me the reference code for this thread, which is $token, quoted exactly as written.")" || {
    echo "weald-stack: c2 could not publish the invoke" >&2
    org_crossing_stop
    exit 1
  }
  { echo; echo "## c2 invokes"; echo "$invoke_out"; } | tee -a "$out"
  [ "$(field "$invoke_out" requester)" = "$d2" ] || {
    echo "weald-stack: the invoke was not authored by c2" >&2
    org_crossing_stop
    exit 1
  }
  [ "$(field "$invoke_out" agent)" = "$agent" ] || {
    echo "weald-stack: c2 addressed $(field "$invoke_out" agent), the control plane hosts $agent" >&2
    org_crossing_stop
    exit 1
  }

  # The gateway's own account of what it did, from its log, while both clients sync.
  waited=0
  while [ "$waited" -lt 180 ] && ! grep -q "answered outcome=Answered" "$work/gateway.log"; do
    wc_ c1 --seconds 5 sync >/dev/null 2>&1 || true
    wc_ c2 --seconds 5 sync >/dev/null 2>&1 || true
    waited=$((waited + 5))
  done
  grep -q "answered outcome=Answered" "$work/gateway.log" || {
    echo "weald-stack: the gateway never answered" >&2
    tail -40 "$work/gateway.log" >&2
    org_crossing_stop
    exit 1
  }
  { echo; echo "## the gateway"; grep -E "^(received|answered|published)" "$work/gateway.log"; } \
    | tee -a "$out"

  { echo; echo "## both sync"; wc_ c1 --seconds 30 sync; wc_ c2 --seconds 30 sync; } \
    >>"$out" 2>&1

  # Both players fold. The assertion is convergence: one state, one digest, one
  # answer, authored by neither person's device.
  #
  # Synced until c1 can fold rather than once: the gateway logs `answered` when it
  # has built the records and drains its outbox after, so a fold that ran the
  # moment the log line appeared could reach a channel holding the answer and not
  # yet the `completed` that names it. That is a race in this harness and not a
  # product defect, so it is waited out here rather than papered over in the fold.
  local a1 a2 folded=0
  while [ "$folded" -lt 12 ]; do
    if a1="$(wc_ c1 agent-answer --alias "$alias" 2>/dev/null)"; then break; fi
    wc_ c1 --seconds 10 sync >/dev/null 2>&1 || true
    folded=$((folded + 1))
  done
  a1="$(wc_ c1 agent-answer --alias "$alias")" || {
    echo "weald-stack: c1 could not fold the answer" >&2; org_crossing_stop; exit 1; }
  folded=0
  while [ "$folded" -lt 12 ]; do
    if a2="$(wc_ c2 agent-answer --alias "$alias" 2>/dev/null)"; then break; fi
    wc_ c2 --seconds 10 sync >/dev/null 2>&1 || true
    folded=$((folded + 1))
  done
  a2="$(wc_ c2 agent-answer --alias "$alias")" || {
    echo "weald-stack: c2 could not fold the answer" >&2; org_crossing_stop; exit 1; }
  { echo; echo "## c1 folds"; echo "$a1"; echo; echo "## c2 folds"; echo "$a2"; } | tee -a "$out"

  local key
  for key in verified state digest answerAuthor anomalies answerText; do
    [ "$(field "$a1" "$key")" = "$(field "$a2" "$key")" ] || {
      echo "weald-stack: the two players disagree on $key" >&2
      echo "  c1 $(field "$a1" "$key")" >&2
      echo "  c2 $(field "$a2" "$key")" >&2
      org_crossing_stop
      exit 1
    }
  done
  [ "$(field "$a1" verified)" = "yes" ] || {
    echo "weald-stack: the answer did not verify" >&2; org_crossing_stop; exit 1; }
  [ "$(field "$a1" state)" = "completed" ] || {
    echo "weald-stack: folded state $(field "$a1" state)" >&2; org_crossing_stop; exit 1; }
  [ "$(field "$a1" anomalies)" = "0" ] || {
    echo "weald-stack: $(field "$a1" anomalies) anomalies" >&2; org_crossing_stop; exit 1; }
  local author; author="$(field "$a1" answerAuthor)"
  [ "$author" = "$principal" ] || {
    echo "weald-stack: the answer was authored by $author, not by the gateway" >&2
    org_crossing_stop; exit 1; }
  [ "$author" != "$d1" ] && [ "$author" != "$d2" ] || {
    echo "weald-stack: the answer was authored by a person's device key" >&2
    org_crossing_stop; exit 1; }
  # Case folded, because what the token proves is provenance: this answer came back
  # from this run's real provider call for this run's question, and a model that
  # answered in capitals has still proven it. The value is unique per run, so a
  # looser comparison cannot pass on a stale answer.
  local answer_folded token_folded
  answer_folded="$(tr '[:upper:]' '[:lower:]' <<< "$(field "$a1" answerText)")"
  token_folded="$(tr '[:upper:]' '[:lower:]' <<< "$token")"
  case "$answer_folded" in
    *"$token_folded"*) : ;;
    *) echo "weald-stack: the answer does not carry the token the member asked for" >&2
       org_crossing_stop; exit 1 ;;
  esac

  {
    echo
    echo "## the comparison"
    echo "invoked      by c2 $d2"
    echo "hosted       by the gateway $principal, on no Mac"
    echo "answered     $(field "$a1" state) anomalies=$(field "$a1" anomalies)"
    echo "digest       c1 $(field "$a1" digest)  c2 $(field "$a2" digest)"
    echo "answerAuthor $author  (the gateway, not $d1 and not $d2)"
    echo "answerText   $(field "$a1" answerText)"
    echo "token        $token present in the answer"
    echo "provider     real, sealed in $control_db and opened only by the worker"
  } | tee -a "$out"

  org_crossing_stop
  # The scratch control plane is this run's and nothing else reads it.
  docker exec -i "$(dc ps -q postgres)" dropdb -U weald --if-exists "$control_db" >/dev/null 2>&1 || true
  rm -rf "$work"

  echo "answered=gateway"
  echo "converged=c1,c2"
}

cmd_agent_availability_gateway() {
  local out_dir="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-21}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out_dir="$2"; shift 2 ;;
      *) echo "weald-stack agent-availability-gateway: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$out_dir"
  local out="$out_dir/gateway-availability.txt"

  # The provider credential, from this Mac's login Keychain, exported to the seeder
  # and to nothing else. This scenario never calls a provider - a beat is not an
  # invocation - but the control plane's schema holds a sealed credential per agent and
  # the seeder is the only thing that writes one, so the same real key is required to
  # seed the same real row. Never written to the tree, never printed, and absent is a
  # failure rather than a skip (`production-only.md`).
  local provider_key
  provider_key="$(/usr/bin/security find-generic-password -s com.dicyanin.weald \
    -a openrouter-api-key -w 2>/dev/null || true)"
  [ -n "$provider_key" ] || {
    echo "weald-stack: no OpenRouter key in the Keychain. This crossing reaches the" >&2
    echo "real vendor and there is no test mode." >&2
    exit 1
  }

  local nonce; nonce="$(python3 -c 'import os; print(os.urandom(4).hex())')"
  local alias="reviewer-ga$nonce"
  local work; work="$STACK_STATE/gateway-availability-$nonce"
  mkdir -p "$work/pki"

  cmd_clients 2 --selections relay,relay --fresh >/dev/null

  local d1 d2
  d1="$(field "$(wc_ c1 device)" device)"
  d2="$(field "$(wc_ c2 device)" device)"
  [ -n "$d1" ] && [ "$d1" != "$d2" ] || {
    echo "weald-stack: the two clients share a device key, so this is one player twice" >&2
    exit 1
  }

  # The channel's real group id, from the client that is a member of it rather than
  # from a bash reimplementation of `GroupID.derive`.
  local group; group="$(field "$(wc_ c1 agent-members)" group)"
  [ -n "$group" ] || { echo "weald-stack: c1 named no group" >&2; exit 1; }

  {
    echo "# A gateway beats for the organization agent it hosts, and a member sees the ring"
    echo
    echo "workspace $(cat "$CLIENTS_DIR/workspace-id")"
    echo "relay     $(relay_ws_url)"
    echo "alias     $alias"
    echo "group     $group"
    echo "c1 device $d1"
    echo "c2 device $d2"
  } | tee "$out"

  # The gateway's key, and its principal before the process exists. The admin has to
  # admit it to the workspace access set first: a principal the access set does not
  # name cannot open a relay session at all, so a gateway started before this would
  # exit on its first connect.
  local seed principal
  seed="$(python3 -c 'import os; print(os.urandom(32).hex())')"
  principal="$(field "$(cargo run -q -p weald-agent-gateway --example principal_of -- "$seed")" principal)"
  [ -n "$principal" ] || { echo "weald-stack: could not derive the gateway principal" >&2; exit 1; }
  wc_ c1 admit --device "$principal" >>"$out" 2>&1 || {
    echo "weald-stack: the admin could not admit the gateway to the access set" >&2
    tail -20 "$out" >&2
    exit 1
  }

  # The control plane, as step 13's console will leave it: the agent, the channel it
  # is assigned to, the roster of members who may invoke it, one sealed credential
  # and the run's mutual TLS material.
  local control_db="weald_agents_ga_$nonce"
  docker exec -i "$(dc ps -q postgres)" createdb -U weald "$control_db" >/dev/null 2>&1 || true
  local control_url="postgres://weald:weald@127.0.0.1:$WEALD_STACK_PG_PORT/$control_db"
  local seeded
  seeded="$(WEALD_LLM_OPENROUTER_KEY="$provider_key" cargo run -q -p weald-agent-worker \
    --example org_crossing_seed -- \
    --database "$control_url" --alias "$alias" --scope "$group" \
    --member "$d1" --member "$d2" --pki "$work/pki" \
    --model "${WEALD_AGENT_CROSSING_MODEL:-anthropic/claude-haiku-4.5}")" || {
    echo "weald-stack: seeding the control plane failed" >&2
    exit 1
  }
  local agent kek
  agent="$(field "$seeded" agent)"
  kek="$(field "$seeded" kek)"
  { echo; echo "## the control plane"; echo "agent $agent"; echo "database $control_db"; } \
    | tee -a "$out"

  # The worker. A separate process, mutually authenticated, holding the credential
  # this gateway cannot open: the architecture's whole point is that the process with
  # the plaintext conversation is not the process that can call a vendor.
  local worker_port; worker_port="$(python3 -c '
import socket
s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')"
  cargo build -q -p weald-agent-worker --bin weald-agent-worker || {
    echo "weald-stack: the worker did not build" >&2; exit 1; }
  WEALD_AGENT_WORKER_LISTEN="127.0.0.1:$worker_port" \
  WEALD_AGENT_WORKER_SERVER_CERT="$(cat "$work/pki/server.pem")" \
  WEALD_AGENT_WORKER_CLIENT_CA="$(cat "$work/pki/ca.pem")" \
  WEALD_AGENT_WORKER_KEK="$kek" \
  WEALD_AGENT_WORKER_DATABASE_URL="$control_url" \
    nohup "$ROOT/target/debug/weald-agent-worker" >"$work/worker.log" 2>&1 &
  local worker_pid=$!

  # The gateway. Its assignment is already in the database, so it subscribes on its
  # first pass rather than on a reload.
  cargo build -q -p weald-agent-gateway --bin weald-agent-gateway || {
    echo "weald-stack: the gateway did not build" >&2; kill "$worker_pid" 2>/dev/null; exit 1; }
  local gateway_port; gateway_port="$(python3 -c '
import socket
s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')"
  # A file path and not a directory: `config.rs` calls this the MLS state database.
  WEALD_AGENT_GATEWAY_LISTEN="127.0.0.1:$gateway_port" \
  WEALD_AGENT_GATEWAY_RELAY_URL="127.0.0.1:$WEALD_STACK_RELAY_PORT" \
  WEALD_AGENT_GATEWAY_DEVICE_KEY="$seed" \
  WEALD_AGENT_GATEWAY_DATABASE_URL="$control_url" \
  WEALD_AGENT_GATEWAY_STATE="$work/mls.sqlite" \
  WEALD_AGENT_WORKER_URL="127.0.0.1:$worker_port" \
  WEALD_AGENT_WORKER_CLIENT_CERT="$(cat "$work/pki/client.pem")" \
    nohup "$ROOT/target/debug/weald-agent-gateway" >"$work/gateway.log" 2>&1 &
  local gateway_pid=$!

  gateway_availability_stop() {
    kill "$gateway_pid" "$worker_pid" 2>/dev/null || true
    wait "$gateway_pid" 2>/dev/null || true
    wait "$worker_pid" 2>/dev/null || true
  }

  # The key package, which the gateway publishes on the way up. Waiting for it is how
  # this knows the process is alive without asking it.
  local waited=0 package=""
  while [ "$waited" -lt 120 ]; do
    # `|| true` because this file runs under `set -eo pipefail`: the table does not
    # exist until the gateway has migrated it, and a psql that failed for that
    # ordinary reason would end the run with no message at all.
    package="$(docker exec -i "$(dc ps -q postgres)" psql -U weald -d "$control_db" -tAc \
      "select encode(key_package,'hex') from agent_gateway_key_package" 2>/dev/null \
      | tr -d '[:space:]' || true)"
    # `if` rather than `[ ... ] && break`: this file runs under `set -e`, where a
    # test that is false as the last command of a loop body exits the script, and
    # the failure would be silent.
    if [ -n "$package" ]; then break; fi
    sleep 1
    waited=$((waited + 1))
  done
  [ -n "$package" ] || {
    echo "weald-stack: the gateway never published a key package" >&2
    tail -20 "$work/gateway.log" >&2
    gateway_availability_stop
    exit 1
  }
  python3 -c 'import sys, binascii
open(sys.argv[1], "wb").write(binascii.unhexlify(sys.argv[2]))' \
    "$work/key-package.bin" "$package"
  grep -q "scopes=1" "$work/gateway.log" || {
    # The subscription is what makes the Welcome below reach it: the gateway reads
    # from the moment it connects, so a Welcome published before it subscribed is a
    # Welcome it never sees.
    waited=0
    while [ "$waited" -lt 90 ] && ! grep -q "scopes=1" "$work/gateway.log"; do
      sleep 1; waited=$((waited + 1))
    done
  }
  grep -q "scopes=1" "$work/gateway.log" || {
    echo "weald-stack: the gateway never subscribed to the channel" >&2
    tail -30 "$work/gateway.log" >&2
    gateway_availability_stop
    exit 1
  }

  # The admission. A person is welcomed by an admin and a user agent's leaf is added
  # by the device that issued its certificate; a gateway is neither, and this verb is
  # the path a member's Mac has to admit one.
  local admit_out
  admit_out="$(wc_ c1 agent-org-admit --alias "$alias" --fingerprint "$principal" \
    --secrets-file "$work/key-package.bin")" || {
    echo "weald-stack: c1 could not admit the gateway" >&2
    gateway_availability_stop
    exit 1
  }
  { echo; echo "## c1 admits the gateway"; echo "$admit_out"; } | tee -a "$out"
  [ "$(field "$admit_out" welcome)" = "1" ] || {
    echo "weald-stack: the welcome was not published" >&2
    gateway_availability_stop
    exit 1
  }

  # The card, delivered. The gateway signs its hosted cards into the control plane
  # (`hosting::reconcile`) and is deliberately not a member of the workspace root
  # group, which is where every client reads cards from, so the admin's own device
  # publishes the signed bytes. Without this a mention of an organization agent
  # resolves to nothing on a real client and there is nothing to disclose.
  local card_hex=""
  waited=0
  while [ "$waited" -lt 90 ]; do
    card_hex="$(docker exec -i "$(dc ps -q postgres)" psql -U weald -d "$control_db" -tAc \
      "select encode(card,'hex') from agent_hosted_card" 2>/dev/null | tr -d '[:space:]' || true)"
    if [ -n "$card_hex" ]; then break; fi
    sleep 1
    waited=$((waited + 1))
  done
  [ -n "$card_hex" ] || {
    echo "weald-stack: the gateway published no hosted card" >&2
    gateway_availability_stop
    exit 1
  }
  python3 -c 'import sys, binascii
open(sys.argv[1], "wb").write(binascii.unhexlify(sys.argv[2]))' \
    "$work/agent-card.bin" "$card_hex"
  local card_out
  card_out="$(wc_ c1 agent-org-card --secrets-file "$work/agent-card.bin")" || {
    echo "weald-stack: c1 could not publish the organization card" >&2
    gateway_availability_stop
    exit 1
  }
  { echo; echo "## c1 publishes the gateway's card"; echo "$card_out"; } | tee -a "$out"
  wc_ c1 --seconds 10 sync >/dev/null 2>&1 || true
  wc_ c2 --seconds 10 sync >/dev/null 2>&1 || true


  # What this scenario exists for: the gateway's own beat. It is a member of the access
  # set in its own right, so its beat is a signed claim by a member exactly like a
  # human's, and `availability.rs` is where it is built. The gateway beats on the
  # twenty second cadence and immediately on the first pass, so a reader that opened a
  # session before it is guaranteed one inside that interval.
  local live_log="$out_dir/gateway-seen.txt"
  ( wc_ c2 --seconds 40 agent-availability --alias "$alias" >"$live_log" 2>&1 ) &
  local watcher=$!
  wait "$watcher" || {
    echo "weald-stack: c2 could not read the org agent's availability" >&2
    cat "$live_log" >&2
    gateway_availability_stop
    exit 1
  }
  local live; live="$(cat "$live_log")"
  { echo; echo "## what c2 sees while the gateway is up"; echo "$live"; } | tee -a "$out"
  { echo; echo "## the gateway's own account";
    grep -E "^availability" "$work/gateway.log" | tail -5; } | tee -a "$out"

  grep -qE "^availability beats=[1-9]" "$work/gateway.log" || {
    echo "weald-stack: the gateway never beat for the agent it hosts" >&2
    tail -30 "$work/gateway.log" >&2
    gateway_availability_stop
    exit 1
  }
  [ "$(field "$live" folded)" -ge 1 ] || {
    echo "weald-stack: c2 folded none of the gateway's beats" >&2
    gateway_availability_stop
    exit 1
  }
  [ "$(field "$live" state)" = "active" ] || {
    echo "weald-stack: c2 shows the org agent as '$(field "$live" state)'" >&2
    gateway_availability_stop
    exit 1
  }
  [ "$(field "$live" accepts)" = "yes" ] || {
    echo "weald-stack: c2 would refuse an invoke to an org agent whose gateway is up" >&2
    gateway_availability_stop
    exit 1
  }
  # The gateway stops. Nothing is sent on the way out, and the ring goes dark on the
  # claim's own TTL, which is the same rule a Mac host is held to.
  gateway_availability_stop
  local away
  away="$(wc_ c2 --seconds 6 agent-availability --alias "$alias")" || {
    echo "weald-stack: c2 could not read the availability after the gateway stopped" >&2
    exit 1
  }
  { echo; echo "## what c2 sees after the gateway stops"; echo "$away"; } | tee -a "$out"
  [ "$(field "$away" state)" = "offline" ] || {
    echo "weald-stack: a stopped gateway still shows '$(field "$away" state)'" >&2
    exit 1
  }
  [ "$(field "$away" accepts)" = "no" ] || {
    echo "weald-stack: c2 would still compose an invoke to a stopped gateway" >&2
    exit 1
  }

  {
    echo
    echo "## the comparison"
    echo "gateway    $principal, a member of the access set in its own right"
    echo "hosted     $agent, on no Mac"
    echo "beats      $(grep -cE '^availability beats=' "$work/gateway.log") pass(es) logged"
    echo "seen       state=$(field "$live" state) folded=$(field "$live" folded) \
accepts=$(field "$live" accepts)"
    echo "stopped    state=$(field "$away" state) accepts=$(field "$away" accepts)"
  } | tee -a "$out"

  docker exec -i "$(dc ps -q postgres)" dropdb -U weald --if-exists "$control_db" >/dev/null 2>&1 || true
  rm -rf "$work"

  echo "beaten=gateway"
  echo "offline=after-stop"
}

# Step 14's crossing: one composed message produces exactly one invoke per resolved
# agent, an ordinary message carrying the same text produces none, and a name two
# agents answer to produces none either.
#
# The three cases are one scenario rather than three, because the only thing that makes
# the negative worth anything is that it runs against the same directory, the same
# alias and the same text as the positive. A negative proved in a workspace where the
# alias resolved to nothing would be a proof that nothing happens when nothing was
# asked for.
#
# The ambiguity is c2's own local bot against c1's published card, which is the
# same-slug case in the form it actually reaches people: not a stranger's forgery, but
# two people who both called a bot `researcher`. c2's own card would not do, because a
# device's own published agent is answered locally by construction (see
# `AgentMentionResolution`), so it would produce one candidate and prove nothing.
cmd_agent_mention_crossing() {
  local out_dir="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-14}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out_dir="$2"; shift 2 ;;
      *) echo "weald-stack agent-mention-crossing: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$out_dir"
  local out="$out_dir/mention-crossing.txt"

  local nonce; nonce="$(python3 -c 'import os; print(os.urandom(4).hex())')"
  local alias="researcher-mn$nonce"

  cmd_clients 2 --selections relay,relay --fresh >/dev/null

  local d1 d2
  d1="$(field "$(wc_ c1 device)" device)"
  d2="$(field "$(wc_ c2 device)" device)"
  [ -n "$d1" ] && [ "$d1" != "$d2" ] || {
    echo "weald-stack: the two clients share a device key, so this is one player twice" >&2
    exit 1
  }

  {
    echo "# A composed mention emits one invoke; plain text emits none; two agents emit none"
    echo
    echo "workspace $(cat "$CLIENTS_DIR/workspace-id")"
    echo "relay     $(relay_ws_url)"
    echo "alias     $alias"
    echo "c1 device $d1"
    echo "c2 device $d2"
  } | tee "$out"

  # c1 publishes the agent, and both instances sync so c2 resolves against a card that
  # actually crossed rather than one it was handed.
  local card_out
  card_out="$(wc_ c1 agent-publish-card --alias "$alias")" || {
    echo "weald-stack: c1 could not publish its card" >&2; exit 1
  }
  { echo; echo "## c1 publishes the agent"; echo "$card_out"; } | tee -a "$out"
  { echo; echo "## both sync"; wc_ c1 --seconds 30 sync; wc_ c2 --seconds 30 sync; } \
    >>"$out" 2>&1

  # The positive. One message, one resolved agent, one invoke.
  local mention_out
  mention_out="$(wc_ c2 agent-mention --body "@$alias please look at the migration")" || {
    echo "weald-stack: c2 could not send the mention" >&2; exit 1
  }
  { echo; echo "## c2 composes a mention"; echo "$mention_out"; } | tee -a "$out"
  [ "$(field "$mention_out" outcome)" = "sent" ] || {
    echo "weald-stack: c2's mention was '$(field "$mention_out" outcome)', expected sent" >&2
    exit 1
  }
  [ "$(field "$mention_out" messages)" = "1" ] || {
    echo "weald-stack: c2 wrote $(field "$mention_out" messages) messages, expected 1" >&2
    exit 1
  }
  [ "$(field "$mention_out" invokes)" = "1" ] || {
    echo "weald-stack: c2 wrote $(field "$mention_out" invokes) invokes, expected 1" >&2
    exit 1
  }

  { echo; echo "## both sync"; wc_ c1 --seconds 30 sync; wc_ c2 --seconds 30 sync; } \
    >>"$out" 2>&1

  local scan_one
  scan_one="$(wc_ c1 agent-mention-scan --alias "$alias")" || {
    echo "weald-stack: c1 could not scan" >&2; exit 1
  }
  { echo; echo "## what c1 holds after the mention"; echo "$scan_one"; } | tee -a "$out"
  [ "$(field "$scan_one" invokes)" = "1" ] || {
    echo "weald-stack: c1 holds $(field "$scan_one" invokes) invokes, expected 1" >&2
    exit 1
  }
  [ "$(field "$scan_one" messages)" = "1" ] || {
    echo "weald-stack: c1 holds $(field "$scan_one" messages) messages, expected 1" >&2
    exit 1
  }
  [ "$(field "$scan_one" executions)" = "0" ] || {
    echo "weald-stack: c1 executed $(field "$scan_one" executions) times off a mention" >&2
    exit 1
  }

  # The negative. The same words, sent as ordinary chat.
  local say_out
  say_out="$(wc_ c2 agent-say --body "@$alias just thinking out loud")" || {
    echo "weald-stack: c2 could not send the plain message" >&2; exit 1
  }
  { echo; echo "## c2 sends the same text as ordinary chat"; echo "$say_out"; } | tee -a "$out"
  [ "$(field "$say_out" invokes)" = "0" ] || {
    echo "weald-stack: an ordinary message emitted $(field "$say_out" invokes) invokes" >&2
    exit 1
  }
  [ -n "$(field "$say_out" wouldResolve)" ] || {
    echo "weald-stack: the plain text resolved to nothing, so the negative is vacuous" >&2
    exit 1
  }

  { echo; echo "## both sync"; wc_ c1 --seconds 30 sync; wc_ c2 --seconds 30 sync; } \
    >>"$out" 2>&1

  local scan_two
  scan_two="$(wc_ c1 agent-mention-scan --alias "$alias")" || {
    echo "weald-stack: c1 could not scan after the plain message" >&2; exit 1
  }
  { echo; echo "## what c1 holds after the plain message"; echo "$scan_two"; } | tee -a "$out"
  [ "$(field "$scan_two" messages)" = "2" ] || {
    echo "weald-stack: c1 holds $(field "$scan_two" messages) messages, expected 2" >&2
    exit 1
  }
  [ "$(field "$scan_two" invokes)" = "1" ] || {
    echo "weald-stack: the plain message moved the invoke count to $(field "$scan_two" invokes)" >&2
    exit 1
  }
  [ "$(field "$scan_two" executions)" = "0" ] || {
    echo "weald-stack: c1 executed $(field "$scan_two" executions) times, expected 0" >&2
    exit 1
  }

  # The adversarial. c2 names a local bot of its own with the same slug, so the alias
  # answers to two agents and the composer must ask rather than pick.
  local ambiguous_out status
  set +e
  ambiguous_out="$(wc_ c2 agent-mention --local "$alias" \
    --body "@$alias and now which of you is it" 2>&1)"
  status=$?
  set -e
  { echo; echo "## c2's own bot shares the name"; echo "$ambiguous_out"; } | tee -a "$out"
  [ "$status" -ne 0 ] || {
    echo "weald-stack: an ambiguous mention was sent instead of opening a picker" >&2
    exit 1
  }
  grep -q 'outcome=ambiguous' <<<"$ambiguous_out" || {
    echo "weald-stack: c2 refused the ambiguous mention for the wrong reason" >&2
    exit 1
  }

  { echo; echo "## both sync"; wc_ c1 --seconds 30 sync; wc_ c2 --seconds 30 sync; } \
    >>"$out" 2>&1

  local scan_three
  scan_three="$(wc_ c1 agent-mention-scan --alias "$alias")" || {
    echo "weald-stack: c1 could not scan after the ambiguous mention" >&2; exit 1
  }
  { echo; echo "## what c1 holds after the ambiguous mention"; echo "$scan_three"; } \
    | tee -a "$out"
  [ "$(field "$scan_three" invokes)" = "1" ] || {
    echo "weald-stack: the ambiguous mention emitted an invoke" >&2; exit 1
  }
  [ "$(field "$scan_three" messages)" = "2" ] || {
    echo "weald-stack: the ambiguous mention wrote a message" >&2; exit 1
  }
  [ "$(field "$scan_three" executions)" = "0" ] || {
    echo "weald-stack: c1 executed $(field "$scan_three" executions) times, expected 0" >&2
    exit 1
  }

  {
    echo
    echo "## the comparison"
    echo "composed   1 message, $(field "$mention_out" invokes) invoke"
    echo "pairs      $(field "$mention_out" pairs)"
    echo "plaintext  1 message, $(field "$say_out" invokes) invokes"
    echo "ambiguous  0 messages, 0 invokes, picker opened"
    echo "received   messages=$(field "$scan_three" messages) invokes=$(field "$scan_three" invokes)"
    echo "executions $(field "$scan_three" executions)"
  } | tee -a "$out"

  echo "emitted=1"
  echo "executions=0"
}

# Step 15's crossing: the host goes away mid-invocation, the requester sees a state
# with a deadline rather than a spinner, and the two converge once the host is back.
#
# "Quits" is modelled by the host's lease lapsing, which is what a quit actually looks
# like from the other side: a Mac that stopped republishing. The lease is given two
# seconds and nothing sleeps waiting for it; the syncs either side take longer than
# that on their own, so the lapse is real elapsed time rather than a guessed interval.
# `agent-status` explains why a lease is the availability source until step 21 gives
# presence a beat of its own.
cmd_agent_offline_crossing() {
  local out_dir="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-15}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out_dir="$2"; shift 2 ;;
      *) echo "weald-stack agent-offline-crossing: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$out_dir"
  local out="$out_dir/offline-crossing.txt"

  local nonce; nonce="$(python3 -c 'import os; print(os.urandom(4).hex())')"
  local alias="researcher-of$nonce"

  cmd_clients 2 --selections relay,relay --fresh >/dev/null

  local d1 d2
  d1="$(field "$(wc_ c1 device)" device)"
  d2="$(field "$(wc_ c2 device)" device)"
  [ -n "$d1" ] && [ "$d1" != "$d2" ] || {
    echo "weald-stack: the two clients share a device key, so this is one player twice" >&2
    exit 1
  }

  {
    echo "# The host goes away mid-invocation and comes back; the requester never spins"
    echo
    echo "workspace $(cat "$CLIENTS_DIR/workspace-id")"
    echo "relay     $(relay_ws_url)"
    echo "alias     $alias"
    echo "c1 device $d1"
    echo "c2 device $d2"
  } | tee "$out"

  # c1 owns the agent and is alive: a certificate, a leaf, and a lease that will lapse
  # while the rest of this runs.
  local leaf_out lease_out
  leaf_out="$(wc_ c1 agent-leaf --alias "$alias" --seconds 3600)" || {
    echo "weald-stack: c1 could not issue the agent's certificate" >&2; exit 1
  }
  lease_out="$(wc_ c1 agent-lease --alias "$alias" --seconds 1 --ttl 2)" || {
    echo "weald-stack: c1 could not publish its lease" >&2; exit 1
  }
  { echo; echo "## c1 owns the agent and is alive"; echo "$leaf_out"; echo "$lease_out"; } \
    | tee -a "$out"

  local invoke_out
  invoke_out="$(wc_ c2 agent-invoke --alias "$alias" --id WEALD-915)" || {
    echo "weald-stack: c2 could not publish the invoke" >&2; exit 1
  }
  { echo; echo "## c2 invokes"; echo "$invoke_out"; } | tee -a "$out"

  { echo; echo "## both sync"; wc_ c1 --seconds 30 sync; wc_ c2 --seconds 30 sync; } \
    >>"$out" 2>&1

  # c1 is gone. Its lease has lapsed by now: the two syncs above take longer than the
  # two seconds it was given, and nothing here slept to arrange that.
  local away
  away="$(wc_ c2 agent-status --alias "$alias")" || {
    echo "weald-stack: c2 could not read the status" >&2; exit 1
  }
  { echo; echo "## what c2 sees while c1 is away"; echo "$away"; } | tee -a "$out"
  [ "$(field "$away" phase)" = "queued-offline" ] || {
    echo "weald-stack: c2 shows '$(field "$away" phase)', expected queued-offline" >&2
    exit 1
  }
  [ -n "$(field "$away" deadline)" ] || {
    echo "weald-stack: the queued state carried no deadline, which is the spinner" >&2
    exit 1
  }
  [ "$(field "$away" deadline)" = "$(field "$away" invokeDeadline)" ] || {
    echo "weald-stack: the displayed deadline is not the one the requester signed" >&2
    exit 1
  }
  [ "$(field "$away" terminal)" = "no" ] || {
    echo "weald-stack: a queued invocation reported itself terminal" >&2; exit 1
  }
  [ "$(field "$away" online)" = "no" ] || {
    echo "weald-stack: c2 thinks the host is still up, so this proves nothing" >&2; exit 1
  }
  [ "$(field "$away" records)" = "0" ] || {
    echo "weald-stack: the relay produced $(field "$away" records) lifecycle records" >&2
    echo "for an invocation nobody executed. The relay does not execute." >&2
    exit 1
  }

  # c1 comes back: a fresh lease at a higher epoch, then it executes.
  local back_out c1_exec
  back_out="$(wc_ c1 agent-lease --alias "$alias" --seconds 2 --ttl 600)" || {
    echo "weald-stack: c1 could not republish its lease" >&2; exit 1
  }
  c1_exec="$(wc_ c1 agent-execute --alias "$alias" --body "back, and here is the answer")" || {
    echo "weald-stack: c1 could not execute after returning" >&2; exit 1
  }
  { echo; echo "## c1 comes back"; echo "$back_out"; echo "$c1_exec"; } | tee -a "$out"
  [ "$(field "$c1_exec" outcome)" = "completed" ] || {
    echo "weald-stack: c1 finished as '$(field "$c1_exec" outcome)'" >&2; exit 1
  }

  { echo; echo "## both sync"; wc_ c1 --seconds 30 sync; wc_ c2 --seconds 30 sync; } \
    >>"$out" 2>&1

  local settled c1_view
  settled="$(wc_ c2 agent-status --alias "$alias")" || {
    echo "weald-stack: c2 could not read the settled status" >&2; exit 1
  }
  c1_view="$(wc_ c1 agent-status --alias "$alias")" || {
    echo "weald-stack: c1 could not read its own status" >&2; exit 1
  }
  { echo; echo "## what both see afterwards"; echo "$settled"; echo; echo "$c1_view"; } \
    | tee -a "$out"
  [ "$(field "$settled" phase)" = "completed" ] || {
    echo "weald-stack: c2 shows '$(field "$settled" phase)' after the host returned" >&2
    exit 1
  }
  [ "$(field "$settled" terminal)" = "yes" ] || {
    echo "weald-stack: a completed invocation did not report itself terminal" >&2; exit 1
  }
  [ -z "$(field "$settled" deadline)" ] || {
    echo "weald-stack: a completed invocation is still counting down" >&2; exit 1
  }
  [ "$(field "$settled" responder)" = "$d1" ] || {
    echo "weald-stack: c2 attributes the answer to $(field "$settled" responder), not c1" >&2
    exit 1
  }
  [ "$(field "$settled" anomalies)" = "0" ] || {
    echo "weald-stack: c2 folded $(field "$settled" anomalies) anomalies" >&2; exit 1
  }
  # Convergence is the digest and not the word: two clients agreeing that something
  # completed while holding different record sets is not agreement.
  [ "$(field "$settled" digest)" = "$(field "$c1_view" digest)" ] || {
    echo "weald-stack: the two instances folded different states" >&2; exit 1
  }

  {
    echo
    echo "## the comparison"
    echo "away       phase=$(field "$away" phase) deadline=$(field "$away" deadline) \
online=$(field "$away" online) records=$(field "$away" records)"
    echo "affordance $(field "$away" affordances)"
    echo "headline   $(field "$away" headline)"
    echo "detail     $(field "$away" detail)"
    echo "settled    phase=$(field "$settled" phase) terminal=$(field "$settled" terminal)"
    echo "responder  $(field "$settled" responder)"
    echo "digest     $(field "$settled" digest)"
    echo "converged  c1 and c2 folded one digest"
  } | tee -a "$out"

  echo "queued=offline"
  echo "converged=yes"
}

# Step 21's crossing: a host beats for its agent, the other player sees the ring,
# the host quits, and the ring goes out inside the TTL while the composer refuses
# with a reason and a deadline instead of spinning.
#
# "Quits" is modelled by not beating again, which is what a quit actually is here:
# a `LIVE` claim carries a TTL and the receiver expires it, so a closing lid never
# gets to send a farewell and absence has to be the signal. Nothing sleeps for two
# minutes to prove it either: the beat is sent with a short `--ttl`, which is the
# sender's own field, and the receiver's clamp is only an upper bound. The clamp
# itself is proven in `AgentAvailabilityTests`, where a claim of a year is bounded
# to two minutes without a two minute wait.
#
# Three things are asserted that a happy path would not show: the forged beat from
# a member who is not the host is dropped at the far side, the relay stored no row
# for any of it, and the composer's refusal names `hostOffline` and carries the
# deadline the requester signed rather than one this harness made up.
cmd_agent_availability_crossing() {
  local out_dir="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-21}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out_dir="$2"; shift 2 ;;
      *) echo "weald-stack agent-availability-crossing: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$out_dir"
  local out="$out_dir/availability-crossing.txt"

  local nonce; nonce="$(python3 -c 'import os; print(os.urandom(4).hex())')"
  local alias="researcher-av$nonce"

  # Three players, not two. Player 1 hosts, Player 2 reads, and the third is the
  # forger: a real admitted member of this workspace who does not host this agent. It
  # cannot be Player 2 itself, because two sessions of one device key do not both keep
  # a subscription at the relay and the forgery would be fanned out to nobody, which
  # reads exactly like a refusal and would be a proof of nothing.
  cmd_clients 3 --selections relay,relay,relay --fresh >/dev/null

  local d1 d2 d3
  d1="$(field "$(wc_ c1 device)" device)"
  d2="$(field "$(wc_ c2 device)" device)"
  d3="$(field "$(wc_ c3 device)" device)"
  [ -n "$d1" ] && [ "$d1" != "$d2" ] && [ "$d2" != "$d3" ] && [ "$d1" != "$d3" ] || {
    echo "weald-stack: the clients share a device key, so this is one player repeated" >&2
    exit 1
  }

  local ws; ws="$(cat "$CLIENTS_DIR/workspace-id")"
  {
    echo "# A host beats for its agent, the other player sees it, then it goes dark"
    echo
    echo "workspace $ws"
    echo "relay     $(relay_ws_url)"
    echo "alias     $alias"
    echo "c1 device $d1"
    echo "c2 device $d2"
    echo "c3 device $d3  (the forger)"
  } | tee "$out"

  # The relay's row counts before anything ephemeral happens. A `LIVE` frame is
  # never stored and never sequenced (`specs/backend/relay/presence.md`), so the
  # negative here is a zero delta measured against the real database rather than a
  # promise repeated from the spec.
  local before_envelopes before_bytes
  before_envelopes="$(relay_psql "select count(*) from relay_envelope e join relay_group g \
on g.group_id = e.group_id where g.workspace_id = '$ws'" | tr -d '[:space:]')"
  before_bytes="$(relay_psql "select coalesce(sum(octet_length(ct)),0) from relay_envelope e \
join relay_group g on g.group_id = e.group_id where g.workspace_id = '$ws'" \
    | tr -d '[:space:]')"

  # c1 hosts the agent: a published card, which is what makes c2's `hostFor` answer
  # c1 and therefore what makes every refusal below a refusal about a real agent.
  local card_out
  card_out="$(wc_ c1 agent-publish-card --alias "$alias" --title "Researcher AV$nonce")" || {
    echo "weald-stack: c1 could not publish its card" >&2; exit 1
  }
  { echo; echo "## c1 publishes the card it hosts"; echo "$card_out"; } | tee -a "$out"
  { echo; echo "## all three sync"; wc_ c1 --seconds 30 sync; wc_ c2 --seconds 30 sync; \
    wc_ c3 --seconds 30 sync; } >>"$out" 2>&1

  # c2 asks the agent something, so there is a signed deadline for the refusal to
  # carry. Published before the host goes away, exactly as it happens in the product:
  # a member sends, and the host is gone by the time it lands.
  local invoke_out
  invoke_out="$(wc_ c2 agent-invoke --alias "$alias" --id WEALD-921)" || {
    echo "weald-stack: c2 could not publish the invoke" >&2; exit 1
  }
  { echo; echo "## c2 invokes"; echo "$invoke_out"; } | tee -a "$out"
  { echo; echo "## both sync"; wc_ c1 --seconds 30 sync; wc_ c2 --seconds 30 sync; } \
    >>"$out" 2>&1

  # The live half. c2 watches while c1 beats: the relay fans a `LIVE` out to every
  # *other* subscribed session and never back to the sender, so the reader has to be
  # the other process or the proof would pass with the relay switched off.
  #
  # The reader first, and given time to finish connecting before anything is sent: a
  # `LIVE` is fanned out to the sessions the relay holds at that moment and is never
  # replayed, so a beat published before the reader subscribed reaches nobody and the
  # reader cannot tell that from silence. This is the ordinary shape of the frame and
  # `RelayClientPresenceCLI` documents it for the same reason.
  #
  # The claim's `--ttl` is 110 seconds, just inside the receiver's two minute clamp and
  # longer than the reader's window, because this phase asserts a *live* ring: a claim
  # that expired while the reader was still listening would assert the opposite. The
  # expiry is asserted in its own phase below, where a fresh reader hears nothing at
  # all, and the clamp is asserted with no wait at all in `AgentAvailabilityTests`.
  local beat_log="$out_dir/beat.txt" forged_log="$out_dir/forged.txt"
  local live_log="$out_dir/seen-live.txt"
  ( wc_ c2 --seconds 75 agent-availability --alias "$alias" >"$live_log" 2>&1 ) &
  local watcher=$!
  sleep 12
  # `--seconds 25` and a second attempt, because that flag is also the budget the
  # client waits for its socket in (`withLiveSession`), and a 20 second default lost
  # the session to load when this runs inside the gate beside a build. A connect that
  # took too long is a flake in the harness rather than a fact about the product, and
  # the fix belongs here rather than in a re-run.
  local beat_out=""
  local attempt
  for attempt in 1 2; do
    if beat_out="$(wc_ c1 --seconds 25 --ttl 110 --quiet 3 agent-beat --alias "$alias" \
        --state active 2>&1)"; then
      break
    fi
    echo "weald-stack: c1's beat attempt $attempt did not connect; retrying" >&2
    beat_out=""
  done
  [ -n "$beat_out" ] || {
    echo "weald-stack: c1 could not beat for its own agent" >&2
    kill "$watcher" 2>/dev/null || true
    exit 1
  }
  wait "$watcher" || {
    echo "weald-stack: c2 could not read the availability while its host was beating" >&2
    cat "$live_log" >&2
    exit 1
  }
  local live; live="$(cat "$live_log")"
  {
    echo; echo "## c1 beats"; echo "$beat_out"
    echo; echo "## what c2 saw while c1 was beating"; echo "$live"
  } | tee -a "$out"

  [ "$(field "$beat_out" sent)" -ge 2 ] || {
    echo "weald-stack: c1's beats did not leave the socket" >&2; exit 1
  }
  [ "$(field "$live" state)" = "active" ] || {
    echo "weald-stack: c2 shows the agent as '$(field "$live" state)' while its host beats" >&2
    exit 1
  }
  [ "$(field "$live" accepts)" = "yes" ] || {
    echo "weald-stack: c2 would refuse an invoke to an agent whose host is beating" >&2
    exit 1
  }
  [ "$(field "$live" compose)" = "invoke" ] || {
    echo "weald-stack: c2's composer says '$(field "$live" compose)' for a live agent" >&2
    exit 1
  }
  # The forgery, in its own phase, so it is read by a reader that heard nothing else:
  # a refusal proved in a window that also carried three honest beats could be a
  # refusal of one of those. c2 is a real member of this workspace and is not the host
  # of this agent, and the beat it sends is correctly signed by its own device key,
  # which is what makes this the exact claim the receiver's host rule exists to refuse.
  # Signed by c3's own device key, so nothing about it is malformed: the only thing
  # wrong with it is who is speaking, which is the shape a replay or a hostile member
  # reaches a reader in.
  local agent; agent="$(field "$invoke_out" agent)"
  ( wc_ c2 --seconds 75 agent-availability --alias "$alias" >"$forged_log" 2>&1 ) &
  local forge_watcher=$!
  sleep 12
  local forged_out=""
  for attempt in 1 2; do
    if forged_out="$(wc_ c3 --seconds 25 --ttl 110 agent-beat --fingerprint "$agent" \
        --state away 2>&1)"; then
      break
    fi
    echo "weald-stack: the forged beat attempt $attempt did not connect; retrying" >&2
    forged_out=""
  done
  [ -n "$forged_out" ] || {
    echo "weald-stack: c3 could not send the forged beat, so nothing was refused" >&2
    kill "$forge_watcher" 2>/dev/null || true
    exit 1
  }
  wait "$forge_watcher" || {
    echo "weald-stack: c2 could not read the availability while the forgery was in flight" >&2
    cat "$forged_log" >&2
    exit 1
  }
  local forged_seen; forged_seen="$(cat "$forged_log")"
  {
    echo; echo "## c2 forges a beat for c1's agent"; echo "$forged_out"
    echo; echo "## what c2 makes of the forgery"; echo "$forged_seen"
  } | tee -a "$out"
  [ "$(field "$forged_seen" droppedNotHost)" -ge 1 ] || {
    echo "weald-stack: c2 folded the forged beat, or never received it" >&2
    exit 1
  }
  [ "$(field "$forged_seen" folded)" = "0" ] || {
    echo "weald-stack: c2 folded $(field "$forged_seen" folded) beat(s) it should have refused" >&2
    exit 1
  }
  [ "$(field "$forged_seen" state)" = "offline" ] || {
    echo "weald-stack: a forged beat lit the ring: $(field "$forged_seen" state)" >&2
    exit 1
  }

  # c1 quits. Nothing is sent, and nothing has to be: the claim's own eight seconds
  # run out while c2 watches.
  # A fresh reader, which holds no beats at all: c1 has stopped, so nothing arrives
  # inside the window and the ring is dark for the only reason it can be, which is
  # that nobody claimed it.
  local away
  away="$(wc_ c2 --seconds 6 agent-availability --alias "$alias")" || {
    echo "weald-stack: c2 could not read the availability after the host went away" >&2
    exit 1
  }
  { echo; echo "## what c2 sees after c1 stops"; echo "$away"; } | tee -a "$out"
  [ "$(field "$away" state)" = "offline" ] || {
    echo "weald-stack: c2 shows '$(field "$away" state)' for a host that stopped beating" >&2
    exit 1
  }
  [ "$(field "$away" accepts)" = "no" ] || {
    echo "weald-stack: c2 would still compose an invoke to an offline host" >&2
    exit 1
  }
  [ "$(field "$away" compose)" = "declined/hostOffline" ] || {
    echo "weald-stack: the composer says '$(field "$away" compose)', not declined/hostOffline" >&2
    exit 1
  }
  [ "$(field "$away" reason)" = "hostOffline" ] || {
    echo "weald-stack: the refusal carried reason '$(field "$away" reason)'" >&2
    exit 1
  }
  # The deadline the requester signed, not one this harness invented: an offline host
  # is a visible state *with a countdown*, which is the whole invariant.
  [ -n "$(field "$away" deadline)" ] || {
    echo "weald-stack: the refusal carried no deadline, which is the spinner" >&2
    exit 1
  }
  [ "$(field "$away" deadline)" = "$(field "$invoke_out" deadline)" ] || {
    echo "weald-stack: the displayed deadline is not the one c2 signed" >&2
    exit 1
  }

  # The zero delta. Every beat above crossed a real relay backed by real Postgres,
  # and the relay kept none of them.
  local after_envelopes after_bytes
  after_envelopes="$(relay_psql "select count(*) from relay_envelope e join relay_group g \
on g.group_id = e.group_id where g.workspace_id = '$ws'" | tr -d '[:space:]')"
  after_bytes="$(relay_psql "select coalesce(sum(octet_length(ct)),0) from relay_envelope e \
join relay_group g on g.group_id = e.group_id where g.workspace_id = '$ws'" \
    | tr -d '[:space:]')"
  # The card and the invoke are durable and are expected to have landed; what must
  # not have moved is the count *between* the two readings taken after them, so the
  # delta is measured across the ephemeral half alone.
  local ephemeral_before ephemeral_after
  ephemeral_before="$(relay_psql "select count(*) from relay_envelope e join relay_group g \
on g.group_id = e.group_id where g.workspace_id = '$ws'" | tr -d '[:space:]')"
  wc_ c1 --seconds 4 --ttl 110 agent-beat --alias "$alias" --state busy >>"$out" 2>&1 || {
    echo "weald-stack: the closing beat did not go" >&2; exit 1
  }
  ephemeral_after="$(relay_psql "select count(*) from relay_envelope e join relay_group g \
on g.group_id = e.group_id where g.workspace_id = '$ws'" | tr -d '[:space:]')"
  [ "$ephemeral_before" = "$ephemeral_after" ] || {
    echo "weald-stack: a LIVE beat added $((ephemeral_after - ephemeral_before)) envelope row(s)" >&2
    exit 1
  }
  # And no table anywhere grew a row that names the beat. The frame has no id, so the
  # assertion is over the tables that could have carried one: the envelope log, the
  # handshake log and the checkpoint anchors.
  local handshakes anchors
  handshakes="$(relay_psql "select count(*) from relay_handshake h join relay_group g \
on g.group_id = h.group_id where g.workspace_id = '$ws'" | tr -d '[:space:]')"
  anchors="$(relay_psql "select count(*) from relay_checkpoint_anchor a join relay_group g \
on g.group_id = a.group_id where g.workspace_id = '$ws'" | tr -d '[:space:]')"

  {
    echo
    echo "## the comparison"
    echo "beaten     c1 sent=$(field "$beat_out" sent) ttl=$(field "$beat_out" ttl) \
shed=$(field "$beat_out" shed) budget=$(field "$beat_out" budget)"
    echo "seen       state=$(field "$live" state) accepts=$(field "$live" accepts) \
compose=$(field "$live" compose)"
    echo "forged     dropped=$(field "$forged_seen" droppedNotHost) by the host rule, \
carried by the relay, folded=$(field "$forged_seen" folded)"
    echo "offline    state=$(field "$away" state) reason=$(field "$away" reason) \
deadline=$(field "$away" deadline)"
    echo "signed     c2's invoke deadline=$(field "$invoke_out" deadline)"
    echo "envelopes  before=$before_envelopes after=$after_envelopes \
bytes before=$before_bytes after=$after_bytes"
    echo "ephemeral  envelope rows $ephemeral_before -> $ephemeral_after across a beat"
    echo "handshakes $handshakes  anchors $anchors  (a LIVE has no row in either)"
    echo "converged  one ring, two facts: the agent is dark, the invoke has a deadline"
  } | tee -a "$out"

  echo "offline=inside-ttl"
  echo "declined=hostOffline"
  echo "live_rows=0"
}

# Step 22's crossing: a member opens a private conversation with an organization's
# agent, is shown the disclosure, sends, and folds one signed answer.
#
# The same real parts as step 19's crossing, because the claim is the same shape and a
# lighter rig would prove a group rather than a conversation: two real client processes,
# the real relay, a scratch control plane holding a real sealed provider credential, the
# real worker behind per-run mutual TLS, and the real gateway in its own process. What is
# new is the group it all happens in: `GroupKind.agentdm`, created by the member, holding
# one person and one agent card and labelled as such at every surface.
#
# The refusals are driven here too, in the same run, because each of them is a state a
# person can reach: an agent asking to open the conversation, a member who has not
# accepted the disclosure, an agent nobody assigned the scope to, and the original dm
# policy still refusing an agent principal outright.
cmd_agent_dm_crossing() {
  local out_dir="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-22}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out_dir="$2"; shift 2 ;;
      *) echo "weald-stack agent-dm-crossing: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$out_dir"
  local out="$out_dir/agentdm-crossing.txt"

  local provider_key
  provider_key="$(/usr/bin/security find-generic-password -s com.dicyanin.weald \
    -a openrouter-api-key -w 2>/dev/null || true)"
  [ -n "$provider_key" ] || {
    echo "weald-stack: no OpenRouter key in the Keychain. This crossing reaches the" >&2
    echo "real vendor and there is no test mode." >&2
    exit 1
  }

  local nonce; nonce="$(python3 -c 'import os; print(os.urandom(4).hex())')"
  local alias="reviewer-dm$nonce"
  local unassigned="stranger-dm$nonce"
  local work; work="$STACK_STATE/agentdm-crossing-$nonce"
  mkdir -p "$work/pki"

  cmd_clients 2 --selections relay,relay --fresh >/dev/null

  local d1 d2
  d1="$(field "$(wc_ c1 device)" device)"
  d2="$(field "$(wc_ c2 device)" device)"
  [ -n "$d1" ] && [ "$d1" != "$d2" ] || {
    echo "weald-stack: the two clients share a device key, so this is one player twice" >&2
    exit 1
  }

  # The channel group, which the agent is also assigned so that the disclosure and the
  # card projection have a shared scope to be read in, and the `agentdm` group, derived
  # by the client itself rather than by a bash reimplementation of `GroupID.derive`.
  local channel; channel="$(field "$(wc_ c1 agent-members)" group)"
  [ -n "$channel" ] || { echo "weald-stack: c1 named no group" >&2; exit 1; }
  local derived; derived="$(wc_ c2 adm-derive --alias "$alias")" || {
    echo "weald-stack: c2 could not derive the conversation's group" >&2; exit 1; }
  local group agent slug
  group="$(field "$derived" group)"
  agent="$(field "$derived" agent)"
  slug="$(field "$derived" slug)"
  [ -n "$group" ] && [ -n "$agent" ] || {
    echo "weald-stack: the derivation named no group or no agent" >&2; exit 1; }
  [ "$group" != "$channel" ] || {
    echo "weald-stack: the conversation derived the channel's own group" >&2; exit 1; }
  [ "$(field "$derived" kind)" = "agentdm" ] || {
    echo "weald-stack: the derived group is kind $(field "$derived" kind)" >&2; exit 1; }
  [ "$(field "$derived" identity)" = "$group" ] || {
    echo "weald-stack: the identity record and the scope derive different groups" >&2; exit 1; }
  [ "$(field "$derived" section)" = "agents" ] || {
    echo "weald-stack: the conversation is drawn in the $(field "$derived" section) section" >&2
    exit 1; }

  {
    echo "# A member opens a private conversation with an organization's agent"
    echo
    echo "workspace $(cat "$CLIENTS_DIR/workspace-id")"
    echo "relay     $(relay_ws_url)"
    echo "alias     $alias"
    echo "channel   $channel"
    echo "agentdm   $group  slug $slug"
    echo "c1 device $d1  (the admin)"
    echo "c2 device $d2  (the member whose conversation this is)"
  } | tee "$out"

  # The gateway's key, and its principal before the process exists.
  local seed principal
  seed="$(python3 -c 'import os; print(os.urandom(32).hex())')"
  principal="$(field "$(cargo run -q -p weald-agent-gateway --example principal_of -- "$seed")" principal)"
  [ -n "$principal" ] || { echo "weald-stack: could not derive the gateway principal" >&2; exit 1; }
  wc_ c1 admit --device "$principal" >>"$out" 2>&1 || {
    echo "weald-stack: the admin could not admit the gateway to the access set" >&2
    tail -20 "$out" >&2
    exit 1
  }

  # The control plane. Two scopes, assigned in the one admin action step 22 says an
  # `agentdm` is: "an `agentdm` is a scope like any other. It appears in the card's
  # scopes or the agent cannot be invoked in it, and assignment is the same admin action
  # as assigning a channel."
  local control_db="weald_agents_adm_$nonce"
  docker exec -i "$(dc ps -q postgres)" createdb -U weald "$control_db" >/dev/null 2>&1 || true
  local control_url="postgres://weald:weald@127.0.0.1:$WEALD_STACK_PG_PORT/$control_db"
  local seeded
  seeded="$(WEALD_LLM_OPENROUTER_KEY="$provider_key" cargo run -q -p weald-agent-worker \
    --example org_crossing_seed -- \
    --database "$control_url" --alias "$alias" \
    --scope "$channel" --scope "$group" \
    --member "$d1" --member "$d2" --pki "$work/pki" \
    --model "${WEALD_AGENT_CROSSING_MODEL:-anthropic/claude-haiku-4.5}")" || {
    echo "weald-stack: seeding the control plane failed" >&2
    exit 1
  }
  local kek; kek="$(field "$seeded" kek)"
  [ "$(field "$seeded" agent)" = "$agent" ] || {
    echo "weald-stack: the control plane hosts $(field "$seeded" agent), the client "\
"addressed $agent" >&2
    exit 1
  }
  [ "$(field "$seeded" scopes)" = "2" ] || {
    echo "weald-stack: the agent was assigned $(field "$seeded" scopes) scope(s)" >&2
    exit 1
  }
  { echo; echo "## the control plane"; echo "agent $agent"; echo "database $control_db";
    echo "scopes channel + agentdm"; } | tee -a "$out"

  local worker_port; worker_port="$(python3 -c '
import socket
s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')"
  cargo build -q -p weald-agent-worker --bin weald-agent-worker || {
    echo "weald-stack: the worker did not build" >&2; exit 1; }
  WEALD_AGENT_WORKER_LISTEN="127.0.0.1:$worker_port" \
  WEALD_AGENT_WORKER_SERVER_CERT="$(cat "$work/pki/server.pem")" \
  WEALD_AGENT_WORKER_CLIENT_CA="$(cat "$work/pki/ca.pem")" \
  WEALD_AGENT_WORKER_KEK="$kek" \
  WEALD_AGENT_WORKER_DATABASE_URL="$control_url" \
    nohup "$ROOT/target/debug/weald-agent-worker" >"$work/worker.log" 2>&1 &
  local worker_pid=$!

  cargo build -q -p weald-agent-gateway --bin weald-agent-gateway || {
    echo "weald-stack: the gateway did not build" >&2; kill "$worker_pid" 2>/dev/null; exit 1; }
  local gateway_port; gateway_port="$(python3 -c '
import socket
s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')"
  WEALD_AGENT_GATEWAY_LISTEN="127.0.0.1:$gateway_port" \
  WEALD_AGENT_GATEWAY_RELAY_URL="127.0.0.1:$WEALD_STACK_RELAY_PORT" \
  WEALD_AGENT_GATEWAY_DEVICE_KEY="$seed" \
  WEALD_AGENT_GATEWAY_DATABASE_URL="$control_url" \
  WEALD_AGENT_GATEWAY_STATE="$work/mls.sqlite" \
  WEALD_AGENT_WORKER_URL="127.0.0.1:$worker_port" \
  WEALD_AGENT_WORKER_CLIENT_CERT="$(cat "$work/pki/client.pem")" \
    nohup "$ROOT/target/debug/weald-agent-gateway" >"$work/gateway.log" 2>&1 &
  local gateway_pid=$!

  adm_crossing_stop() {
    kill "$gateway_pid" "$worker_pid" 2>/dev/null || true
    wait "$gateway_pid" 2>/dev/null || true
    wait "$worker_pid" 2>/dev/null || true
  }

  # The key package the gateway publishes on the way up, which is what a member adds it
  # to the conversation with. `private-messaging.md`'s establishment, unchanged: the
  # agent's key package is published by its host.
  local waited=0 package=""
  while [ "$waited" -lt 120 ]; do
    package="$(docker exec -i "$(dc ps -q postgres)" psql -U weald -d "$control_db" -tAc \
      "select encode(key_package,'hex') from agent_gateway_key_package" 2>/dev/null \
      | tr -d '[:space:]' || true)"
    if [ -n "$package" ]; then break; fi
    sleep 1
    waited=$((waited + 1))
  done
  [ -n "$package" ] || {
    echo "weald-stack: the gateway never published a key package" >&2
    tail -20 "$work/gateway.log" >&2
    adm_crossing_stop
    exit 1
  }
  python3 -c 'import sys, binascii
open(sys.argv[1], "wb").write(binascii.unhexlify(sys.argv[2]))' \
    "$work/key-package.bin" "$package"
  # Both scopes subscribed, because the welcome for the conversation is published into
  # the conversation's own handshake stream and a gateway that had not subscribed to it
  # would never see the group it was invited to.
  waited=0
  while [ "$waited" -lt 120 ] && ! grep -q "scopes=2" "$work/gateway.log"; do
    sleep 1; waited=$((waited + 1))
  done
  grep -q "scopes=2" "$work/gateway.log" || {
    echo "weald-stack: the gateway never subscribed to both scopes" >&2
    tail -30 "$work/gateway.log" >&2
    adm_crossing_stop
    exit 1
  }

  # The card, delivered by the admin's own device, because the gateway is not a member of
  # the workspace root group where cards are read from.
  local card_hex=""
  waited=0
  while [ "$waited" -lt 90 ]; do
    card_hex="$(docker exec -i "$(dc ps -q postgres)" psql -U weald -d "$control_db" -tAc \
      "select encode(card,'hex') from agent_hosted_card" 2>/dev/null | tr -d '[:space:]' || true)"
    if [ -n "$card_hex" ]; then break; fi
    sleep 1
    waited=$((waited + 1))
  done
  [ -n "$card_hex" ] || {
    echo "weald-stack: the gateway published no hosted card" >&2
    adm_crossing_stop
    exit 1
  }
  python3 -c 'import sys, binascii
open(sys.argv[1], "wb").write(binascii.unhexlify(sys.argv[2]))' \
    "$work/agent-card.bin" "$card_hex"
  local card_out
  card_out="$(wc_ c1 agent-org-card --secrets-file "$work/agent-card.bin")" || {
    echo "weald-stack: c1 could not publish the organization card" >&2
    adm_crossing_stop
    exit 1
  }
  { echo; echo "## c1 publishes the gateway's card"; echo "$card_out"; } | tee -a "$out"
  wc_ c1 --seconds 10 sync >/dev/null 2>&1 || true
  wc_ c2 --seconds 10 sync >/dev/null 2>&1 || true

  # The refusals, before the conversation exists, because each is a state a person can
  # reach and three of them would otherwise be provable only in a suite.
  local refused_agent refused_undisclosed refused_unassigned refused_dm
  refused_agent="$(wc_ c2 adm-open --alias "$alias" --state agent)" || {
    echo "weald-stack: adm-open --state agent did not answer at all" >&2
    adm_crossing_stop; exit 1; }
  [ "$(field "$refused_agent" reason)" = "agentCreator" ] || {
    echo "weald-stack: an agent was allowed to open the conversation: $refused_agent" >&2
    adm_crossing_stop; exit 1; }
  refused_undisclosed="$(wc_ c2 adm-open --alias "$alias" --state decline)" || {
    echo "weald-stack: adm-open --state decline did not answer at all" >&2
    adm_crossing_stop; exit 1; }
  [ "$(field "$refused_undisclosed" reason)" = "undisclosed" ] || {
    echo "weald-stack: a declined disclosure still opened the conversation: "\
"$refused_undisclosed" >&2
    adm_crossing_stop; exit 1; }
  refused_unassigned="$(wc_ c2 adm-open --alias "$unassigned")" || {
    echo "weald-stack: adm-open against an unassigned agent did not answer" >&2
    adm_crossing_stop; exit 1; }
  [ "$(field "$refused_unassigned" reason)" = "notAssigned" ] || {
    echo "weald-stack: an unassigned agent was given a conversation: $refused_unassigned" >&2
    adm_crossing_stop; exit 1; }
  # And the refusal this whole step exists so as not to weaken.
  refused_dm="$(wc_ c2 dm-open --state agent)" || {
    echo "weald-stack: dm-open --state agent did not answer" >&2
    adm_crossing_stop; exit 1; }
  [ "$(field "$refused_dm" state)" = "refused" ] \
    && [ "$(field "$refused_dm" reason)" = "dm.principal.agent" ] || {
    echo "weald-stack: the human dm policy admitted an agent: $refused_dm" >&2
    adm_crossing_stop; exit 1; }
  {
    echo; echo "## what is refused"
    echo "agent creator     $(field "$refused_agent" reason)"
    echo "undisclosed       $(field "$refused_undisclosed" reason)"
    echo "unassigned agent  $(field "$refused_unassigned" reason)"
    echo "agent in a dm     $(field "$refused_dm" reason)  (unchanged, still permanent)"
  } | tee -a "$out"

  # The disclosure, in the conversation's own scope. Required before creation, which is
  # stricter than a channel mention: creating the conversation is itself the first thing
  # sent to somebody else's server.
  local declined_out accepted_out
  declined_out="$(wc_ c2 agent-disclosure --alias "$alias" --scope-group "$group" \
    --state decline)" || {
    echo "weald-stack: c2 was never shown a disclosure for $alias" >&2
    adm_crossing_stop; exit 1; }
  [ -z "$(field "$declined_out" invocable)" ] || {
    echo "weald-stack: a declined disclosure still left the agent invocable" >&2
    adm_crossing_stop; exit 1; }
  accepted_out="$(wc_ c2 agent-disclosure --alias "$alias" --scope-group "$group" \
    --state accept)" || {
    echo "weald-stack: c2 could not accept the disclosure" >&2
    adm_crossing_stop; exit 1; }
  [ "$(field "$accepted_out" invocable)" = "$alias" ] || {
    echo "weald-stack: an accepted disclosure did not make the agent invocable" >&2
    adm_crossing_stop; exit 1; }
  { echo; echo "## c2 is shown the disclosure, declines, then accepts";
    echo "$declined_out"; echo; echo "$accepted_out"; } | tee -a "$out"

  # The conversation. Created by the member, holding the gateway's leaf, with the welcome
  # in the group's own handshake stream.
  local opened
  opened="$(wc_ c2 adm-open --alias "$alias" --fingerprint "$agent" \
    --secrets-file "$work/key-package.bin")" || {
    echo "weald-stack: c2 could not open the conversation" >&2
    adm_crossing_stop
    exit 1
  }
  { echo; echo "## c2 opens the conversation"; echo "$opened"; } | tee -a "$out"
  [ "$(field "$opened" state)" = "opened" ] || {
    echo "weald-stack: the conversation is $(field "$opened" state)" >&2
    adm_crossing_stop; exit 1; }
  [ "$(field "$opened" group)" = "$group" ] || {
    echo "weald-stack: the conversation opened group $(field "$opened" group)" >&2
    adm_crossing_stop; exit 1; }
  [ "$(field "$opened" welcomes)" = "1" ] || {
    echo "weald-stack: $(field "$opened" welcomes) welcome(s) published" >&2
    adm_crossing_stop; exit 1; }
  [ "$(field "$opened" private)" = "no" ] || {
    echo "weald-stack: the conversation reports itself as private" >&2
    adm_crossing_stop; exit 1; }
  [ "$(field "$opened" section)" = "agents" ] \
    && [ "$(field "$opened" peopleSection)" = "people" ] || {
    echo "weald-stack: the two sidebar sections are not distinct" >&2
    adm_crossing_stop; exit 1; }
  [ "$(field "$opened" dmAdmitsAgents)" = "no" ] || {
    echo "weald-stack: the dm policy admitted an agent during the crossing" >&2
    adm_crossing_stop; exit 1; }
  [ "$(field "$opened" recoveryWrap)" = "no" ] || {
    echo "weald-stack: an agentdm published a recovery wrap" >&2
    adm_crossing_stop; exit 1; }
  case "$(field "$opened" header)" in
    *"Not private"*) : ;;
    *) echo "weald-stack: the header does not say the host can read this" >&2
       adm_crossing_stop; exit 1 ;;
  esac

  # The message, and the invoke beside it, into the conversation.
  local token="CLOISTER$nonce"
  local sent
  sent="$(wc_ c2 adm-send --alias "$alias" \
    --body "@$alias In one short sentence, tell me the reference code for this conversation, which is $token, quoted exactly as written.")" || {
    echo "weald-stack: c2 could not send into the conversation" >&2
    adm_crossing_stop
    exit 1
  }
  { echo; echo "## c2 sends"; echo "$sent"; } | tee -a "$out"
  [ "$(field "$sent" agent)" = "$agent" ] || {
    echo "weald-stack: the invoke addressed $(field "$sent" agent)" >&2
    adm_crossing_stop; exit 1; }

  waited=0
  while [ "$waited" -lt 180 ] && ! grep -q "answered outcome=Answered" "$work/gateway.log"; do
    wc_ c2 --seconds 5 sync >/dev/null 2>&1 || true
    waited=$((waited + 5))
  done
  grep -q "answered outcome=Answered" "$work/gateway.log" || {
    echo "weald-stack: the gateway never answered in the conversation" >&2
    tail -40 "$work/gateway.log" >&2
    adm_crossing_stop
    exit 1
  }
  { echo; echo "## the gateway"; grep -E "^(received|answered|published)" "$work/gateway.log"; } \
    | tee -a "$out"

  local read_out folded=0
  while [ "$folded" -lt 12 ]; do
    if read_out="$(wc_ c2 adm-read --alias "$alias" 2>/dev/null)"; then break; fi
    wc_ c2 --seconds 10 sync >/dev/null 2>&1 || true
    folded=$((folded + 1))
  done
  read_out="$(wc_ c2 adm-read --alias "$alias")" || {
    echo "weald-stack: c2 could not fold the answer in the conversation" >&2
    adm_crossing_stop; exit 1; }
  { echo; echo "## c2 reads"; echo "$read_out"; } | tee -a "$out"
  [ "$(field "$read_out" verified)" = "yes" ] || {
    echo "weald-stack: the answer did not verify" >&2; adm_crossing_stop; exit 1; }
  [ "$(field "$read_out" state)" = "completed" ] || {
    echo "weald-stack: folded state $(field "$read_out" state)" >&2
    adm_crossing_stop; exit 1; }
  [ "$(field "$read_out" anomalies)" = "0" ] || {
    echo "weald-stack: $(field "$read_out" anomalies) anomalies" >&2
    adm_crossing_stop; exit 1; }
  [ "$(field "$read_out" renders)" = "yes" ] || {
    echo "weald-stack: the header a person reads this under fails its own assertion" >&2
    adm_crossing_stop; exit 1; }
  local author; author="$(field "$read_out" answerAuthor)"
  [ "$author" = "$principal" ] || {
    echo "weald-stack: the answer was authored by $author, not by the gateway" >&2
    adm_crossing_stop; exit 1; }
  [ "$author" != "$d1" ] && [ "$author" != "$d2" ] || {
    echo "weald-stack: the answer was authored by a person's device key" >&2
    adm_crossing_stop; exit 1; }
  local answer_folded token_folded
  answer_folded="$(tr '[:upper:]' '[:lower:]' <<< "$(field "$read_out" answerText)")"
  token_folded="$(tr '[:upper:]' '[:lower:]' <<< "$token")"
  case "$answer_folded" in
    *"$token_folded"*) : ;;
    *) echo "weald-stack: the answer does not carry the token the member asked for" >&2
       adm_crossing_stop; exit 1 ;;
  esac

  # And the other member is not in it. Two principals, and the second is the agent: c1 is
  # an admin of this workspace and holds no content key for the conversation's group, so
  # the conversation is private from the workspace even though the agent's host can read
  # it. Read from c1's own seal rather than asserted.
  local c1groups
  c1groups="$(wc_ c1 groups 2>/dev/null || true)"
  case "$c1groups" in
    *"$group"*) echo "weald-stack: c1 holds the conversation's group" >&2
                adm_crossing_stop; exit 1 ;;
    *) : ;;
  esac

  {
    echo
    echo "## the comparison"
    echo "kind         agentdm, created by the member $d2"
    echo "group        $group  slug $slug"
    echo "principals   one person and one agent card; c1 the admin holds no key for it"
    echo "sections     $(field "$opened" peopleSection) and $(field "$opened" section), distinct"
    echo "header       $(field "$read_out" header)"
    echo "private      $(field "$read_out" private)  (the word a dm header carries, refused)"
    echo "answered     $(field "$read_out" state) anomalies=$(field "$read_out" anomalies)"
    echo "answerAuthor $author  (the gateway, not $d1 and not $d2)"
    echo "answerText   $(field "$read_out" answerText)"
    echo "token        $token present in the answer"
    echo "refusals     agentCreator, undisclosed, notAssigned, dm.principal.agent"
  } | tee -a "$out"

  adm_crossing_stop
  docker exec -i "$(dc ps -q postgres)" dropdb -U weald --if-exists "$control_db" >/dev/null 2>&1 || true
  rm -rf "$work"

  echo "opened=agentdm"
  echo "answered=gateway"
  echo "refused=agentCreator,undisclosed,notAssigned,dm.principal.agent"
  echo "sections=people,agents"
}

# Step 16's crossing: a remote ticket ask executes only on the published owner and
# survives a reconnect without a second answer.
#
# The reconnect is modelled as the thing a reconnect actually does, which is deliver a
# record again and ask a host to consider it again. So c1 is asked to execute twice with
# a sync in between: the second call must reach its recorded result rather than start a
# second run, and the count of terminal records must not move.
# Step 17's ship gate: the five-point acceptance test, plus the org addendum.
#
# `specs/agents/networked/phases-product.md` names six numbered claims and an org
# addendum, and every one of them already has a crossing in this file that proves
# it against the real rig. So this composes rather than reimplements: a second
# hand-written discovery-and-invoke path here would prove that *this function*
# works, which is not what the gate is for, and the two copies would drift the
# first time either side of the protocol changed.
#
# What composition adds, and what makes this a gate rather than a shell loop, is
# the three things no constituent crossing can assert about itself:
#
#   - that all six hold *together*, on one relay, in one run, rather than on six
#     rigs on six days;
#   - one transcript naming each claim, its crossing and its verdict, which is the
#     artifact step 17 owes and the thing a person reads before saying the word
#     "multiplayer" out loud;
#   - the sentence in the spec that until this is green the product describes bots
#     as local assistants. That is a deliverable of the gate as much as the tests,
#     so it is written into the transcript either way, with the verdict attached.
#
# Ordered the way a person meets the feature: discovery, then the ask, then the
# failure modes, then the live signals, then the org half.
cmd_agent_ship_gate() {
  local out_dir="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-17}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out_dir="$2"; shift 2 ;;
      *) echo "weald-stack agent-ship-gate: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$out_dir"
  local out="$out_dir/acceptance.txt"
  local work="$out_dir/parts"
  rm -rf "$work"; mkdir -p "$work"

  {
    echo "# Step 17 ship gate: the two-player acceptance run"
    echo
    echo "relay      $(relay_ws_url)"
    echo "rollout    ${WEALD_NETWORKED_AGENTS:-unset}"
    echo "at         $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo
  } >"$out"

  # Each row: the claim, the crossing that proves it, and the file it wrote.
  # Kept as one table so a claim cannot be added here without a crossing, and a
  # crossing cannot quietly stop running without its row losing its verdict.
  local -a claims=(
    "1,2,3,4|Player 2 discovers, asks, only Player 1 executes, both fold one signed answer|agent-crossing"
    "1|Player 2 discovers Player 1's opted-in agent in the directory|agent-card-directory-crossing"
    "3,4|Only the host executes, and the answer is signed and terminal|agent-execution-crossing"
    "5|Offline host, duplicate delivery, revoked requester, expired agent|agent-offline-crossing"
    "6|Availability is a signed LIVE beat and not a published field|agent-availability-crossing"
    "org|Admin card, disclosure before first invoke, assigned scope, custody|agent-org-crossing"
  )

  local failed=0 row claim what verb log
  for row in "${claims[@]}"; do
    claim="${row%%|*}"
    what="${row#*|}"; what="${what%%|*}"
    verb="${row##*|}"
    log="$work/$verb.log"
    echo "== $verb  (points $claim)" | tee -a "$out"
    echo "   $what" | tee -a "$out"
    if WEALD_AGENT_CROSSING_OUT="$work" "$0" "$verb" --out "$work" >"$log" 2>&1; then
      echo "   PASS  $log" | tee -a "$out"
    else
      echo "   FAIL  $log" | tee -a "$out"
      tail -20 "$log" >&2
      failed=1
    fi
    echo | tee -a "$out"
  done

  # The call arm of point 6. It is a Rust integration test rather than a crossing
  # in this file, because the offering side is the thing that has to read the
  # decline and its latency, and that side is the gateway's own binary. Named here
  # so the transcript covers all of point 6 rather than the half a crossing can
  # reach.
  echo "== call decline  (point 6)" | tee -a "$out"
  echo "   A call offered into the agent's channel is declined within a second" | tee -a "$out"
  if cargo nextest run -p weald-agent-gateway -E 'binary(call_decline)' \
      >"$work/call_decline.log" 2>&1; then
    echo "   PASS  $work/call_decline.log" | tee -a "$out"
  else
    echo "   FAIL  $work/call_decline.log" | tee -a "$out"
    tail -20 "$work/call_decline.log" >&2
    failed=1
  fi
  echo | tee -a "$out"

  # And the assertion the whole org track is built around. Three checks rather
  # than a commit-range diff, for the reason `phases-org.md` gives at length: the
  # relay is under active development by other programmes, so a range diff cannot
  # separate this track's changes from theirs and would be switched off within a
  # week. `relay_blind.rs` asserts the property the diff was a proxy for.
  echo "== relay unchanged  (org addendum)" | tee -a "$out"
  echo "   backend/wealdrelay/src/ names no agent concept and links none of the crates" \
    | tee -a "$out"
  if cargo nextest run -p wealdrelay -E 'binary(relay_blind)' \
      >"$work/relay_blind.log" 2>&1; then
    echo "   PASS  $work/relay_blind.log" | tee -a "$out"
  else
    echo "   FAIL  $work/relay_blind.log" | tee -a "$out"
    tail -20 "$work/relay_blind.log" >&2
    failed=1
  fi
  echo | tee -a "$out"

  {
    echo "## The sentence"
    echo
    if [ "$failed" -eq 0 ]; then
      echo "shipgate=pass"
      echo "Every point above held on one relay in one run. From here the product"
      echo "may be described as networked agents."
    else
      echo "shipgate=fail"
      echo "At least one point did not hold. Until this run is green the product"
      echo "describes bots as local assistants with relay-synced chat, and not as"
      echo "networked agents."
    fi
  } | tee -a "$out"

  [ "$failed" -eq 0 ] || exit 1
}

cmd_agent_ticket_crossing() {
  local out_dir="${WEALD_AGENT_CROSSING_OUT:-$ROOT/build-evidence/agents/step-16}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out_dir="$2"; shift 2 ;;
      *) echo "weald-stack agent-ticket-crossing: unknown argument: $1" >&2; exit 64 ;;
    esac
  done
  require_daemon
  relay_answers || {
    echo "weald-stack: the relay is not serving. scripts/weald-stack up" >&2
    exit 1
  }
  mkdir -p "$out_dir"
  local out="$out_dir/ticket-crossing.txt"

  local nonce; nonce="$(python3 -c 'import os; print(os.urandom(4).hex())')"
  local alias="researcher-tk$nonce"
  local ticket="WEALD-916"

  cmd_clients 2 --selections relay,relay --fresh >/dev/null

  local d1 d2
  d1="$(field "$(wc_ c1 device)" device)"
  d2="$(field "$(wc_ c2 device)" device)"
  [ -n "$d1" ] && [ "$d1" != "$d2" ] || {
    echo "weald-stack: the two clients share a device key, so this is one player twice" >&2
    exit 1
  }

  {
    echo "# A ticket ask runs on the owner only, and a reconnect does not double it"
    echo
    echo "workspace $(cat "$CLIENTS_DIR/workspace-id")"
    echo "relay     $(relay_ws_url)"
    echo "alias     $alias"
    echo "ticket    $ticket"
    echo "c1 device $d1"
    echo "c2 device $d2"
  } | tee "$out"

  local leaf_out lease_out
  leaf_out="$(wc_ c1 agent-leaf --alias "$alias" --seconds 3600)" || {
    echo "weald-stack: c1 could not issue the agent's certificate" >&2; exit 1
  }
  lease_out="$(wc_ c1 agent-lease --alias "$alias" --seconds 1 --ttl 600)" || {
    echo "weald-stack: c1 could not publish its lease" >&2; exit 1
  }
  { echo; echo "## c1 owns the agent"; echo "$leaf_out"; echo "$lease_out"; } | tee -a "$out"

  # The ask, from the ticket surface: an invoke carrying the ticket it belongs to.
  local invoke_out
  invoke_out="$(wc_ c2 agent-invoke --alias "$alias" --id "$ticket")" || {
    echo "weald-stack: c2 could not publish the ticket ask" >&2; exit 1
  }
  { echo; echo "## c2 asks from a ticket"; echo "$invoke_out"; } | tee -a "$out"

  { echo; echo "## both sync"; wc_ c1 --seconds 30 sync; wc_ c2 --seconds 30 sync; } \
    >>"$out" 2>&1

  # The ticket reference survived the crossing, which is the thing the migration owes.
  local scan_two
  scan_two="$(wc_ c1 agent-mention-scan --alias "$alias")" || {
    echo "weald-stack: c1 could not scan" >&2; exit 1
  }
  { echo; echo "## what c1 holds"; echo "$scan_two"; } | tee -a "$out"
  [ "$(field "$scan_two" tickets)" = "$ticket" ] || {
    echo "weald-stack: the ask reached c1 as ticket '$(field "$scan_two" tickets)'" >&2
    exit 1
  }

  # The requester's own machine is asked first, so a c1 that answered could not be
  # mistaken for a c2 that had been prevented from trying.
  local c2_exec
  c2_exec="$(wc_ c2 agent-execute --alias "$alias")" || {
    echo "weald-stack: c2's execute failed; it should refuse, not error" >&2; exit 1
  }
  { echo; echo "## c2 is asked to answer its own ticket ask"; echo "$c2_exec"; } | tee -a "$out"
  [ "$(field "$c2_exec" outcome)" = "silent" ] || {
    echo "weald-stack: c2 answered '$(field "$c2_exec" outcome)' for an agent it does not host" >&2
    exit 1
  }
  [ "$(field "$c2_exec" records)" = "0" ] || {
    echo "weald-stack: c2 wrote $(field "$c2_exec" records) records" >&2; exit 1
  }

  local first_run
  first_run="$(wc_ c1 agent-execute --alias "$alias" --body "the ticket answer")" || {
    echo "weald-stack: c1 could not execute" >&2; exit 1
  }
  { echo; echo "## c1 answers"; echo "$first_run"; } | tee -a "$out"
  [ "$(field "$first_run" outcome)" = "completed" ] || {
    echo "weald-stack: c1 finished as '$(field "$first_run" outcome)'" >&2; exit 1
  }

  { echo; echo "## both sync"; wc_ c1 --seconds 30 sync; wc_ c2 --seconds 30 sync; } \
    >>"$out" 2>&1

  local after_first
  after_first="$(wc_ c2 agent-status --alias "$alias")" || {
    echo "weald-stack: c2 could not read the status" >&2; exit 1
  }
  [ "$(field "$after_first" phase)" = "completed" ] || {
    echo "weald-stack: c2 shows '$(field "$after_first" phase)' after the answer" >&2; exit 1
  }
  local answered_records; answered_records="$(field "$after_first" records)"

  # The reconnect: the same host is asked again about the same invocation.
  local second_run
  second_run="$(wc_ c1 agent-execute --alias "$alias" --body "a second answer")" || {
    echo "weald-stack: c1's second execute errored; it should decline, not fail" >&2; exit 1
  }
  { echo; echo "## the reconnect asks c1 again"; echo "$second_run"; } | tee -a "$out"
  [ "$(field "$second_run" outcome)" != "completed" ] || {
    echo "weald-stack: c1 answered the same ticket ask twice" >&2; exit 1
  }

  { echo; echo "## both sync"; wc_ c1 --seconds 30 sync; wc_ c2 --seconds 30 sync; } \
    >>"$out" 2>&1

  local settled
  settled="$(wc_ c2 agent-status --alias "$alias")" || {
    echo "weald-stack: c2 could not read the settled status" >&2; exit 1
  }
  { echo; echo "## what c2 sees afterwards"; echo "$settled"; } | tee -a "$out"
  [ "$(field "$settled" phase)" = "completed" ] || {
    echo "weald-stack: c2 shows '$(field "$settled" phase)' after the reconnect" >&2; exit 1
  }
  [ "$(field "$settled" responder)" = "$d1" ] || {
    echo "weald-stack: c2 attributes the answer to $(field "$settled" responder), not c1" >&2
    exit 1
  }
  [ "$(field "$settled" anomalies)" = "0" ] || {
    echo "weald-stack: the reconnect produced $(field "$settled" anomalies) anomalies" >&2
    exit 1
  }
  [ "$(field "$settled" records)" = "$answered_records" ] || {
    echo "weald-stack: the record count moved from $answered_records to \
$(field "$settled" records); the reconnect answered again" >&2
    exit 1
  }

  {
    echo
    echo "## the comparison"
    echo "ticket     $(field "$scan_two" tickets)"
    echo "refused    c2 silent, records 0"
    echo "answered   c1 $(field "$first_run" states)"
    echo "reconnect  c1 $(field "$second_run" outcome) $(field "$second_run" reason)"
    echo "records    $answered_records before, $(field "$settled" records) after"
    echo "responder  $(field "$settled" responder)"
    echo "answers    1"
  } | tee -a "$out"

  echo "answers=1"
  echo "ticket=$ticket"
}

main() {
  local cmd="${1:-status}"
  shift || true
  # Before anything reads the port: if this session already has a relay, that
  # relay's socket is the session's socket, whatever the default says.
  relay_adopt_own_port
  case "$cmd" in
    up) cmd_up "$@" ;;
    status) cmd_status "$@" ;;
    down) cmd_down "$@" ;;
    clients) cmd_clients "$@" ;;
    scenario) cmd_scenario "$@" ;;
    register) cmd_register "$@" ;;
    provision) cmd_provision "$@" ;;
    demo) cmd_demo "$@" ;;
    kill) cmd_kill "$@" ;;
    dump) not_yet "the envelope dump" "3, with the relay's schema" ;;
    fixture) cmd_fixture "$@" ;;
    enrol) cmd_enrol "$@" ;;
    prove-blind) cmd_prove_blind "$@" ;;
    dump-db) cmd_dump_db "$@" ;;
    agent-crossing) cmd_agent_crossing "$@" ;;
    agent-fold-crossing) cmd_agent_fold_crossing "$@" ;;
    agent-card-crossing) cmd_agent_card_crossing "$@" ;;
    ci-card-crossing) cmd_ci_card_crossing "$@" ;;
    ci-disclosure-crossing) cmd_ci_disclosure_crossing "$@" ;;
    agent-card-directory-crossing) cmd_agent_card_directory_crossing "$@" ;;
    agent-leaf-crossing) cmd_agent_leaf_crossing "$@" ;;
    agent-claim-race) cmd_agent_claim_race "$@" ;;
    agent-execution-crossing) cmd_agent_execution_crossing "$@" ;;
    agent-org-crossing) cmd_agent_org_crossing "$@" ;;
    agent-mention-crossing) cmd_agent_mention_crossing "$@" ;;
    agent-offline-crossing) cmd_agent_offline_crossing "$@" ;;
    agent-availability-crossing) cmd_agent_availability_crossing "$@" ;;
    agent-availability-gateway) cmd_agent_availability_gateway "$@" ;;
    agent-dm-crossing) cmd_agent_dm_crossing "$@" ;;
    agent-ticket-crossing) cmd_agent_ticket_crossing "$@" ;;
    agent-ship-gate) cmd_agent_ship_gate "$@" ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) echo "weald-stack: unknown command: $cmd" >&2; exit 64 ;;
  esac
}

main "$@"
