# cp .env.example .env, then edit one line.
#
# specs/backend/relay/server.md: "The .env edit is one line, the hostname.
# Everything else has a working default." The two passwords below are generated
# for you by the install script (deploy/install.sh); if you are copying this file
# by hand, replace them with anything long and random.

# ---- the one line you must edit --------------------------------------------

# The public hostname this relay answers on. An A or AAAA record for it must
# already point at this machine, and ports 80 and 443 must be reachable, or
# Caddy cannot be issued a certificate.
WEALD_RELAY_HOSTNAME=relay.example.com

# ---- generated, not edited --------------------------------------------------

# Protects ciphertext at rest. The relay is blind, so this password guards a
# database whose contents we could not read either.
POSTGRES_PASSWORD=replace-me
MINIO_ROOT_USER=wealdrelay
MINIO_ROOT_PASSWORD=replace-me

# ---- optional ---------------------------------------------------------------

# The bucket blobs go in. Created on first boot by the minio-init service.
MINIO_BUCKET=weald-blobs

# Pin this to a digest for a reproducible deployment. Every release publishes
# one (specs/backend/relay/verification.md proof 1), and the client compares
# what the relay reports against the signed release feed.
# WEALD_RELAY_IMAGE=ghcr.io/hunterh37/weald-relay@sha256:...

# Quotas. Both default to unlimited, which is the right setting until a bill
# says otherwise.
# WEALD_RELAY_MAX_STORAGE_GB=100
# WEALD_RELAY_RETENTION_DAYS=365

# Set to `internal` to use Caddy's own local CA instead of Let us Encrypt. For a
# hostname that is not publicly resolvable. Clients must be told to trust that CA.
# CADDY_TLS=internal
