# cp .env.example .env, then fill in the four values below.
#
# Path 4: private network, no public ingress. README.md one level up has the
# full sequence, and docker-compose.tailscale.yml beside this file is the whole
# stack.

# ---- tailnet ----------------------------------------------------------------

# The machine name the relay answers on inside the tailnet. Clients reach it at
# TS_HOSTNAME.TS_TAILNET and at no other address.
TS_HOSTNAME=weald-relay

# Your tailnet's name, as shown in the Tailscale admin console. Something like
# tail1234.ts.net or your-domain.example.com.
TS_TAILNET=

# An ephemeral, pre-authorised auth key from the tailnet admin console. Not a
# relay secret: it authorises a machine to join a network and grants no access
# to any envelope. Rotate it like any other join credential.
TS_AUTHKEY=

# ---- two passwords, generated rather than typed -----------------------------

# Generate each one separately:
#
#   openssl rand -base64 30
#
# They are empty on purpose. Compose refuses to start on an empty password and
# names the variable it wants, which is a better outcome than a relay that came
# up on a placeholder printed in a public repository.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=wealdrelay
MINIO_ROOT_PASSWORD=

# ---- optional ---------------------------------------------------------------

# The bucket blobs go in. Created on first boot by the minio-init service.
MINIO_BUCKET=weald-blobs

# Pin the relay to a digest for a reproducible deployment. Every release
# publishes one (specs/backend/relay/verification.md proof 1).
# WEALD_RELAY_IMAGE=ghcr.io/weald-protocol/wealdrelay@sha256:...

# `off` is defensible here and only here, because the tailnet is doing the
# perimeter work the access set does elsewhere. It stays `enforce` unless you
# change it, and every client's encryption panel shows which one is in force.
# WEALD_RELAY_ACCESS_SET=off

# Quotas. Both default to unlimited.
# WEALD_RELAY_MAX_STORAGE_GB=100
# WEALD_RELAY_RETENTION_DAYS=365
