# /etc/wealdrelay.env, mode 0640, owned root:wealdrelay.
#
# specs/backend/relay/deployment.md path 3. TLS is yours to terminate on this
# path: put nginx, Caddy or a load balancer in front, or set WEALD_RELAY_TLS=file
# and point the relay at a certificate.

# ---- required ---------------------------------------------------------------
#
# All three. A missing one exits 78, EX_CONFIG, naming the variable it wanted,
# and wealdrelay.service sets RestartPreventExitStatus=78 so systemd stops
# rather than restarting into the same failure. That is why the first two below
# are commented out rather than shipped with a placeholder: an unedited copy of
# this file fails on the first start and says which line to fix, instead of
# coming up on a password printed in a public repository.

# Your hostname. Uncomment and set it.
# WEALD_RELAY_HOSTNAME=relay.example.com

# Uncomment and set it. Generate the password with `openssl rand -base64 30`,
# set it on the wealdrelay Postgres role, and put the same value here. This file
# is mode 0640 root:wealdrelay for that reason.
# WEALD_RELAY_DATABASE_URL=postgres://wealdrelay:PASSWORD@127.0.0.1:5432/wealdrelay

WEALD_RELAY_STORAGE_URL=file:///var/lib/wealdrelay/blobs

# ---- back this up before you start the service ------------------------------
#
# Two things: the database and the blob directory above. Ciphertext only, so the
# backup can go anywhere.
#
#   0 3 * * * pg_dump -Fc wealdrelay > /var/backups/weald-$(date +\%F).dump
#   5 3 * * * tar -czf /var/backups/blobs-$(date +\%F).tar.gz /var/lib/wealdrelay/blobs
#
# A single `wealdrelay backup` command that wraps both is specified in
# specs/backend/relay/server.md and is not implemented. Until it ships, the two
# cron lines above are the supported procedure, and no runbook should be written
# around the single command.
#
# Put that in cron now, not later. This is the deployment path where it gets
# skipped.

# ---- optional ---------------------------------------------------------------

# WEALD_RELAY_LISTEN=0.0.0.0:8443
# WEALD_RELAY_OBSERVABILITY_LISTEN=127.0.0.1:9090
# WEALD_RELAY_TLS=off
# WEALD_RELAY_REDIS_URL=redis://127.0.0.1:6379
# WEALD_RELAY_MAX_STORAGE_GB=unlimited
# WEALD_RELAY_RETENTION_DAYS=unlimited
